                                                        <button aria-controls="uploadOption" aria-expanded="true" class="btn btn-primary" data-target="#uploadOption" data-toggle="collapse" type="button">Upload</button>
                                                        <div class="form-inline mt-5 mb-2 collapse" id="uploadOption">
