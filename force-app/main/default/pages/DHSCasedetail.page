         function initializeSequencePicklists() {
             // Get the DataTable instance
             var table = getUploadDocumentTable();
             if (!table) return;
             
             var totalDocuments = table.rows().count();
             
             
             
             // Get ALL sequence picklists (not just visible ones)
             var allPicklists = $('.sequence-picklist');
             var allCount = allPicklists.length;
             
             
             
             // Always ensure all sequence options are available (1 to totalDocuments)
             allPicklists.each(function(index) {
                 var $select = $(this);
                 var docId = $select.data('doc-id');
                 
                 // Always remove existing options and add fresh ones
                 $select.find('option:not(:first)').remove(); // Remove existing options except first
                 
                 // Add options from 1 to totalDocuments
                 for (var i = 1; i <= totalDocuments; i++) {
                     $select.append('<option value="' + i + '">' + i + '</option>');
                 }
                 
                 // Restore previously selected value if exists
                 if (selectedSequencesMap[docId]) {
                     $select.val(selectedSequencesMap[docId]);
                     
                 }
                 
                 
             });
             
             // Update button state based on stored selections
             updateButtonState();
         }
         
         // Global variable to store selected sequences
         var selectedSequencesMap = {};
         
         // Helper function to safely get DataTable instance
         function getUploadDocumentTable() {
             if ($.fn.DataTable.isDataTable('.uploadDocument')) {
                 return $('.uploadDocument').DataTable();
             } else {
                 console.warn('DataTable not initialized yet');
                 return null;
             }
         }
         
         function addDocumentNumbers() {
             var table = getUploadDocumentTable();
             if (!table) {
                 console.warn('DataTable not available for addDocumentNumbers');
                 return;
             }
             
             var pageInfo = table.page.info();
             var currentPage = pageInfo.page;
             var pageLength = pageInfo.length;
             var startIndex = currentPage * pageLength;
             
             
             
             // Add document numbers to visible rows
             var visiblePicklists = $('.sequence-picklist:visible');
             
             
             visiblePicklists.each(function(index) {
                 var $select = $(this);
                 var documentNumber = startIndex + index + 1;
                 
                 
                 
                 // Keep the original placeholder text
                 var $firstOption = $select.find('option:first');
                 if ($firstOption.length > 0) {
                     $firstOption.text('Select Sequence');
                     
                 }
                 
                 // Remove any existing document number indicators
                 var $row = $select.closest('tr');
                 var $firstCell = $row.find('td:first');
                 $firstCell.find('.doc-number-indicator').remove();
             });
             
             
         }
         
         function updateSequenceOptions() {
             var selectedSequences = [];
             var allCount = $('.sequence-picklist').length;
             
             
             
             // Get the DataTable instance
             var table = getUploadDocumentTable();
             if (!table) return;
             
             var totalDocuments = table.rows().count();
             
             
             
             // Process ALL picklists (not just visible ones)
             $('.sequence-picklist').each(function(index) {
                 var $select = $(this);
                 var selectedValue = $select.val();
                 var docId = $select.data('doc-id');
                 var availableOptions = $select.find('option').length;
                 
                 
                 
                 if (selectedValue && selectedValue !== '' && selectedValue !== 'Select Sequence') {
                     var parsedValue = parseInt(selectedValue);
                     if (!isNaN(parsedValue) && parsedValue > 0) {
                         selectedSequences.push(parsedValue);
                         selectedSequencesMap[docId] = parsedValue; // Store in global map
                         
                     }
                 } else {
                     // Clear from map if no selection
                     delete selectedSequencesMap[docId];
                 }
             });
             
             // Update ALL picklists to hide used sequences
             $('.sequence-picklist').each(function() {
                 var $select = $(this);
                 var currentValue = $select.val();
                 var currentDocId = $select.data('doc-id');
                 
                 // Show all options first
                 $select.find('option').show();
                 
                 // Hide options that are already selected in other picklists
                 Object.keys(selectedSequencesMap).forEach(function(docId) {
                     var selectedSeq = selectedSequencesMap[docId];
                     if (docId !== currentDocId) {
                         // Hide this sequence from other picklists
                         $select.find('option[value="' + selectedSeq + '"]').hide();
                         
                     }
                 });
             });
             
             // Update button state
             updateButtonState();
         }
         
         // Function to update button state based on stored selections
         function updateButtonState() {
             var selectedCount = Object.keys(selectedSequencesMap).length;
             var hasSelections = selectedCount > 0;
             
             
             
             
             $('.mergeDocuments').prop('disabled', !hasSelections);
             
             if (!hasSelections) {
                 $('.mergeDocuments').attr('title', 'Please select at least one document sequence');
                 $('.mergeDocuments').addClass('disabled');
             } else {
                 var tooltipText = 'Merge ' + selectedCount + ' document(s)';
                 if (selectedCount > 1) {
                     tooltipText += ' (across all pages)';
                 }
                 $('.mergeDocuments').attr('title', tooltipText);
                 $('.mergeDocuments').removeClass('disabled');
             }
         }
         
         // Function to manually check and update button state
         function checkButtonState() {
             updateButtonState();
         }
         
         // Function to get total selected documents across all pages
         function getTotalSelectedDocuments() {
             var totalSelected = [];
             
             // Get the DataTable instance
             var table = getUploadDocumentTable();
             if (!table) return totalSelected;
             
             // Use the global storage to get selected documents
             table.rows().every(function() {
                 var rowData = this.data();
                 var $row = $(this.node());
                 var $sequenceSelect = $row.find('.sequence-picklist');
                 
                 if ($sequenceSelect.length > 0) {
                     var docId = $sequenceSelect.data('doc-id');
                     
                     // Check if this document has a selected sequence in our global map
                     if (selectedSequencesMap[docId]) {
                         var title = $row.find('td:first').text().trim();
                         totalSelected.push({
                             docId: docId,
                             title: title,
                             sequence: selectedSequencesMap[docId]
                         });
                     }
                 }
             });
             
             
             return totalSelected;
         }
         
