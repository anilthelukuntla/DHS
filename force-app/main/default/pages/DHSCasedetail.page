         function mergeCaseDocuments() {
             // Show loading overlay
             $('#loadingOverlay').show();
             
             var documentData = [];
             
             // Get the DataTable instance
             var table = getUploadDocumentTable();
             if (!table) {
                 alert('DataTable not initialized. Please refresh the page.');
                 $('#loadingOverlay').hide();
                 return;
             }
             
             // Use the global storage to get selected documents in correct order
             var totalRows = table.rows().count();
             var processedRows = 0;
             var selectedCount = 0;
             
             // First, collect all selected documents from the global storage
             table.rows().every(function() {
                 processedRows++;
                 var rowData = this.data();
                 var $row = $(this.node());
                 var $sequenceSelect = $row.find('.sequence-picklist');
                 
                 if ($sequenceSelect.length > 0) {
                     var docId = $sequenceSelect.data('doc-id');
                     
                     // Check if this document has a selected sequence in our global map
                     if (selectedSequencesMap[docId]) {
                         selectedCount++;
                         var attachmentId = $sequenceSelect.data('attachment-id');
                         var title = $row.find('td:first').text().trim();
                         var addedBy = $row.find('td:eq(1)').text().trim();
                         var notes = $row.find('td:eq(2)').text().trim();
                         var sequence = selectedSequencesMap[docId];
                         
                         documentData.push({
                             docId: docId,
                             attachmentId: attachmentId,
                             title: title,
                             addedBy: addedBy,
                             notes: notes,
                             sequence: sequence
                         });
                     }
                 }
             });
             
             if (documentData.length === 0) {
                 alert('Please select sequence for at least one document.');
                 $('#loadingOverlay').hide();
                 return;
             }
             
             // Sort by sequence number to ensure correct order
             documentData.sort(function(a, b) {
                 return a.sequence - b.sequence;
             });
             
             // Log the order for debugging
             console.log('Documents to merge in order:');
             documentData.forEach(function(doc, index) {
                 console.log(index + 1 + '. Document:', doc.title, 'Sequence:', doc.sequence);
             });
             
             getBase64DataForAttachments(documentData);
         }
         
         function getBase64DataForAttachments(documentData) {        
             var documentsWithBase64 = [];
             var processedCount = 0;
             
             console.log('=== STARTING BASE64 CONVERSION ===');
             console.log('Processing', documentData.length, 'documents for base64 conversion');
             
             // Log all documents with their details
             documentData.forEach(function(doc, index) {
                 console.log(`Document ${index + 1}: "${doc.title}" - Sequence: ${doc.sequence} - AttachmentId: ${doc.attachmentId}`);
             });
             
             documentData.forEach(function(doc, index) {
                 console.log('Processing document', index + 1, 'of', documentData.length, '- Title:', doc.title, 'Sequence:', doc.sequence);
                 var downloadUrl = '/servlet/servlet.FileDownload?file=' + doc.attachmentId;
                 
                 fetch(downloadUrl)
                     .then(function(response) {
                         if (response.ok) {
                             return response.blob();
                         }
                         throw new Error('Failed to fetch attachment');
                     })
                     .then(function(blob) {
                         var reader = new FileReader();
                         reader.onload = function() {
                             var base64Data = reader.result.split(',')[1]; 
                             
                             console.log(`✓ Successfully converted "${doc.title}" (Sequence: ${doc.sequence}) to base64. Length: ${base64Data.length} characters`);
                             
                             documentsWithBase64.push({
                                 docId: doc.docId,
                                 attachmentId: doc.attachmentId,
                                 title: doc.title,
                                 addedBy: doc.addedBy,
                                 notes: doc.notes,
                                 sequence: doc.sequence,
                                 base64Data: base64Data
                             });
                             
                             processedCount++;
                             
                             if (processedCount === documentData.length) {
                                 // Filter to only include documents with sequence selected
                                 var documentsWithSequence = documentsWithBase64.filter(function(doc) {
                                     return doc.sequence && doc.sequence > 0;
                                 });
                                 
                                 if (documentsWithSequence.length === 0) {
                                     alert('No valid PDF documents with sequence selected found to merge.');
                                     $('#loadingOverlay').hide();
                                     return;
                                 }
                                 
                                 // Sort again to ensure correct order
                                 documentsWithSequence.sort(function(a, b) {
                                     return a.sequence - b.sequence;
                                 });
                                 
                                 console.log('=== FINAL DOCUMENTS TO MERGE ===');
                                 console.log('Total documents with sequence:', documentsWithSequence.length);
                                 documentsWithSequence.forEach(function(doc, index) {
                                     console.log(`${index + 1}. "${doc.title}" - Sequence: ${doc.sequence} - Base64 Length: ${doc.base64Data ? doc.base64Data.length : 'N/A'}`);
                                 });
                                 console.log('=== SENDING TO LIGHTNING COMPONENT ===');
                                 
                                 
                                 $Lightning.use("c:caseDocumentMergerApp", function() {
                                     $Lightning.createComponent("c:caseDocumentPdfMerger",
                                     {
                                         recordId: '{!caseRecord.id}',
                                         documentData: documentsWithSequence,
                                         subjectType: '{!caseRecord.Subject_Type__c}',
                                         socialSecurityNumber: '{!caseRecord.DHS_Contact__r.SSN__c}'
                                     },
                                     "caseDocumentMergerContainer",
                                     function(cmp) {
                                         setTimeout(function() {
                                             $('#loadingOverlay').hide();
                                         }, 6000); 
                                     });
                                 });
                             }
                         };
                         reader.readAsDataURL(blob);
                     })
                     .catch(function(error) {
                         console.error('Error fetching attachment:', error);
                         processedCount++;
                        
                         if (processedCount === documentData.length) {
                             // Filter to only include documents with sequence selected
                             var documentsWithSequence = documentsWithBase64.filter(function(doc) {
                                 return doc.sequence && doc.sequence > 0;
                             });
                             
                             if (documentsWithSequence.length === 0) {
                                 alert('No valid PDF documents with sequence selected found to merge.');
                                 $('#loadingOverlay').hide();
                                 return;
                             }
                             
                             // Sort again to ensure correct order
                             documentsWithSequence.sort(function(a, b) {
                                 return a.sequence - b.sequence;
                             });
                             
                             console.log('Final documents to merge in order (error path):');
                             documentsWithSequence.forEach(function(doc, index) {
                                 console.log(index + 1 + '. Document:', doc.title, 'Sequence:', doc.sequence);
                             });
                             
                             
                             $Lightning.use("c:caseDocumentMergerApp", function() {
                                 $Lightning.createComponent("c:caseDocumentPdfMerger",
                                 {
                                     recordId: '{!caseRecord.id}',
                                     documentData: documentsWithSequence,
                                     subjectType: '{!caseRecord.Subject_Type__c}',
                                     socialSecurityNumber: '{!caseRecord.DHS_Contact__r.SSN__c}'
                                 },
                                 "caseDocumentMergerContainer",
                                 function(cmp) {
                                     
                                     // Hide loading overlay after component is loaded
                                     setTimeout(function() {
                                         $('#loadingOverlay').hide();
                                     }, 1000);
                                 });
                             });
                         }
                     });
             });
         }
