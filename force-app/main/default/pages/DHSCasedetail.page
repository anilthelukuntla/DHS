<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSCaseDetailController"
   docType="html-5.0">
   <head>
      <meta charset="utf-8" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
      <meta name="description" content="" />
      <meta name="author" content="" />
      <title>Case Details</title>
   </head>
   <body id="page-top">
      <apex:includeLightning />
         <div id="LwcId"></div>
    <script src="https://unpkg.com/pdf-lib@1.4.0"></script>
    <script src="https://unpkg.com/downloadjs@1.4.7"></script>
    
      <apex:form >
         <!-- Modal for Edit/Delete Message -->
         <div class="modal fade" id="messageModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
               <div class="modal-content">

                  <div class="modal-header">
                     <apex:outputPanel id="messageModalHeader">
                        <h5 class="modal-title" style="font-size: x-large;">
                           <apex:outputPanel rendered="{!modalAction == 'edit'}">
                              Edit Message
                           </apex:outputPanel>
                           <apex:outputPanel rendered="{!modalAction == 'delete'}">
                              Delete Message
                           </apex:outputPanel>
                        </h5>
                     </apex:outputPanel>

                     <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                     </button>
                  </div>


                  <div class="modal-body">
                     <apex:outputPanel id="messageModalBody">
                        <!-- Edit form fields -->
                        <apex:outputPanel rendered="{!modalAction == 'edit'}">
                           <div class="form-group">
                              <label>Subject</label>
                              <apex:inputText value="{!selectedMessage.Subject__c}" styleClass="form-control"/>
                           </div>
                           <div class="form-group">
                              <label>Body</label>
                              <apex:inputTextarea value="{!selectedMessage.Message_Body__c}" styleClass="form-control editor"/>
                           </div>
                        </apex:outputPanel>

                        <!-- Delete confirmation -->
                        <apex:outputPanel rendered="{!modalAction == 'delete'}">
                           <p>Are you sure you want to delete this message?</p>
                        </apex:outputPanel>
                     </apex:outputPanel>
                  </div>

                  <div class="modal-footer">
                     <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>

                     <apex:outputPanel id="messageModalFooter">
                        <!-- Edit save -->
                        <apex:commandButton value="Save Changes" 
                           action="{!updateMessage}" 
                           rendered="{!modalAction == 'edit'}"
                           styleClass="btn btn-primary"
                           rerender="casemessagespanel,messageModalBody,messageModalFooter" 
                           oncomplete="$('#messageModal').modal('hide'); $('.successtoast strong').text('Message Saved'); $('.successtoast').toast('show');fetchCaseMessages();"/>

                        <!-- Delete confirm -->
                        <apex:commandButton value="Delete Message" 
                           action="{!deleteMessage}" 
                           rendered="{!modalAction == 'delete'}"
                           styleClass="btn btn-danger"
                           rerender="casemessagespanel,messageModalBody,messageModalFooter" 
                           oncomplete="$('#messageModal').modal('hide');$('.successtoast strong').text('Message Deleted'); $('.successtoast').toast('show');fetchCaseMessages()"/>
                     </apex:outputPanel>
                  </div>

               </div>
            </div>
         </div>
        
          
          <div class="modal fade" id="LeadEditModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
               <div class="modal-content">

                  <div class="modal-header">
                     <apex:outputPanel id="LeadEditModalHeader">
                        <h5 class="modal-title" style="font-size: x-large;">
                           <apex:outputPanel >
                              Edit Lead
                           </apex:outputPanel>
                        </h5>
                     </apex:outputPanel>

                     <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                     </button>
                  </div>


                  <div class="modal-body">
                     <apex:outputPanel id="LeadEditModalBody">
                        <!-- Edit form fields -->
                        <apex:outputPanel >
                           <div class="form-group">
                               <label>Lead Type</label>
                              <apex:inputField value="{!selectedLead.LeadType__c}" styleClass="form-control"/>
                           </div>
                           <div class="form-group">
                              <label>Coverage Type</label>
                              <apex:inputField value="{!selectedLead.Coverage_Type__c}" styleClass="form-control"/>
                           </div>
                            <div class="form-group">
                                <label>Item Number</label><br/>
                                {!selectedLead.Item_number__c}
                           </div>
                        </apex:outputPanel>

                     </apex:outputPanel>
                  </div>

                  <div class="modal-footer">
                     <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>

                     <apex:outputPanel id="LeadEditModalFooter">
                        <apex:commandButton value="Save Changes" 
                           action="{!updateLeadAction}"
                           styleClass="btn btn-primary"
                           rerender="casemessagespanel,LeadEditModalBody,LeadEditModalFooter" 
                           oncomplete="$('#LeadEditModal').modal('hide'); $('.successtoast strong').text('Lead Saved'); $('.successtoast').toast('show');refreshleads();"/>

                     </apex:outputPanel>
                  </div>

               </div>
            </div>
         </div>
          

         <!-- Page Wrapper -->
         <div id="wrapper">
            <c:DHSHeader ></c:DHSHeader>
            <style>
            .headertext1{text-transform:uppercase}
            table td .table{width:auto !important}
            .PPFCustomerContactAddress {height:74px !important}
            .casedetailautosave{left:20px;top:-1px}
            .overflowContent{overflow: auto;width: 100%;padding: 10px;}
          #case-leads .card-body{padding:0}
            .messagebodyContainer .trumbowyg-editor, .messagebodyContainer .trumbowyg-textarea , .messagebodyContainer .trumbowyg-box{min-height:150px}
            sup {
               top: -0.1em;
               font-size: 15px;
               color: #dc3545;
               }
               .ItemNumber div.active.error em{display:block;font-size: 12px;padding-top: 4px;color: #e74a3b;}
               .ItemNumber div.active{font-size:initial;width: auto;}
               .ItemNumber div input.error{border:1px solid red}
               .ItemNumber div span, .ItemNumber div.active i{cursor:pointer}
               .ItemNumber div input , .ItemNumber div i,  .ItemNumber div em{display:none}
               .ItemNumber div.active input , .ItemNumber div.active i{display:inline-block}
               .ItemNumber div input{width:55px}
               .ItemNumber div.active span{display:none}
               .form-control.error{font-size:initial}
            </style>
            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">
               <!-- Main Content -->
               <div id="content">
                  <!-- Topbar -->
                  <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                     <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">
                        <apex:outputpanel id="casedetailpageheader">
                           <h4 class=" mb-0 text-gray-800">
                              <b>Case Details </b><b
                                 class="{!If(caseRecord.Case_Number__c != Null && caseRecord.Case_Type__c != Null, '','d-none')}">:
                              {!caseRecord.Case_Number__c} -
                              {!caseRecord.Case_Type__c}</b>
                              
                           </h4>
                           <h4 class=" mb-0 text-gray-800">
                               <b>&nbsp;&nbsp;Case Name : </b><span class="text-primary">{!UPPER(caseRecord.DHS_Contact__r.Last_Name__c)} {!caseRecord.DHS_Contact__r.First_Name__c}</span>
                           </h4>
                        </apex:outputpanel>
                     </div>
                     <!-- Sidebar Toggle (Topbar) -->
                     <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                     <i class="fa fa-bars"></i>
                     </button>
                     <c:DHSHeaderProfile ></c:DHSHeaderProfile>
                  </nav>
                  <!-- End of Topbar -->
                  <!-- Begin Page Content -->
                  <div class="container-fluid">
                     <div class="row">
                        <!-- Area Chart -->
                        <div class="col-9">
                           <div class="card shadow mb-4 {!If(currentuser.user_type__c == 'INV','investigatorRecord','')} {!If(landingTab != "",'','tabbed')} ">
                              <!-- Card Header - Dropdown -->
                              <div
                                 class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                 <ul class="nav nav-tabs">
                                    <li class="nav-item {!If(currentuser.user_type__c == 'INV','d-none','')}" >
                                       <a class="nav-link {!If(landingTab == 'Leads' || landingTab == 'Documents' || landingTab == 'Messages', '','active')}"
                                          data-toggle="tab" href="#case-info" id="case-info-tab">Case
                                       Info</a>
                                    </li>
                                    <li class="nav-item">
                                       <a id="case-documents-tab" class="nav-link {!If(landingTab == 'Documents', 'active','')}" data-toggle="tab"
                                          href="#case-documents">
                                       Documents </a>
                                    </li>
                                    <li class="nav-item">
                                       <a id="case-leads-tab"
                                          class="nav-link {!If(landingTab == 'Leads', 'active','')}"
                                          data-toggle="tab" href="#case-leads">
                                       Leads </a>
                                    </li>
                                    <li class="nav-item">
                                       <a class="nav-link" data-toggle="tab" href="#case-history">
                                       History</a>
                                    </li>
                                    <li class="nav-item" style="display:{!IF(hasWaiver,'','none')}">
                                       <a class="nav-link" data-toggle="tab" href="#waiver-information">
                                       Waiver Information</a>
                                    </li>
                                    <li class="nav-item">
                                       <a class="nav-link {!If(landingTab == 'Messages', 'active','')}" data-toggle="tab" href="#case-messages">
                                       Messages</a>
                                    </li>
                                    <li class="nav-item">
                                       <a class="nav-link {!If(currentuser.user_type__c == 'PMO' || currentuser.user_type__c == 'CMO','','d-none')}" data-toggle="tab" href="#case-notes">
                                       Review</a>
                                    </li>
                                 </ul>
                                 <div>
                                  <a class="btn btn-primary"
                                    onClick="window.location.reload()">Refresh</a>
                                 <a class="btn btn-primary"
                                    href="{!$site.prefix}/DHSCasedashboard?{!urlparametersString}">Back </a>
                                 </div>
                              </div>
                              <!-- Card Body -->
                              <div class="card-body tab-content">
                                 <div role="tabpanel"
                                    class="tab-pane {!If(landingTab == 'Leads'||landingTab == 'Documents' ||landingTab == 'Messages', 'fade in','active')}"
                                    id="case-info">
                                    <apex:outputPanel id="caseinformationpanel">
                                       <div class="row">
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label for="inputEmail4"><sup>*</sup>Case Number:</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:inputField value="{!caseRecord.Case_Number__c}"
                                                   styleclass="form-control casenumber mandatory casedetailautosave" />
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label for="inputEmail4"><sup>*</sup>Customer Case Number:</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:inputField value="{!caseRecord.Customer_Case_Number__c}"
                                                   styleclass="form-control mandatory casedetailautosave" />
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Case Status: </label>
                                             </div>
                                             <div class="col-md-6">
                                                
                                                   <apex:inputField value="{!caseRecord.Status__c}"
                                                      styleclass="form-select form-control  casedetailautosave" />
                                             </div>
                                          </div>
                                           <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                 <label>Case Discontinued</label>
                                             </div>
                                             <div class=" col-md-6 ">
                                                   <apex:inputField value="{!caseRecord.Case_Discontinued__c}"
                                                      styleclass="mt-1 casedetailautosave" />
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label><sup>*</sup>Ingestion Date:</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:inputField value="{!caseRecord.Manifest__c}"
                                                   styleclass="form-control manifest mandatory datepickerInput casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label for="inputState"><sup>*</sup>Case Type:</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:inputField value="{!caseRecord.Case_Type__c}"
                                                   styleclass="form-control casetype mandatory casedetailautosave">
                                                   <apex:actionSupport event="onchange"
                                                      rerender="servicedayspanel1,servicedayspanel2" />
                                                </apex:inputField>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <apex:outputPanel id="servicedayspanel1">
                                                   <apex:outputPanel rendered="{!caseRecord.Case_Type__c != Null}">
                                                      <label for="inputState"><sup>*</sup>Service Days:</label>
                                                   </apex:outputPanel>
                                                </apex:outputPanel>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:outputPanel id="servicedayspanel2">
                                                   <apex:outputPanel rendered="{!caseRecord.Case_Type__c != Null}">
                                                      <apex:inputField value="{!caseRecord.Service_Days__c}"
                                                         styleclass="form-control servicedays mandatory casedetailautosave" onchange="updateDueDate();" />
                                                   </apex:outputPanel>
                                                </apex:outputPanel>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row"
                                             style="display:{!If(caseRecord.Assigned_To_Name__c != Null,'','none')}">
                                             <div class="col-md-6">
                                                <label for="inputState">Assignee :</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:outputfield value="{!caseRecord.Assigned_To_Name__c}"
                                                   styleclass="form-control" />
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row"
                                             style="display:{!If(caseRecord.Assigned_To_Name__c != Null,'','none')}">
                                             <div class="col-md-6">
                                                <label for="inputState">Assignee Date:</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:outputfield value="{!caseRecord.Assignee_Date__c}"
                                                   styleclass="form-control" />
                                             </div>
                                          </div>
                                     
                                      
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label for="inputCity">First Name :</label>
                                             </div>
                                             <div class="col-md-6">
                                                <Apex:outputPanel rendered="{!IF(currentuser.User_Type__c == 'PMO'||currentuser.User_Type__c == 'CMO' || currentuser.User_Type__c == 'QA',true,false)}">
                                                   <apex:inputfield value="{!caseRecord.DHS_Contact__r.First_Name__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>
                                                <Apex:outputPanel rendered="{!IF(currentuser.User_Type__c != 'PMO' && currentuser.User_Type__c != 'CMO' && currentuser.User_Type__c != 'QA',true,false)}">
                                                   <apex:outputfield value="{!caseRecord.DHS_Contact__r.First_Name__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Last Name :</label>
                                             </div>
                                             <div class="col-md-6">
                                                <Apex:outputPanel rendered="{!IF(currentuser.User_Type__c == 'PMO'||currentuser.User_Type__c == 'CMO' || currentuser.User_Type__c == 'QA',true,false)}">
                                                   <apex:inputfield value="{!caseRecord.DHS_Contact__r.Last_Name__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>
                                                <Apex:outputPanel rendered="{!IF(currentuser.User_Type__c != 'PMO' && currentuser.User_Type__c != 'CMO' && currentuser.User_Type__c != 'QA',true,false)}">
                                                   <apex:outputfield value="{!caseRecord.DHS_Contact__r.Last_Name__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row" style="display:{!If(currentuser.User_Type__c == 'PMO','','none')}">
                                             <div class="col-md-6">
                                                <label for="inputCity">SSN :</label>
                                             </div>
                                             <div class="col-md-6">
                                                <Apex:outputPanel >
                                                   <apex:inputfield value="{!caseRecord.DHS_Contact__r.SSN__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>
                                                <!--<Apex:outputPanel rendered="{!IF(currentuser.User_Type__c != 'PMO',true,false)}">
                                                   <apex:outputfield value="{!caseRecord.DHS_Contact__r.SSN__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>-->
                                             </div>
                                          </div>
                                           
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Email :</label>
                                             </div>
                                             <div class="col-md-6">
                                                <Apex:outputPanel rendered="{!IF(currentuser.User_Type__c == 'PMO'||currentuser.User_Type__c == 'CMO' || currentuser.User_Type__c == 'QA',true,false)}">
                                                   <apex:inputfield value="{!caseRecord.DHS_Contact__r.Email__c}"
                                                      styleclass="form-control casedetailautosave" />
                                                </Apex:outputPanel>
                                                <Apex:outputPanel rendered="{!IF(currentuser.User_Type__c != 'PMO' && currentuser.User_Type__c != 'CMO' && currentuser.User_Type__c != 'QA',true,false)}">
                                                   <apex:outputfield value="{!caseRecord.DHS_Contact__r.Email__c}"
                                                      styleclass="form-control" />
                                                </Apex:outputPanel>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6 ">
                                                <label for="inputCity">Coverage Period Begin Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6 input-group position-relative  d-block">
                                                <apex:inputField value="{!caseRecord.Coverage_Period_Begin_Date__c}"
                                                   styleclass="form-control datepickerInput coverageperiodbegindate casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Scheduled Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6 input-group position-relative  d-block">
                                                <apex:inputField value="{!caseRecord.Scheduled_Date__c}"
                                                   styleclass="form-control datepickerInput scheduleddate casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label><sup>*</sup>Case Due Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6 input-group position-relative  d-block">
                                                <apex:inputField value="{!caseRecord.Case_Due_Date__c}"
                                                   styleclass="form-control datepickerInput caseduedate mandatory casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label for="inputCity">Customer Delivery Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6 input-group position-relative  d-block">
                                                <apex:inputField value="{!caseRecord.Customer_Delivery_Date__c}"
                                                   styleclass="form-control customerDD datepickerInput casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Waiver Due Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6 input-group position-relative  d-block">
                                                <apex:inputField value="{!caseRecord.Waiver_Due_Date__c}"
                                                   styleclass="form-control datepickerInput casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label for="inputCity">Start Purge Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6  position-relative  d-block">
                                                <apex:outputText styleclass="endPurgeDate" value="{0,date,MM/dd/yyyy}">
                                                   <apex:param value="{!caseRecord.Purge_Date__c}" />
                                                </apex:outputText>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row  d-none">
                                             <div class="col-md-6">
                                                <label for="inputCity">End Purge Date:</label>
                                             </div>
                                             <div
                                                class="col-md-6  position-relative  d-none">
                                                <apex:outputText styleclass="endPurgeDate" value="{0,date,MM/dd/yyyy}">
                                                   <apex:param value="{!caseRecord.End_Purge_Date__c}" />
                                                </apex:outputText>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Supplement Date Submitted:</label>
                                             </div>
                                             <div
                                                class="col-md-6 input-group position-relative  d-block">
                                                <apex:inputField value="{!caseRecord.Supplemental_Date_requested__c}"
                                                   styleclass="form-control datepickerInput casedetailautosave" />
                                                <div class="input-group-append"><i
                                                   class="fa-solid fa-calendar"></i></div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Ontime/Late/Cancelled:</label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:inputField value="{!caseRecord.OntimeLateCancelled__c}"
                                                   styleclass="form-control casedetailautosave" />
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label>Delivered with Pending Lead: </label>
                                             </div>
                                             <div class="col-md-6 text-left">
                                                <div class="form-check">
                                                   <apex:inputField value="{!caseRecord.Delivered_with_pending_lead__c}"
                                                      styleclass="form-check-input casedetailautosave" />
                                                </div>
                                             </div>
                                          </div>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
                                                <label><sup>*</sup>Subject Type: </label>
                                             </div>
                                             <div class="col-md-6">
                                                <apex:inputField value="{!caseRecord.Subject_Type__c}"
                                                   styleclass="form-control mandatory  casedetailautosave" onchange="setppfcontactinfo();return false;"/>
                                             </div>
                                          </div>
                                          <apex:actionfunction name="setppfcontactinfo" status="loader" action="{!setPPFContactInfo}" reRender="ppfcontactname,ppfcontactaddress,ppfcontactemail"/>
                                          <div class="form-group col-md-6 row">
                                             <div class="col-md-6">
