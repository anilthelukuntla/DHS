                     $select.find('option:not(:first)').remove();
                     for (var i = 1; i <= totalDocuments; i++) {
                         $select.append('<option value="' + i + '">' + i + '</option>');
                     }
                     
                 } else {
                     
                 }
             });
         }
         
         // Function to apply sequence hiding logic
         function applySequenceHiding() {
             
             
             // Update ALL picklists to hide used sequences
             $('.sequence-picklist').each(function() {
                 var $select = $(this);
                 var currentValue = $select.val();
                 var currentDocId = $select.data('doc-id');
                 
                 // Show all options first
                 $select.find('option').show();
                 
                 // Hide options that are already selected in other picklists
                 Object.keys(selectedSequencesMap).forEach(function(docId) {
