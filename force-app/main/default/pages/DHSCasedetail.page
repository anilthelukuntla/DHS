         function verifyPicklistOptions() {
             var table = getUploadDocumentTable();
             if (!table) return;
             
             var totalDocuments = table.rows().count();
             var allPicklists = $('.sequence-picklist');
             
             
             
             allPicklists.each(function(index) {
