<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSMyTrainingsController"
    docType="html-5.0">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />

        <title>My Trainings </title>
    </head>

    <body id="page-top">
        <apex:form >

            <!-- Page Wrapper -->
            <div id="wrapper">

                <c:DHSHeader ></c:DHSHeader>
                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">

                                <h4 class=" mb-0 text-gray-800">

                                    <b>My Trainings </b>
                                </h4>

                            </div>
                            <!-- Sidebar Toggle (Topbar) -->
                            <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                                <i class="fa fa-bars"></i>
                            </button>


                            <c:DHSHeaderProfile ></c:DHSHeaderProfile>

                        </nav>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-12">
                                    <div class="card shadow ">
                                        <div class="card-body">
                                            <div
                                                class="d-flex flex-row-reverse bd-highlight ">
                                                <a class="btn btn-primary mb-3" data-toggle="collapse"
                                                    href="#createnewtraining" role="button" aria-expanded="false"
                                                    aria-controls="createnewtraining">
                                                    Upload Trainings
                                                </a>
                                            </div>
                                            <div class="collapse mt-2 mb-3" id="createnewtraining">
                                                <div class="card card-body">
                                                    <apex:outputPanel id="trainingdetailspanel">
                                                        <h4 class="text-primary mb-5">Training Details </h4>
                                                        <div class="row">
                                                            <div class="col-6">
                                                                <div class="form-group">
                                                                    <label>Training Name:</label>
                                                                    <apex:inputField styleclass="form-control"
                                                                        value="{!newTraining.Training_Name__c}" />
                                                                </div>
                                                                 <div class="form-group">
                                                                    <label>Proctored by:</label>
                                                                    <apex:inputField styleclass="form-control"
                                                                        value="{!newTraining.Proctored_By__c}" />
                                                                </div>
                                                               
                                                                
                                                            </div>
                                                            <div class="col-6">
                                                                <div class="form-group ">
                                                                    
                                                                        <label>Training completed date:</label>
                                                                        <apex:inputField type="date"
                                                                            styleclass="form-control datepickerInput"
                                                                            value="{!newTraining.Training_Completed_Date__c}" />
                                                                  
                                                                </div>
                                                              
                                                            </div>

                                                            <div class="col-6">
                                                                <button type="submit"
                                                                    onclick="submittraining();return false;"
                                                                    class="btn btn-primary my-3">Submit</button>
                                                            </div>

                                                            <!--<div class="col-8">
                                                            <div class="frame">
                                                                <div class="center">
                                                                    <c:DHSFileUpload fId="f2" parentId="">
                                                                    </c:DHSFileUpload>
                                                                </div>
                                                            </div>
                                                        </div> -->
                                                        </div>
                                                    </apex:outputPanel>
                                                </div>
                                            </div>
                                            <apex:outputpanel id="mytrainingspanel">
                                                <apex:variable value="{!0}" var="cnt" />
                                                <table class="table table-striped dataTable">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">#</th>
                                                            <th scope="col">Training Name</th>
                                                            <th scope="col">Training Completed Date</th>
                                                            <th scope="col">Proctored By</th>
                                                            <th scope="col" class="{!If(currentuser.user_type__c !='INV','','d-none')}"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <apex:repeat value="{!myTrainings}" var="tranining">
                                                            <tr>
                                                                <td>
                                                                    <apex:variable var="cnt" value="{!cnt+1}" />
                                                                    {!cnt}
                                                                </td>
                                                                <td>{!tranining.Training_Name__c}</td>
                                                                <td>
                                                                    <apex:outputText value="{0,date,MM/dd/yy}">
                                                                        <apex:param value="{!tranining.Training_Completed_Date__c}" />
                                                                    </apex:outputText>
                                                                </td>
                                                                <td>{!tranining.Proctored_By__c}</td>
                                                                <td class="{!IF(currentuser.user_type__c !='INV','','d-none')}"><a class="nav-link" onclick="deletetraning('{!tranining.Id}');return false"><i class="fa fa-trash"></i></a></td>
                                                            </tr>
                                                        </apex:repeat>
                                                    </tbody>
                                                </table>
                                            </apex:outputpanel>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2021</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

            </div>
            <!-- End of Page Wrapper -->

            <!-- Scroll to Top Button-->
            <a class="scroll-to-top rounded" href="#page-top">
                <i class="fas fa-angle-up"></i>
            </a>
            <apex:actionFunction name="submittrainingaction" action="{!submitTraining}" status="loader"
                rerender="mytrainingspanel,trainingdetailspanel"
                oncomplete="submittrainingcompleteaction();renderTable();return false;" />
             <apex:actionFunction name="deletetrainingaction" action="{!deleteTrainingAction}"
                                 rerender="mytrainingspanel,trainingdetailspanel" status="loader" oncomplete="renderTable()">
                                 <apex:param name="deleteTrainingID" value="" assignTo="{!deleteTrainingID}" />
                              </apex:actionfunction>

        </apex:form>

        <script>
            $('.upload-input').change(function () {
                var InputValue = $(this).val().replace(/C:\\fakepath\\/i, '');
                $(".fileUploadValue").text(InputValue);
            });

              function renderTable(){
              $('.dataTable').DataTable({
                    "searching": false,
                    "bLengthChange": false,
                    "bFilter": true,
                    "bInfo": true,
                    "bAutoWidth": false
                });
                
                
              }
              
            $(document).ready(function () {
               



                $('.dataTable').DataTable({
                    "searching": false,
                    "bLengthChange": false,
                    "bFilter": true,
                    "bInfo": true,
                    "bAutoWidth": false
                });


            });
            
            function deletetraning(trainingId){
                console.log({trainingId});
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, training record will be deleted.',
                    buttons: {
                        confirm: function () {
                            deletetrainingaction(trainingId);
                        },
                        cancel: function () {}
                    }
                });
            
            }


            function submittraining() {
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, training record will be submitted.',
                    buttons: {
                        confirm: function () {
                            submittrainingaction();
                        },
                        cancel: function () {}
                    }
                });
            }

            function submittrainingcompleteaction() {
                $('#createnewtraining').removeClass('show');
            }
        </script>
        <style>
        span.dateInput.dateOnlyInput:after, .dategroup:after {
    content: "\f133";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    right: 10px;
    position: absolute;
    top: 4px;
    }
            .highlightrequiredfield {
                border: 1px solid red !important;
            }

            .vertical-timeline-element-content {
                margin-left: 100px;
            }

            .vertical-timeline-element-content .vertical-timeline-element-date {
                left: -120px;
            }

            .badge:empty {
                display: block
            }

            .badge-success {
                background-color: #00799B
            }

            .dataTables_info {
                padding: 0 15px
            }

            .vertical-timeline-element-content .vertical-timeline-element-date {
                color: #000
            }

            .frame {


                width: 100%;
                height: 400px;

                border-radius: 2px;
                box-shadow: 4px 8px 16px 0 rgba(0, 0, 0, 0.1);
                overflow: hidden;
                color: #000;

            }

            .frame .center {
                width: 100%;
                height: 100%;
                border-radius: 3px;
                box-shadow: 8px 10px 15px 0 rgba(0, 0, 0, 0.2);
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: space-evenly;
                flex-direction: column;
            }

            .frame .title {
                width: 100%;
                height: 50px;
                border-bottom: 1px solid #000;
                text-align: center;
            }

            ..frame h1 {
                font-size: 16px;
                font-weight: 300;
                color: #000;
            }

            .frame .dropzone {
                position: relative;
                border: 1px dashed #000;
                border-radius: 3px;
                text-align: center;
                padding: 50px;


            }

            .frame .upload-icon {
                margin: 25px 2px 2px 2px;
            }

            .frame .upload-input {
                position: absolute;
                top: 0px;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
            }

            .dateFormat {
                display: none
            }

            .form-group span {
                font-weight: bold
            }

            .input-group-append {
                position: absolute;
                top: 5px;
                right: 22px;
            }

            .datepicker.dropdown-menu {
                padding: 10px;
            }

            .taskEvent li {
                display: flex;
                color: #000;
            }

            .taskEvent span {
                position: relative;
                padding: 0 1.5em;
            }

            .sidebar #sidebarToggle::after {
                font-weight: 900;
                content: '\f104';
                font-family: 'Font Awesome 6 Free';
                margin-right: 0.1rem;
            }


            .taskEvent span::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 4px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #fff;
                border: 1px #ccc solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 2px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #00799B;
                border: 1px #00799B solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed {
                color: #00799B;
            }

            .taskEvent span {
                padding: 0 1.5em 1.5em 1.5em;
                position: relative;
                font-size: 14px;
                font-weight: bold
            }

            .taskEvent span.completed::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #00799B solid;
            }

            .taskEvent span::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #ccc solid;
            }

            .taskEvent strong {
                display: block;
                font-weight: bolder;
            }

            .taskEvent,
            .taskEvent *::before,
            .taskEvent *::after {
                box-sizing: border-box;
                font-family: arial;
            }
        </style>
    </body>
</apex:page>
