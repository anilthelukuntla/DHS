<apex:page renderAs="pdf" controller="DHSROIReportController" showHeader="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" >

    <head>
        <meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />
         <style type="text/css">
            @page {
                size: A4 potrait;
                border: 1px solid black;
                padding-left: 5px;
                border:none;
                padding-right: 5px;
                padding-top:5px;
                padding-bottom:5px;
                margin-top:70px;
                @bottom-right {
                 content: "Page " counter(page) " of " counter(pages);
                }
                
                @top-left {
                    content: element(header);
                }                           
                @bottom-left {   
                    content: element(footer);
                } 
            }
            .investigatorTable td, .investigatorTable th  {border:1px solid #000; padding:5px}
            hr{border-bottom:none;border-top: 1px solid #ccc; color:#ccc}
            div.header {
                margin-top:20px;
                position: running(header);
                width: 100%;
                margin-right: 10px;
            }
            div.footer {                    
                position: running(footer);
                width: 100%;
            }
            .repeatTableHeader{-fs-table-paginate: paginate;}
            table td:first-child{text-align:right}
            .leftTable td:first-child{text-align:left}
            th {
                font-weight: bold;
                text-align: left;
                color: #000;
                padding: 2px 5px;
            }

            td {
                font-size: 15px;
                text-align: left;
                padding: 2px 5px;
            }

            table {
                border-collapse: collapse;
                
            }

            table,
            th,
            td {
                border: 0px solid black;
            }

            .pagenumber:before {
                content: counter(page);
            }

            .pagecount:before {
                content: counter(pages);
            }
            .customerCaseNuber{
             font-family: "Segoe UI", Arial, sans-serif;
            text-align:right;font-weight:bold;color:#000
            }
        </style>
        <script>
        $(document).ready(function(){
        $('table').css("display", "none");
        })
        </script>
    </head>

    <body>
         <div class="header">
            <center>UNCLASSIFIED/FOROFFICIALUSEONLY</center>
            <div class="customerCaseNuber">{!caseRecord.Customer_Case_Number__c}</div>    
        </div>
        <div class="content">
            <center>
                <apex:image id="ISNLogoBlue" value="{!$Resource.ISNLogoBlue}" width="200"/>
            </center>
            <br /><br /><br />
            
            <!--<center><u>Investigation</u></center><br />-->
            <p><b>TO:<span style="margin-left:52px">{!caseRecord.PPF_Customer_Contact_Name__c}</span><br />
                     <span style="margin-left:80px">Department of Defense</span><br />
                     <span style="margin-left:80px">9800 Savage Road Suite: 6771, A5231 Ft. Meade. MD 20755-6774</span>
                     <!--<apex:outputtext styleclass="margin-left:80px" escape="false" value="{!caseRecord.PPF_Customer_Contact_Address__c}"></apex:outputtext>-->
                  
                </b>
            </p>
            <p><b>FROM:<span style="margin-left:25px">Information Systems &amp; Networks Corporation</span><br /><span
                        style="margin-left:77px">10411 Motor City Dr, Suite 700 Bethesda, MD 20817<br /></span>
                    </b>
            </p>
            <br />
            <br />
            <div style="margin-top:15px">
                <p><b><span>CASE NAME: <span style="text-transform:uppercase">{!caseRecord.DHS_Contact__r.Last_Name__c}</span> {!caseRecord.DHS_Contact__r.First_Name__c}
                            </span>
                        <span style="float:right;">SSN: {!caseRecord.DHS_Contact__r.SSN__c}</span>
                    </b>
                </p>
                <p><b><span>CASE Type: {!caseRecord.Subject_Type__c}</span>
                        <span style="float:right;">BI Provider Report# {!caseRecord.Case_Number__c}</span></b>
                </p>
            </div>
            <br />
            <p style="margin-top:15px;">This is to certify the review of the attached report of investigation reflects
                that:<br /><br />
                1) The report was prepared by the investigator(s) who conducted the investigation for <span style="text-transform:uppercase">{!caseRecord.DHS_Contact__r.Last_Name__c} </span> {!caseRecord.DHS_Contact__r.First_Name__c}.<br /><br />
                2) The investigation was conducted in accordance with the applicable Federal Investigative
                Standards.<br /><br />
                3) Appropriate investigation was conducted to obtain required coverage and to resolve issues and
                unfavorable information that surfaced in the course of the investigation.<br /><br />
                4) The information reported is attributes to the sources from which it was obtained.<br /><br />
                5) The sources appearing in the report were interviewed in depth covering the person's personal attributes
                of character, habits, honesty, reputation, and mental health, personal conduct, use of intoxicants, affiliations, and loyalty.
            </p>
            
            <div>
            <br/>
            <br/>
            <div><b>Signature:</b></div>
            <br/>
            <br/>
            <div ><b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Date:</b></div>
            </div>

            <div style="page-break-before:always;" />
            <center><b>REPORT OF INVESTIGATION</b></center><br />
            <center><b>SUMMARY</b></center><br />
            <p><b><span>Subject Name: {!caseRecord.DHS_Contact__r.First_Name__c}
                        {!caseRecord.DHS_Contact__r.Last_Name__c}</span>
                    <span style="float:right; width:200px; text-align:right;">Case Type:
                        {!caseRecord.Case_Type__c}</span></b>
            </p>
            <table class="leftTable" style="border-spacing: 0px;" cellpadding="6" width="100%">
                <tr>
                    <th>Section</th>
                    <th>Number</th>
                </tr>
                <apex:outputPanel layout="none" rendered="{!caseRecord.Employment_Count__c > 0}">
                    <tr>
                        <td>EMPLOYMENT</td>
                        <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Employment_Count__c}</td>
                    </tr>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!caseRecord.General_Count__c > 0}">
                    <tr>
                        <td>GENERAL</td>
                        <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.General_Count__c}</td>
                    </tr>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!caseRecord.Medical_Count__c > 0}">
                    <tr>
                        <td>MEDICAL</td>
                        <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Medical_Count__c}</td>
                    </tr>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!caseRecord.Subject_Interview_Count__c > 0}">
                    <tr>
                        <td>SUBJECT INTERVIEW</td>
                        <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Subject_Interview_Count__c}</td>
                    </tr>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!caseRecord.Attachment_Count__c > 0}">
                    <tr>
                        <td>ATTACHMENTS</td>
                        <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Attachment_Count__c}</td>
                    </tr>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!caseRecord.Total_References_Count__c > 0}">
                    <tr>
                        <td><b>TOTAL REFERENCES</b> </td>
                        <td style="border-bottom:1px solid #000;width:30px;text-align:center"><b>{!caseRecord.Total_References_Count__c}</b></td>
                    </tr>
                </apex:outputPanel>
            </table>

            <p><b>RESULTS</b><br />
                DHS_All records obtained.<br />
                DHS_All sources recommend.
            </p>

            <p><b>DEROGATORY SUMMARY</b><br />
                None.
            </p>

            <p><b>EFI REFERENCES</b><br />
                None.
            </p>
            <p><b>PENDING LEADS</b><br />
                None.
            </p>

            <div style="page-break-before:always;" />

            <center><b>REPORT OF INVESTIGATION</b></center><br /><br />
           
            <table cellpadding="5" cellspacing="5" width="100%" class="investigatorTable leftTable"  style="text-align:left">
                <tr>
                    <th>{!caseRecord.DHS_Contact__r.First_Name__c}
                        {!caseRecord.DHS_Contact__r.Last_Name__c}</th>
                    <th>BI Provider Report ID</th>
                    <th>Investigation Dates</th>
                    <th>Investigators</th>
                </tr>
                <tr>
                    <td>SSN: {!caseRecord.DHS_Contact__r.SSN__c}</td>
                    <td>{!caseRecord.Case_Number__c}</td>
                    <td>{!investigationDates}</td>
                    <td>{!investigators}</td>
                </tr>
            </table><br/>

            <!-- Subject Interview Section -->
             <apex:outputPanel rendered="{!subjectInterviewList.size >0}">
                  <center style="margin-top:20px;margin-bottom:15px;display:block;font-size:22px"><b><u>Subject Interview</u></b></center>
            </apex:outputPanel>
            <apex:repeat value="{!subjectInterviewList}" var="esiId">
                <apex:outputpanel >
                    <p>
                        <b>IDENTIFICATION 1:</b> {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} provided his
                        {!leadsMap[esiId].Identification_Type__c} and Document#
                        {!leadsMap[esiId].Identification_Document_Number__c}
                        which was viewed and verified. The ID was issued on
                        <apex:outputText value="{0, date, MMMM d','  yyyy}">
                            <apex:param value="{!leadsMap[esiId].Identification_Issuance_Date__c}" />
                        </apex:outputText> and expires on
                        <apex:outputText value="{0, date, MMMM d','  yyyy}">
                            <apex:param value="{!leadsMap[esiId].Identification_Expiry_Date__c}" />
                        </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
                    </p>
                    <apex:outputpanel rendered="{!leadsMap[esiId].Identification_Type2__c != Null}">
                        <p>
                            <b>IDENTIFICATION 2:</b> {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} provided his
                            {!leadsMap[esiId].Identification_Type2__c} and Document#
                            {!leadsMap[esiId].Identification_Document_Number2__c}
                            which was viewed and verified. The ID was issued on
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!leadsMap[esiId].Identification_Issuance_Date2__c}" />
                            </apex:outputText> and expires on
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!leadsMap[esiId].Identification_Expiry_Date2__c}" />
                            </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
                        </p>
                    </apex:outputpanel>
                    <apex:outputpanel rendered="{!leadsMap[esiId].Identification_Type3__c != Null}">
                        <p>
                            <b>IDENTIFICATION 3:</b> {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} provided his
                            {!leadsMap[esiId].Identification_Type3__c} and Document#
                            {!leadsMap[esiId].Identification_Document_Number3__c}
                            which was viewed and verified. The ID was issued on
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!leadsMap[esiId].Identification_Issuance_Date3__c}" />
                            </apex:outputText> and expires on
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!leadsMap[esiId].Identification_Expiry_Date3__c}" />
                            </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
                        </p>
                    </apex:outputpanel>
                    <apex:outputpanel rendered="{!leadsMap[esiId].Identification_Type4__c != Null}">
                        <p>
                            <b>IDENTIFICATION 4:</b> {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} provided his
                            {!leadsMap[esiId].Identification_Type4__c} and Document#
                            {!leadsMap[esiId].Identification_Document_Number4__c}
                            which was viewed and verified. The ID was issued on
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!leadsMap[esiId].Identification_Issuance_Date4__c}" />
                            </apex:outputText> and expires on
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!leadsMap[esiId].Identification_Expiry_Date4__c}" />
                            </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
                        </p>
                    </apex:outputpanel>

                    <p>
                        <b>BIRTH and CITIZENSHIP: </b> 
                        <apex:outputPanel rendered="{!leadsMap[esiId].State_Birth_Certificate_Viewed__c == 'Yes'}">
                            {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} provided State Birth Certificate. The Birth Certificate was viewed and verified on 
                            <apex:outputText value="{0,date,MM/dd/yyyy}"> <apex:param value="{!leadsMap[esiId].Date_Viewed_and_Verified__c}" /> </apex:outputText>
                             and has a document# {!leadsMap[esiId].Birth_Certificate_Document_Number__c}.
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!leadsMap[esiId].State_Birth_Certificate_Viewed__c == 'No'}">
                            <apex:outputPanel rendered="{!leadsMap[esiId].State_Birth_Certificate_Notes__c != Null}">
                                <apex:outputfield value="{!leadsMap[esiId].State_Birth_Certificate_Notes__c}"/>
                            </apex:outputPanel>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!leadsMap[esiId].Held_Foreign_Passport__c == 'No'}">
                            {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} has not held a passport issued by a foreign country.
                        </apex:outputpanel>
                        <apex:outputPanel rendered="{!leadsMap[esiId].Held_Foreign_Passport__c == 'Yes'}">
                            {!leadsMap[esiId].DHS_Contact__r.Last_Name__c} has held a passport issued by {!leadsMap[esiId].Passport_Country_of_Issuance__c} 
                            has a document# {!leadsMap[esiId].Passport_Document_Number__c} issued on 
                            <apex:outputText value="{0,date,MM/dd/yyyy}"> <apex:param value="{!leadsMap[esiId].Passport_Issued_Date__c}" /> </apex:outputText>, 
                            expires on 
                            <apex:outputText value="{0,date,MM/dd/yyyy}"> <apex:param value="{!leadsMap[esiId].Passport_Expiration_Date__c}" /> </apex:outputText>.
                        </apex:outputpanel>
                    </p>


                    <p>
                        <b style="display:{!If(leadsMap[esiId].OTHER_NAMES_USED__c  != Null,'','none')}">OTHER NAMES USED: </b>
                        <apex:outputField value="{!leadsMap[esiId].OTHER_NAMES_USED__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].RESIDENCE__c  != Null,'','none')}">RESIDENCE: </b>
                        <apex:outputField value="{!leadsMap[esiId].RESIDENCE__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].EDUCATION__c  != Null,'','none')}">EDUCATION: </b> 
                        <apex:outputField value="{!leadsMap[esiId].EDUCATION__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].EMPLOYMENT__c  != Null,'','none')}">EMPLOYMENT: </b> 
                        <apex:outputField value="{!leadsMap[esiId].EMPLOYMENT__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].SELF_EMPLOYMENT__c  != Null,'','none')}">SELF-EMPLOYMENT: </b> 
                        <apex:outputField value="{!leadsMap[esiId].SELF_EMPLOYMENT__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].UNEMPLOYMENT__c  != Null,'','none')}">UNEMPLOYMENT: </b>
                        <apex:outputField value="{!leadsMap[esiId].UNEMPLOYMENT__c}" /> 
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].MILITARY_FEDERAL_EMPLOYMENT__c  != Null,'','none')}">MILITARY/FEDERAL EMPLOYMENT: </b>
                         <apex:outputField value="{!leadsMap[esiId].MILITARY_FEDERAL_EMPLOYMENT__c}" />
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].SELECTIVE_SERVICE_ID__c  != Null,'','none')}">SELECTIVE SERVICE ID: </b> 
                        <apex:outputField value="{!leadsMap[esiId].SELECTIVE_SERVICE_ID__c}" />
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].PEOPLE_WHO_KNOW_YOU_WELL__c  != Null,'','none')}">PEOPLE WHO KNOW YOU WELL:</b>
                         <apex:outputField value="{!leadsMap[esiId].PEOPLE_WHO_KNOW_YOU_WELL__c}" />
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].MARITAL_STATUS_SPOUSE_FORMER__c  != Null,'','none')}">MARITAL STATUS, SPOUSE, FORMER SPOUSE(S) and CHILDREN: </b>
                        <apex:outputField value="{!leadsMap[esiId].MARITAL_STATUS_SPOUSE_FORMER__c}" />
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].FAMILY_RELATIVES_AND_ASSOCIATES__c  != Null,'','none')}">FAMILY, RELATIVES and ASSOCIATES: </b>
                        <apex:outputField value="{!leadsMap[esiId].FAMILY_RELATIVES_AND_ASSOCIATES__c}" /> 
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].COHABITANT_AND_OR_ROOMMATE_S__c  != Null,'','none')}">COHABITANT and/or ROOMMATE(S): </b>
                        <apex:outputField value="{!leadsMap[esiId].COHABITANT_AND_OR_ROOMMATE_S__c}" /> 
                    </p>

                    <p>
                        <b style="display:{!If(subjectInterviewNLeadRTAExtension[esiId].Foreign_Contacts__c  != Null,'','none')}">FOREIGN CONTACTS: </b> 
                        <apex:outputfield value="{!subjectInterviewNLeadRTAExtension[esiId].Foreign_Contacts__c}"/>
                    </p>

                    <p>
                        <b style="display:{!If(subjectInterviewNLeadRTAExtension[esiId].Foreign_Activities__c  != Null,'','none')}"> FOREIGN ACTIVITIES: </b> 
                        <apex:outputfield value="{!subjectInterviewNLeadRTAExtension[esiId].Foreign_Activities__c}"/>
                    </p>

                    <p>
                        <b style="display:{!If(subjectInterviewNLeadRTAExtension[esiId].Foreign_Travel1__c  != Null,'','none')}">FOREIGN TRAVEL SECTION A: </b> 
                        <apex:outputfield value="{!subjectInterviewNLeadRTAExtension[esiId].Foreign_Travel1__c}"/>
                    </p>
                    <p>
                        <b style="display:{!If(subjectInterviewNLeadRTAExtension[esiId].Foreign_Travel2__c  != Null,'','none')}">FOREIGN TRAVEL SECTION B: </b>
                         <apex:outputfield value="{!subjectInterviewNLeadRTAExtension[esiId].Foreign_Travel2__c}"/>
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].MEDICAL_RECORD__c  != Null,'','none')}">MEDICAL RECORD: </b> 
                        <apex:outputField value="{!leadsMap[esiId].MEDICAL_RECORD__c}" />
                    </p>

                    <p>
                        <b style="display:{!If(leadsMap[esiId].CRIMINAL_ACTIVITY_CIVIL_LIT__c  != Null,'','none')}">CRIMINAL ACTIVITY: </b>
                         <apex:outputField value="{!leadsMap[esiId].CRIMINAL_ACTIVITY_CIVIL_LIT__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].CIVIL_LITIGATION_Notes__c  != Null,'','none')}">CIVIL LITIGATION: </b>
                         <apex:outputField value="{!leadsMap[esiId].CIVIL_LITIGATION_Notes__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].ILLEGAL_SUBSTANCE_ACTIVITY__c  != Null,'','none')}">USE OF ILLEGAL SUBSTANCES AND ACTIVITY: </b>
                        <apex:outputField value="{!leadsMap[esiId].ILLEGAL_SUBSTANCE_ACTIVITY__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].USE_OF_ALCOHOL__c  != Null,'','none')}">USE OF ALCOHOL: </b> 
                        <apex:outputField value="{!leadsMap[esiId].USE_OF_ALCOHOL__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].OTHER_INVESTIGATIONS__c  != Null,'','none')}">OTHER INVESTIGATIONS: </b>
                        <apex:outputField value="{!leadsMap[esiId].OTHER_INVESTIGATIONS__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].FINANCES__c  != Null,'','none')}"> FINANCES: </b> 
                        <apex:outputField value="{!leadsMap[esiId].FINANCES__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].MISUSE_OF_TECHNOLOGY_SYSTEMS__c  != Null,'','none')}">MISUSE OF TECHNOLOGY SYSTEMS: </b>
                        <apex:outputField value="{!leadsMap[esiId].MISUSE_OF_TECHNOLOGY_SYSTEMS__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].ASSOC_REC_ORG_MEMBERS__c  != Null,'','none')}">ASSOCIATION RECORD/ORGANIZATION MEMBERSHIPS: </b>
                        <apex:outputField value="{!leadsMap[esiId].ASSOC_REC_ORG_MEMBERS__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].MEDIA_PUBLICATIONS__c  != Null,'','none')}">MEDIA/PUBLICATIONS: </b> 
                        <apex:outputField value="{!leadsMap[esiId].MEDIA_PUBLICATIONS__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].LIFESTYLE_HOBBIES_EXTRA_CURR__c  != Null,'','none')}">LIFESTYLE/HOBBIES/EXTRA CURRICULAR: </b> 
                        <apex:outputField value="{!leadsMap[esiId].LIFESTYLE_HOBBIES_EXTRA_CURR__c}" />
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].CONCLUDING_QUESTIONS__c  != Null,'','none')}">CONCLUDING QUESTIONS: </b>
                        <span><apex:outputField value="{!leadsMap[esiId].CONCLUDING_QUESTIONS__c}" /></span>
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].Narrator_Comments__c  != Null,'','none')}">NARRATIVE: </b>
                        <span><apex:outputField value="{!leadsMap[esiId].Narrator_Comments__c}" /></span>
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].subject_loyal_to_united_states__c  != Null,'','none')}">LOYALTY: </b>
                        <span><apex:outputField value="{!leadsMap[esiId].subject_loyal_to_united_states__c}" /></span>
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].counter_intel_counter_terror__c  != Null,'','none')}">COUNTERINTELLIGENCE/COUNTERTERRORISM: </b>
                        <span><apex:outputField value="{!leadsMap[esiId].counter_intel_counter_terror__c}" /></span>
                    </p>
                    <p>
                        <b style="display:{!If(leadsMap[esiId].SUBJ_ETHICAL_BEHAV_JUDGEMENT__c  != Null,'','none')}">ETHICAL BEHAVIOR: </b>
                        <span><apex:outputField value="{!leadsMap[esiId].SUBJ_ETHICAL_BEHAV_JUDGEMENT__c}" /></span>
                    </p>
                </apex:outputpanel>    
            </apex:repeat>
           
            <!-- Subject Contact Section-->
             <apex:outputPanel rendered="{!subjectContactList.size >0}">
                
                  <center style="margin-top:20px;margin-bottom:15px;display:block;font-size:22px"><b><u>Subject Recontact</u></b></center>
            </apex:outputPanel>
            <apex:repeat value="{!subjectContactList}" var="subjectContactId">
                    <p>{!leadsMap[subjectContactId].Narrator_Comments__c}</p>
                    <b>Interview Date:</b> {!leadsMap[subjectContactId].Interview_Date__c} <br />
                    <p><b>Investigator's Note:</b><apex:outputField value="{!leadsMap[subjectContactId].Investigators_Notes__c}" /></p>
            </apex:repeat>
