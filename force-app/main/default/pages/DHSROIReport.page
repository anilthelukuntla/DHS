                                    <td><b style="display:{!If(leadsMap[subLead].General_Reference_Association__c  != Null,'','none')}">ASSOCIATION:</b></td>
                                    <td>{!leadsMap[subLead].General_Reference_Association__c}</td>
                                </tr>
                                <apex:outputPanel rendered="{!IF(leadsMap[subLead].Joint_interview_with__c != Null,true,false)}">
                                    <tr>
                                        <td><b style="display:{!If(leadsMap[subLead].Joint_interview_with__c  != Null,'','none')}">JOINT INTERVIEW WITH:</b></td>
                                        <td>{!leadsMap[subLead].Joint_interview_with__c}</td>
                                    </tr>
                                </apex:outputPanel>
                                <tr>
                                    <td><b style="display:{!If(leadsMap[subLead].Recommends__c  != Null,'','none')}">RECOMMENDS:</b></td>
                                    <td>{!leadsMap[subLead].Recommends__c}</td>
                                </tr>
                            </table>
                            <p><apex:outputField value="{!leadsMap[subLead].Narrator_Comments__c}" /></p>
                            <p><b style="display:{!If(leadsMap[subLead].Investigators_Notes__c  != Null,'','none')}">INVESTIGATOR'S NOTE: </b><apex:outputField value="{!leadsMap[subLead].Investigators_Notes__c}" /></p>
                        </p>
                    </apex:repeat>
                    <apex:variable var="mainLeadCnt" value="{!mainLeadCnt+1}" />
                </apex:repeat>
            </apex:repeat>
            
            <!--LawEnforcement Section-->
               <apex:outputPanel rendered="{!lawEnforcementList.size >0}">
                
                  <center style="margin-top:20px;margin-bottom:15px;display:block;font-size:22px"><b><u>Law Enforcement</u></b></center>
            </apex:outputPanel>
            <apex:variable value="{!1}" var="lawCnt" />
            <apex:repeat value="{!lawEnforcementList}" var="leadId">
                <b>Law Enforcement Record {!lawCnt}: </b>
                <apex:variable var="lawCnt" value="{!lawCnt+1}" />
                <apex:outputPanel rendered="{!leadsMap[leadId].Was_the_record_obtained__c == 'Yes, record was obtained'}">
                    <p style="padding-left:15px">
                        <table>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Agency_Name__c  != Null,'','none')}">AGENCY NAME:</b></td>
                                <td>{!leadsMap[leadId].Agency_Name__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Source_First_Name__c  != Null,'','none')}">PROVIDER:</b></td>
                                <td>{!leadsMap[leadId].Source_First_Name__c} {!leadsMap[leadId].Source_Last_Name__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Source_Title__c  != Null,'','none')}">POSITION/JOB TITLE:</b></td>
                                <td>{!leadsMap[leadId].Source_Title__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Address_line_1__c  != Null,'','none')}">ADDRESS:</b></td>
                                <td>{!leadsMap[leadId].Address_line_1__c} {!leadsMap[leadId].Address_line_2__c}
                                    {!leadsMap[leadId].City__c}, {!leadsMap[leadId].State__c} {!SUBSTITUTE(leadsMap[leadId].Zip__c, '-____', '')}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Phone_Number__c  != Null,'','none')}">PHONE NUMBER:</b></td>
                                <td>{!leadsMap[leadId].Phone_Number__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Source_Email_Address__c  != Null,'','none')}">EMAIL ADDRESS:</b></td>
                                <td>{!leadsMap[leadId].Source_Email_Address__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Date_Record_Provided__c  != Null,'','none')}">DATE RECORD OBTAINED:</b></td>
                                <td><apex:outputText value="{0,date,MM/dd/yyyy}"> <apex:param value="{!leadsMap[leadId].Date_Record_Provided__c}" /> </apex:outputText></td>
                            </tr>
                            <apex:outputPanel rendered="{!IF(leadsMap[leadId].Subject_Name_Verified__c == 'Discrepant',true,false)}">
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_Name_Verified__c  != Null,'','none')}">SUBJECT NAME VERIFIED:</b></td>
                                    <td>{!leadsMap[leadId].Subject_Name_Verified__c}</td>
                                </tr>
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_Name_Discrepant_Notes__c  != Null,'','none')}">SUBJECT NAME DISCREPANT NOTES:</b></td>
                                    <td><apex:outputField value="{!leadsMap[leadId].Subject_Name_Discrepant_Notes__c}" /></td>
                                </tr>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!IF(leadsMap[leadId].Subject_SSN_Verified__c == 'Discrepant',true,false)}">
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_SSN_Verified__c  != Null,'','none')}">SUBJECT SSN VERIFIED:</b></td>
                                    <td>{!leadsMap[leadId].Subject_SSN_Verified__c}</td>
                                </tr>
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_SSN_Discrepant_Notes__c  != Null,'','none')}">SUBJECT SSN DISCREPANT NOTES:</b></td>
                                    <td><apex:outputField value="{!leadsMap[leadId].Subject_SSN_Discrepant_Notes__c}" /></td>
                                </tr>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!IF(leadsMap[leadId].Subject_DOB_Verified__c == 'Discrepant',true,false)}">
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_DOB_Verified__c  != Null,'','none')}">SUBJECT DOB VERIFIED:</b></td>
                                    <td>{!leadsMap[leadId].Subject_DOB_Verified__c}</td>
                                </tr>
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_DOB_Discrepant_Notes__c  != Null,'','none')}">SUBJECT DOB DISCREPANT NOTES:</b></td>
                                    <td><apex:outputField value="{!leadsMap[leadId].Subject_DOB_Discrepant_Notes__c}" /></td>
                                </tr>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!IF(leadsMap[leadId].Subject_POB_Verified__c == 'Discrepant',true,false)}">
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_POB_Verified__c  != Null,'','none')}">SUBJECT POB VERIFIED:</b></td>
                                    <td>{!leadsMap[leadId].Subject_POB_Verified__c}</td>
                                </tr>
                                <tr>
                                    <td><b style="display:{!If(leadsMap[leadId].Subject_POB_Discrepant_Notes__c  != Null,'','none')}">SUBJECT POB DISCREPANT NOTES:</b></td>
                                    <td><apex:outputField value="{!leadsMap[leadId].Subject_POB_Discrepant_Notes__c}" /></td>
                                </tr>
                            </apex:outputPanel>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].General_Template_Record_Type__c  != Null,'','none')}">RECORD TYPE:</b></td>
                                <td>{!leadsMap[leadId].General_Template_Record_Type__c}</td>
                            </tr>
                        </table>
                    </p>
                    <p><apex:outputField value="{!leadsMap[leadId].Narrator_Comments__c}" /></p>
                    <p><b style="display:{!If(leadsMap[leadId].Investigators_Notes__c  != Null,'','none')}">INVESTIGATOR'S NOTE: </b><apex:outputField value="{!leadsMap[leadId].Investigators_Notes__c}" /></p>
                </apex:outputPanel>
                <apex:outputpanel rendered="{!leadsMap[leadId].Was_the_record_obtained__c == 'No, record does not exist'}">
                    <p style="padding-left:15px">
                        <table>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Agency_Name__c  != Null,'','none')}">AGENCY NAME:</b></td>
                                <td>{!leadsMap[leadId].Agency_Name__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Source_First_Name__c  != Null,'','none')}">PROVIDER:</b></td>
                                <td>{!leadsMap[leadId].Source_First_Name__c} {!leadsMap[leadId].Source_Last_Name__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Source_Title__c  != Null,'','none')}">POSITION/JOB TITLE:</b></td>
                                <td>{!leadsMap[leadId].Source_Title__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Address_line_1__c  != Null,'','none')}">ADDRESS:</b></td>
                                <td>{!leadsMap[leadId].Address_line_1__c} {!leadsMap[leadId].Address_line_2__c}
                                    {!leadsMap[leadId].City__c}, {!leadsMap[leadId].State__c} {!SUBSTITUTE(leadsMap[leadId].Zip__c, '-____', '')}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Phone_Number__c  != Null,'','none')}">PHONE NUMBER:</b></td>
                                <td>{!leadsMap[leadId].Phone_Number__c}</td>
                            </tr>
                            <tr>
                                <td><b style="display:{!If(leadsMap[leadId].Source_Email_Address__c  != Null,'','none')}">EMAIL ADDRESS:</b></td>
                                <td>{!leadsMap[leadId].Source_Email_Address__c}</td>
                            </tr>
                        </table>
                    </p>
                    <p><b style="display:{!If(leadsMap[leadId].Investigators_Notes__c  != Null,'','none')}">INVESTIGATOR'S NOTE: </b><apex:outputField value="{!leadsMap[leadId].Investigators_Notes__c}" /></p>
                </apex:outputpanel>
                <apex:outputpanel rendered="{!leadsMap[leadId].Was_the_record_obtained__c == 'No, unable to obtain record'}">
                    <p><b style="display:{!If(leadsMap[leadId].Investigators_Notes__c  != Null,'','none')}">INVESTIGATOR'S NOTE: </b><apex:outputField value="{!leadsMap[leadId].Investigators_Notes__c}" /></p>
                </apex:outputpanel>
            </apex:repeat>
            
        </div>
    </body>
</apex:page>