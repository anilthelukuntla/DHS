        <script>
            $(document).ready(function () {
                $('.datepickerInput').datepicker({
                    weekStart: 1,
                    daysOfWeekHighlighted: "6,0",
                    autoclose: true,
                    todayHighlight: true,
                });



                $('.datatable').DataTable({
                    "searching": false,
                    "bLengthChange": false,
                    "bFilter": true,
                    "bInfo": true,
                    "bAutoWidth": false
                });

                $('.custom-disabled').prop("disabled", true);


            });

            function disableinputfields() {
                var userType = '{!currentuser.User_Type__c}';
                console.log({
                    userType
                });
                if (userType == 'QA') {
                    $("#shipping-info input").prop("disabled", true);
                    $("#shipping-info select").prop("disabled", true);
                    $("#shipping-info textarea").prop("disabled", true);
                }
            }
            
            function afterupdateppfshippinginformationaction(){
                $('.custom-disabled').prop("disabled", true);
            }

            function createppfshippinginformation() {
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, PPF Shipping information will be created.',
                    buttons: {
                        confirm: function () {
                            createppfshippinginformationaction();
                        },
                        cancel: function () {}
                    }
                });
            }

            function updateppfshippinginformation(ppfShippingId){
                console.log({ppfShippingId});
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, PPF Shipping information will be submitted.',
                    buttons: {
                        confirm: function () {
                            updateppfshippinginformationaction(ppfShippingId);
                        },
                        cancel: function () {}
                    }
                });
                
            }
        </script>
