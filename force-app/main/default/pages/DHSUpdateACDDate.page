<apex:page showHeader="false" sidebar="false" standardStylesheets="false" Controller="DHSUpdateACDDateController"
   docType="html-5.0">
   <head>
      <meta charset="utf-8" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
      <meta name="description" content="" />
      <meta name="author" content="" />
      <title>Bulk Update ACD Date</title>
      <style>.accordion-toggle[aria-expanded="true"] td .fa-angle-right:before{    content: "\f107";}</style>
   
      <apex:includeScript value="https://code.jquery.com/jquery-2.2.4.js"></apex:includeScript>
       
      <style>  
         .slds-scope .slds-page-header{  
         border-radius: 0px;  
         box-shadow: 0 0px 0px 0 rgba(0, 0, 0, 0.1);  
         }  
         .bodyPart{  
         padding:10px;  
         }  
         #fileNames{font-size:15px}
         .hiddenRow{padding:0 !important}
         .acddatepicker span.dateInput.dateOnlyInput:after, .acddatepicker .dategroup:after {
    content: "\f133";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    right: 10px;
    position: absolute;
    top: 2px !important;

         }
      </style>
   </head>
   <body id="page-top">
      <apex:form >
         <!-- Page Wrapper -->
         <div id="wrapper">
            <c:DIAHeader ></c:DIAHeader>
            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">
               <!-- Main Content -->
               <div id="content">
                  <!-- Topbar -->
                  <div class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                     <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">
                        <h4 class=" mb-0 text-gray-800"><b>Update ACD Date</b></h4>
                     </div>
                     <!-- Sidebar Toggle (Topbar) -->
                     <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                     <i class="fa fa-bars"></i>
                     </button>
                     <c:DIAHeaderProfile ></c:DIAHeaderProfile>
                  </div>
                  <!-- End of Topbar -->
                  <!-- Begin Page Content -->
                  <div class="container-fluid">
                    <div class="row">

                        <!-- Area Chart -->
                        <div class="col">
                            <div class="card shadow mb-4">
                                <!-- Card Header - Dropdown -->
                                <div
                                    class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                    <ul class="nav nav-tabs">
                                        <!--<li class="nav-item">
                                            <a class="nav-link active" data-toggle="tab"
                                                href="#customer-documents">Orders </a>
                                        </li>-->
                                        <li class="nav-item">
                                            <a class="nav-link active" data-toggle="tab"
                                                href="#Archive">DIA Orders</a>
                                        </li>
                                       <!-- <li class="nav-item">
                                            <a class="nav-link " data-toggle="tab"
                                                href="#Deliverables">Deliverables </a>
                                        </li>-->
                                    </ul>
                                </div>
                               
                                <!-- Card Body -->
                                <div class="card-body tab-content">
                                    <div role="tabpanel" class="tab-pane active" id="Archive">
                                        <div class="card-body ">
                                        <div style="text-align:right">
                                         <a class="ml-4 mb-3 pr-3 btn btn-primary" onclick="savecustomerorders();return false;"><i aria-hidden="true"  class="fa fa-save pr-2"></i>Save</a>
                                        <apex:actionFunction name="savecustomerorders" action="{!SaveOrderAction}" rerender="executedcustomerorderspanel" status="loader"/>
                                        <a class="ml-4 mb-3 btn btn-primary" onclick="refreshcustomerorders();return false;"><i aria-hidden="true"  class="fa fa-refresh pr-2"></i>Refresh</a>
                                            <apex:actionFunction name="refreshcustomerorders" action="{!GetCustomerOrders}" rerender="executedcustomerorderspanel" status="loader"/>
                                        </div>
                                            <apex:outputPanel id="executedcustomerorderspanel">
                                            <table class="table table-hover" style="border-collapse:collapse;">
                                                <thead>
                                                    <tr>
                                                    <th></th>
                                                        <th>OrderNumber</th>
                                                        <th>Created Date</th>
                                                        <th>Created By</th>
                                                        <th>Status</th>
                                                        <th>View</th>
                                                        <th>Log</th>
                                                        <th>ACD Date</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    <apex:repeat value="{!executedcustomerorders}" var="co">
                                                        <tr colspan="6" data-toggle="collapse"
                                                            data-target="#demo{!co.order.id}"
                                                            class="accordion-toggle">
                                                             <td><i class="fa-solid fa-angle-right"></i></td>
                                                            <td>{!co.order.Name}</td>
                                                            <td>
                                                                <apex:outputText value="{0,date,MM/dd/yyyy}">
                                                                    <apex:param value="{!co.order.createddate}" />
                                                                </apex:outputText>
                                                            </td>
                                                            <td>{!co.order.owner.name}</td>
                                                            <td>{!co.order.Status__c}</td>
                                                            <td>
                                                                <apex:outputPanel rendered="{!co.AttachmentId != Null}">
                                                                <a 
                                                                    href="/sfc/servlet.shepherd/document/download/{!co.attachmentId}" ><span
                                                                        class="glyphicon glyphicon-save-file"></span>
                                                                    View </a>
                                                                </apex:outputPanel>
                                                            </td>
                                                            <td>
                                                                <apex:outputPanel rendered="{!co.logAttachmentId != Null}">
                                                                <a 
                                                                    href="{!URLFOR($Action.Attachment.Download, co.logAttachmentId)}"><span
                                                                        class="glyphicon glyphicon-save-file"></span>
                                                                    Log </a>
                                                                </apex:outputPanel>
                                                                <apex:outputPanel rendered="{!co.logMessage != Null}">
                                                                    {!co.logMessage}
                                                                </apex:outputPanel>
                                                            </td>
                                                            <td class="acddatepicker">
                                                                <apex:outputPanel rendered="{!IF((co.order.Status__c == 'Success' || co.order.Status__c == 'Partial Success'),true, false)}">
                                                                    <apex:inputField value="{!co.order.ACD_Date__c}"
                                                                       styleclass="form-control datepickerInput " />
                                                                    <div class="input-group-append"><i
                                                                       class="fa-solid fa-calendar"></i>
                                                                    </div>
                                                                </apex:outputPanel>
                                                            </td>
                                                        </tr>
                                                        <tr class="p">
                                                            <td colspan="100" class="hiddenRow">
                                                                <div class="accordian-body collapse p-3"
                                                                    id="demo{!co.order.id}">
                                                                    <table class="table table-sm">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Case Number</th>
                                                                                <th>Subject Name</th>
                                                                                <th>Status</th>
                                                                                <th>Date submitted </th>
                                                                                <th>Case Type</th>
                                                                                <th>Service Days</th>
                                                                                <th>Due Date</th>
                                                                            </tr>
                                                                        </thead>

                                                                        <tbody>
                                                                            
                                                                            <apex:repeat var="case"
                                                                                value="{!executedCustomerOrdersandCasesMap[co.order.id]}">
                                                                                        
                                                                                <tr>
                                                                                    <td>
                                                                                        <!--<a class="nav-link font-weight-bold"
                                                                                            href="{!$Site.Prefix}/DHSCasedetail?id={!case.id}">{!case.Case_Number__c}</a>-->
                                                                                        {!case.Case_Number__c}
                                                                                    </td>
                                                                                    <td>
                                                                                        {!case.Subject_Name__c}
                                                                                    </td>
                                                                                    <td>
                                                                                        {!case.Case_Queue_Status__c}
                                                                                    </td>
                                                                                    <td>
                                                                                        <apex:outputText value="{0,date,MM/dd/yyyy}">
                                                                                            <apex:param value="{!case.Submission_Date__c}" />
                                                                                        </apex:outputText>

                                                                                    </td>
                                                                                    <td>
                                                                                        {!case.Case_Type__c}
                                                                                    </td>
                                                                                    <td>
                                                                                        {!case.Service_Days__c}
                                                                                    </td>
                                                                                    <td>
                                                                                        <apex:outputText value="{0,date,MM/dd/yyyy}">
                                                                                            <apex:param value="{!case.Case_Due_Date__c}" />
                                                                                        </apex:outputText>

                                                                                    </td>
                                                                                </tr>
                                                                                           
                                                                            </apex:repeat>
                                                                          
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </apex:repeat>
                                                </tbody>

                                            </table>
                                                </apex:outputPanel>
                                        </div>
                                     </div>
                                </div>

                            </div>

                        </div>



                    </div>
                  </div>
                  <!-- /.container-fluid -->
               </div>
               <!-- End of Main Content -->
        
               <!-- Footer -->
               <footer class="sticky-footer bg-white">
                  <div class="container my-auto">
                     <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Your Website 2021</span>
                     </div>
                  </div>
               </footer>
               <!-- End of Footer -->
            </div>
            <!-- End of Content Wrapper -->
         </div>
         <div role="alert" aria-live="assertive" data-delay="3000" aria-atomic="true" class="assigntoast fade hide"  style="position: absolute;top: 5rem;right: 0;left: 0;z-index: 99;margin: 0 auto;width: 500px;">
            <div class=" bg-danger text-white p-2">
               <strong class="me-auto">Please select a Lead</strong>
            </div>
         </div>
         <!-- End of Page Wrapper -->
         <!-- Scroll to Top Button-->
         <a class="scroll-to-top rounded" href="#page-top">
         <i class="fas fa-angle-up"></i>
         </a>
      </apex:form>
      <style>
         .dataTables_empty {
         text-align: center !important;
         font-size: 14px !important;
         font-weight: bold !important;
         color: #093b87 !important;
         }
      </style>
      <script>
         $(document).ready(function () {
             $('.dataTable').DataTable({
                 "searching": false,
                 "bLengthChange": false,
                 "bFilter": true,
                 "bInfo": true,
                 "bAutoWidth": false
             });
         });
       $('.datepickerInput').datepicker({
    weekStart: 1,
    daysOfWeekHighlighted: "6,0",
    autoclose: true,
    todayHighlight: true
});

$('.datepickerInput').on('click', function(e) {
    e.stopPropagation(); // Prevents the click from reaching the accordion
});
      </script>
   </body>
</apex:page>