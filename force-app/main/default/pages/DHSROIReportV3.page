<apex:page renderAs="pdf" controller="DHSROIReportControllerV3" showHeader="false" standardStylesheets="false"
   applyHtmlTag="false" applyBodyTag="false">
   <head>
      <meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />
      <style type="text/css">
         @page {
         size: A4 potrait;
         border: 1px solid black;
         padding-left: 5px;
         border: none;
         padding-right: 5px;
         padding-top: 5px;
         padding-bottom: 5px;
         margin-top: 70px;
         @bottom-right {
         content: "Page "counter(page) " of "counter(pages);
         }
         @top-left {
         content: element(header);
         }
         @bottom-left {
         content: element(footer);
         }
         }
         .investigatorTable td,
         .investigatorTable th {
         border: 1px solid #000;
         padding: 5px
         }
         hr {
         border-bottom: none;
         border-top: 1px solid #ccc;
         color: #ccc
         }
          p table {margin:0 ; padding:0 }
         div.header {
         margin-top: 20px;
         position: running(header);
         width: 100%;
         margin-right: 10px;
         }
         div.footer {
         position: running(footer);
         width: 100%;
         }
         .repeatTableHeader {
         -fs-table-paginate: paginate;
         }
        table td:first-child {
          text-align: left;
         width:220px;
             white-space: nowrap;
         text-transform:uppercase;
         }
          table td:first-child b{
           width:220px;
           display:inline-block;
          }
         .lowercases{text-transform:initial !important;text-align: left !important;}
          .uppercases{text-transform:uppercase !important}
         .leftTable td:first-child {
         text-align: left;
         }
         th {
         font-weight: bold;
         text-align: left;
         color: #000;
         padding: 2px 5px;
         }
         .leftTable td{ font-size: 15px;}
         td {
         font-size: 15px;
         text-align: left;
         padding: 2px 5px;
         }
         table {
         border-collapse: collapse;
         }
         table,
         th,
         td {
         border: 0px solid black;
         }
         .pagenumber:before {
         content: counter(page);
         }
         .pagecount:before {
         content: counter(pages);
         }
         .customerCaseNuber {
         font-family: "Segoe UI", Arial, sans-serif;
         text-align: right;
         font-weight: bold;
         color: #000
         }
         table{ font-family: "Times New Roman", Times, serif;}
         table td b{font-size:16px}
         table td {font-size:16px}
         .leftTable td{ font-size: 15px;}
         center.skip-title{margin-top:0 !important;margin-bottom:0 !important}
          .signature-table{width:100%}
      .signature-table td span{width:25%,display:inline-block}
      .signature-table td:first-child span{width:45%,display:inline-block}
      </style>
      <script>
         $(document).ready(function () {
             $('table').css("display", "none");
             alert($('.recontactMethod').val());
             if($('.recontactMethod').val() == 'By Telephone/Fax'){
                 console.log($('.recontactMethod').val());
                $('.recontactMethod').val('By Telephone');
            }
         })
      </script>
   </head>
   <body>
      <div class="header">
         <center>UNCLASSIFIED/FOROFFICIALUSEONLY</center>
         <div class="customerCaseNuber">{!caseRecord.Customer_Case_Number__c}</div>
      </div>
      <div class="content">
      <center>
         <apex:image id="ISNLogoBlue" value="{!$Resource.ISNLogoBlue}" width="200" />
      </center>
      <br /><br /><br />
      <!--<center><u>Investigation</u></center><br />-->
      <p>
         <b  style="display:{!If(caseRecord.Subject_Type__c == 'Applicant','','none')}">
            TO: <span style="margin-left:48px">{!caseRecord.PPF_Customer_Contact_Name__c}</span><br />
            <span style="margin-left:80px">Department of Defense</span><br />
            <span style="margin-left:80px">9800 Savage Road Suite: 6381, A5231</span>
            <br/><span style="margin-left:80px">Ft. Meade, MD 20755-6774</span>
            <br/>
            <!--<apex:outputtext styleclass="margin-left:80px" escape="false" value="{!caseRecord.PPF_Customer_Contact_Address__c}"></apex:outputtext>-->
         </b>
         <b style="display:{!If(caseRecord.Subject_Type__c == 'Contractor','','none')}">
            TO: <span style="margin-left:48px">{!caseRecord.PPF_Customer_Contact_Name__c}</span><br />
            <span style="margin-left:80px">Department of Defense</span><br />
            <span style="margin-left:80px">9800 Savage Road Suite: 6384, A5232</span>
            <br/><span style="margin-left:80px">Ft. Meade, MD 20755-6774</span>
            <br/>
            <!--<apex:outputtext styleclass="margin-left:80px" escape="false" value="{!caseRecord.PPF_Customer_Contact_Address__c}"></apex:outputtext>-->
         </b>
      </p>
      <p><b>FROM: <span style="margin-left:22px">Information Systems &amp; Networks Corporation</span><br /><span
         style="margin-left:79px">10411 Motor City Dr, Suite 700</span> 
         <br /><span
            style="margin-left:79px">Bethesda, MD 20817<br /></span>
         </b>
      </p>
      <br />
      <br />
      <div style="margin-top:15px">
         <p><b><span>CASE NAME: <span
            style="text-transform:uppercase">{!caseRecord.DHS_Contact__r.Last_Name__c}, </span>
            {!caseRecord.DHS_Contact__r.First_Name__c}
            </span>
            <span style="float:right;">SSN: {!caseRecord.DHS_Contact__r.SSN__c}</span>
            </b>
         </p>
         <p><b><span>CASE Type: {!caseRecord.Case_Type__c} - {!caseRecord.Subject_Type__c}</span>
            <span style="float:right;">BI Provider Report# {!caseRecord.Case_Number__c}</span></b>
         </p>
      </div>
      <br />
      <p style="margin-top:15px;">This is to certify the review of the attached report of investigation reflects
         that: <br /><br />
         1) The report was prepared by the investigator(s) who conducted the investigation for ISN Corporation.<br /><br />
         2) The investigation was conducted in accordance with the applicable Federal Investigative
         Standards.<br /><br />
         3) Appropriate investigation was conducted to obtain required coverage and to resolve issues and
         unfavorable information that surfaced in the course of the investigation.<br /><br />
         4) The information reported is attributed to the sources from which it was obtained.<br /><br />
         5) The sources appearing in the report were interviewed in depth covering the person's personal
         attributes
         of character, habits, honesty, reputation, and mental health, personal conduct, use of intoxicants,
         affiliations, and loyalty.
      </p>
      <div style="margin-top:10px;">
          <table cellspacing="0" cellpadding="0" border="0" width="100%" class="signature-table">
            <tr>
               <td  style="padding:10px 0;text-align:left;width:35%;text-transform:capitalize" align="left"><span>Signature: </span></td>
               <td   style="padding:10px 0;text-align:left;width:40%" align="left"><span>Name: {!caseRecord.Assigned_To_Name__c}</span></td>
               <td   style="padding:10px 0;text-align:left" align="left"><span>Date:&nbsp;<apex:outputText value="{0,date,MM/dd/yyyy}">
                        <apex:param value="{!TODAY()}" />
                     </apex:outputText></span></td>
            </tr>
         </table>
      </div>
      <div style="page-break-before:always;" />
      <center><b>REPORT OF INVESTIGATION</b></center>
      <br />
      <center><b>SUMMARY</b></center>
      <br />
      <p><b><span>Subject Name: {!caseRecord.DHS_Contact__r.First_Name__c}
         {!caseRecord.DHS_Contact__r.Last_Name__c}</span>
         <span style="float:right; width:200px; text-align:right;">Case Type:
         {!caseRecord.Case_Type__c}</span></b>
      </p>
      <table class="leftTable" style="border-spacing: 0px;" cellpadding="6" width="100%">
         <tr>
            <th>Section</th>
            <th style="width:30px;text-align:center">Number</th>
         </tr>
         <apex:outputPanel layout="none" rendered="{!caseRecord.Employment_Count__c > 0}">
            <tr>
               <td>EMPLOYMENT</td>
               <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Employment_Count__c}</td>
            </tr>
         </apex:outputPanel>
         <apex:outputPanel layout="none" rendered="{!caseRecord.General_Count__c > 0}">
            <tr>
               <td>GENERAL</td>
               <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.General_Count__c}</td>
            </tr>
         </apex:outputPanel>
         <apex:outputPanel layout="none" rendered="{!caseRecord.Medical_Count__c > 0}">
            <tr>
               <td>MEDICAL</td>
               <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Medical_Count__c}</td>
            </tr>
         </apex:outputPanel>
         <apex:outputPanel layout="none" rendered="{!caseRecord.Subject_Interview_Count__c > 0}">
            <tr>
               <td>SUBJECT INTERVIEW</td>
               <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Subject_Interview_Count__c}</td>
            </tr>
         </apex:outputPanel>
         <apex:outputPanel layout="none" rendered="{!caseRecord.Attachment_Count__c > 0}">
            <tr>
               <td>ATTACHMENTS</td>
               <td style="border-bottom:1px solid #000;width:30px;text-align:center">{!caseRecord.Attachment_Count__c}</td>
            </tr>
         </apex:outputPanel>
         <apex:outputPanel layout="none" rendered="{!caseRecord.Total_References_Count__c > 0}">
            <tr>
               <td><b>TOTAL REFERENCES</b> </td>
               <td style="border-bottom:1px solid #000;width:30px;text-align:center"><b>{!caseRecord.Total_References_Count__c}</b></td>
            </tr>
         </apex:outputPanel>
      </table>
      <p ><b>RESULTS</b><br />
         <span style="display:{!If((showAllRecordObtained == true),'','none')}">
          DHS_All records obtained.<br /></span>
          
         DHS_All sources recommend.
      </p>
      <p>
         <b>DEROGATORY SUMMARY</b><br />
          <apex:repeat value="{!derogatorySummaryItems}" var="derogatorySummaryItem">
              <apex:outputtext value="{!derogatorySummaryItem}" escape="false"/>.<br/>
          </apex:repeat>
          
         
      </p>
      <p><b>TIA REFERENCES</b><br />
         None.
      </p>
      <p><b>PENDING LEADS</b><br />
         None.
      </p>
      <div style="page-break-before:always;" />
         <center><b>REPORT OF INVESTIGATION</b></center>
         <br /><br />
         <table cellpadding="5" cellspacing="5" width="100%" class="investigatorTable leftTable"
            style="text-align:left">
            <tr>
               <th>{!caseRecord.DHS_Contact__r.First_Name__c}
                  {!caseRecord.DHS_Contact__r.Last_Name__c}
               </th>
               <th>BI Provider Report ID</th>
               <th>Investigation Dates</th>
               <th>Investigators</th>
            </tr>
            <tr>
               <td>SSN: {!caseRecord.DHS_Contact__r.SSN__c}</td>
               <td>{!caseRecord.Case_Number__c}</td>
               <td>{!investigationDates}</td>
               <td>{!investigators}</td>
            </tr>
         </table>
         <br />
         
          
         <apex:variable var="headerNum" value="{!1}" /> 
          <apex:variable var="residence" value="{!1}" /> 
          <apex:variable var="general" value="{!1}" /> 
          <apex:variable var="education" value="{!1}" /> 
          <apex:variable var="employment" value="{!1}" /> 
          <apex:variable var="former" value="{!1}" />

          <apex:variable var="REFERENCEH" value="{!1}" /> 
          <apex:variable var="MEDICAL" value="{!1}" /> 
          <apex:variable var="ENFORCEMENT" value="{!1}" /> 
          <apex:variable var="PUBLICRECORD" value="{!1}" />


         <apex:variable var="rowNum" value="{!0}" /> 
         <apex:variable var="srowNum" value="{!0}" /> 
         <apex:variable var="srrowNum" value="{!0}" /> 
         <apex:repeat value="{!leadOrder}" var="sequenceNumber">
           
            <div style="display:{!If((itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Subject Recontact (SUBC)'),'','none')}">
               <center style="margin-top:5px;margin-bottom:5px;display:block;font-size:22px;" class="title_leadtype {!IF(skipTitles[sequenceNumber], 'skip-title', '')}">
                  <b><apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Subject Recontact (SUBC)'  && (skipTitles[sequenceNumber] == false ),true,false)}">
                     <u>Subject Recontact</u>
                  </apex:outputpanel>
                  </b>
               </center>
               
            <apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Subject Recontact (SUBC)',true,false)}">
               
               <b>Recontact Date: </b> 
               <apex:outputText value="{0,date,MM/dd/yyyy}">
                  <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Interview_Date__c}" />
               </apex:outputText>
               <br />
               <p>
                  <b>Recontact Method: </b>
                   <apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].Personal_Contact_Method__c == 'By Telephone/Fax',true,false)}">
                   By Telephone
                   </apex:outputpanel>
                   <apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].Personal_Contact_Method__c != 'By Telephone/Fax',true,false)}">
                   <apex:outputField styleClass="recontactMethod" value="{!itemNumberNLeadsMap[sequenceNumber].Personal_Contact_Method__c}" />
                   </apex:outputpanel>
                  
               </p>
                <p>{!itemNumberNLeadsMap[sequenceNumber].Investigators_Notes__c}</p>
               <apex:outputpanel rendered="{!srowNum == subjectContactList.size-1  && hasSubjectRecontact}">
                <div style="page-break-before:always;" />
                   <div style="border: 1px solid black;padding:5px">
                            <center><b>DISCLAIMER</b></center>
                         
                            <p style="font-size:12px;padding:10px 0">
                            DHS_All sources were advised of the Privacy Act of 1974. In addition to the specific comments reported, and,
                            unless otherwise indicated, each interviewed Source who had personal knowledge of Subject was
                            specifically questioned about and reported no knowledge regarding Subject’s foreign travel/associations;
                            involvement with law enforcement agencies or criminal conduct; use or abuse of drugs, controlled
                            substances or alcohol; adverse personality traits; moral character; financial problems or unexplained
                            affluence; emotional or psychiatric problems/stressors; affiliation with subversive or terrorist
                            organizations; loyalty to the United States; views that would be incompatible with employment with the
                            United States government; exploitable personal conduct; or acts impugning the honesty or Integrity of
                            Subject.
                            </p>
                        
                        </div>
                        <br />
                    </apex:outputpanel>
               
                    <apex:variable var="srowNum" value="{!srowNum+1}"/>
            </apex:outputpanel>
         </div>
         <div style="display:{!If((itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Subject Interview (ESI/TESI)'),'','none')}">
            <center style="margin-top:5px;margin-bottom:5px;display:block;font-size:22px;" class="title_leadtype {!IF(skipTitles[sequenceNumber], 'skip-title', '')}">
               <b><apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Subject Interview (ESI/TESI)' && (skipTitles[sequenceNumber] == false ),true,false)}">
                  <u>Subject Interview</u>
               </apex:outputpanel>
               </b>
            </center>
            
            <apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Subject Interview (ESI/TESI)',true,false)}">
               <p style="display:{!If((itemNumberNLeadsMap[sequenceNumber].Interview_Date__c  != Null) || (itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c  != Null)  || (itemNumberNLeadsMap[sequenceNumber].Interview_Location__c  != Null)  || (itemNumberNLeadsMap[sequenceNumber].Interview_Address__c  != Null)  ,'','none')}">
                  <b style="text-transform:uppercase;display:{!If((itemNumberNLeadsMap[sequenceNumber].Interview_Date__c  != Null) || (itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c  != Null)  || (itemNumberNLeadsMap[sequenceNumber].Interview_Location__c  != Null)  || (itemNumberNLeadsMap[sequenceNumber].Interview_Address__c  != Null)    ,'inline','none')}">Interview Conditions: </b>
                
                  On&nbsp;<apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Interview_Date__c}" />, SUBJECT was interviewed as part of a {!caseRecord.Case_Type__c}.
                  The interview took place at the<span style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c  != 'Other' ,'','none')}">&nbsp;<span style="display:{!If((itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c  != Null)   ,'','none')}">SUBJECT’s</span>&nbsp;<apex:outputText value="{!LOWER(itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c)}"/></span> <span style="display:{!If((itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c  == 'Other') || (itemNumberNLeadsMap[sequenceNumber].Interviewed_at__c  == 'Educational Institution') ,'','none')}"> <apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Interview_Location__c}" /></span> located at&nbsp;<apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Interview_Address__c}" />. The interview lasted
                  approximately&nbsp;<apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Hours__c}" /><span style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Hours__c != 1,'','none')}"> hours</span><span style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Hours__c == 1,'','none')}"> hour</span><span style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Minutes__c == 0,'none','')}">&nbsp;and&nbsp;<apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Minutes__c}" /><span style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Minutes__c != 1,'','none')}"> minutes</span><span style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Length_of_interview_Minutes__c == 1,'','none')}"> minute</span></span>. Prior to the interview SUBJECT was advised 
                  of the relevant provision of the Privacy Act of 1974 and indicated understanding of the legislation. SUBJECT had no
                  objections or questions concerning the scope of the investigation. SUBJECT is not aware of any problems or circumstances that would prevent
                  or impede SUBJECT from obtaining a security clearance. A line-by-line review of the SF86 security questionnaire was conducted. Except as noted under the appropriate headings below, no
                   additional information was developed, and it was verified that the SF86 contained no errors or discrepancies.
                  
                 
                  
                 
               </p>
                <!--<p>-->
                  <b>IDENTIFICATION: </b>
                SUBJECT provided <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type__c == 'Other'}">
                                {!itemNumberNLeadsMap[sequenceNumber].Identification_Type_Notes__c},</apex:outputpanel>
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type__c == 'Passport'}"> {!itemNumberNLeadsMap[sequenceNumber].Country_of_Issuance__c} passport,</apex:outputpanel>
                
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type__c != 'Passport' && itemNumberNLeadsMap[sequenceNumber].Identification_Type__c != 'Other'}">
                    {!itemNumberNLeadsMap[sequenceNumber].Agency_of_Issuance__c}
                    {!itemNumberNLeadsMap[sequenceNumber].Identification_Type__c},
                </apex:outputpanel>
                
                 document number
                  {!itemNumberNLeadsMap[sequenceNumber].Identification_Document_Number__c}, 
                  which was viewed and verified. The ID was issued on
                  <apex:outputText value="{0, date, MMMM d','  yyyy}">
                     <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Issuance_Date__c}" />
                  </apex:outputText>
                  and expires on
                  <apex:outputText value="{0, date, MMMM d','  yyyy}">
                     <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Expiry_Date__c}" />
                  </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
               <!--</p>-->
               <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type2__c != Null}">
                <br/> <br/>
                SUBJECT provided <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type2__c == 'Other'}">
                                {!itemNumberNLeadsMap[sequenceNumber].Identification_Type_Notes2__c},</apex:outputpanel>
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type2__c == 'Passport'}"> {!itemNumberNLeadsMap[sequenceNumber].Country_of_Issuance2__c} passport,</apex:outputpanel>
                
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type2__c != 'Passport' && itemNumberNLeadsMap[sequenceNumber].Identification_Type2__c != 'Other'}">
                    {!itemNumberNLeadsMap[sequenceNumber].Agency_of_Issuance2__c}
                    {!itemNumberNLeadsMap[sequenceNumber].Identification_Type2__c},
                </apex:outputpanel> 
                
                document number
                     {!itemNumberNLeadsMap[sequenceNumber].Identification_Document_Number2__c}, 
                     which was viewed and verified. The ID was issued on
                     <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Issuance_Date2__c}" />
                     </apex:outputText>
                     and expires on
                     <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Expiry_Date2__c}" />
                     </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
                   
               </apex:outputpanel>
               <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type3__c != Null}">
                 <br/> <br/>
                  SUBJECT provided <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type3__c == 'Other'}">
                                {!itemNumberNLeadsMap[sequenceNumber].Identification_Type_Notes3__c},</apex:outputpanel>
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type3__c == 'Passport'}"> {!itemNumberNLeadsMap[sequenceNumber].Country_of_Issuance3__c} passport,</apex:outputpanel>
                
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type3__c != 'Passport' && itemNumberNLeadsMap[sequenceNumber].Identification_Type3__c != 'Other'}">
                    {!itemNumberNLeadsMap[sequenceNumber].Agency_of_Issuance3__c}
                    {!itemNumberNLeadsMap[sequenceNumber].Identification_Type3__c},
                </apex:outputpanel> 
                
                document number
                     {!itemNumberNLeadsMap[sequenceNumber].Identification_Document_Number3__c}, 
                     which was viewed and verified. The ID was issued on
                     <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Issuance_Date3__c}" />
                     </apex:outputText>
                     and expires on
                     <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Expiry_Date3__c}" />
                     </apex:outputText>. It contained all the appropriate identifiers and appeared to be valid.
                  
               </apex:outputpanel>
               <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type4__c != Null}">
                   <br/> <br/>
                       SUBJECT provided <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type4__c == 'Other'}">
                                {!itemNumberNLeadsMap[sequenceNumber].Identification_Type_Notes4__c},</apex:outputpanel>
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type4__c == 'Passport'}"> {!itemNumberNLeadsMap[sequenceNumber].Country_of_Issuance4__c} passport,</apex:outputpanel>
                
                <apex:outputpanel rendered="{!itemNumberNLeadsMap[sequenceNumber].Identification_Type4__c != 'Passport' && itemNumberNLeadsMap[sequenceNumber].Identification_Type4__c != 'Other'}">
                    {!itemNumberNLeadsMap[sequenceNumber].Agency_of_Issuance4__c}
                    {!itemNumberNLeadsMap[sequenceNumber].Identification_Type4__c},
                </apex:outputpanel> 
               
                document number
                     {!itemNumberNLeadsMap[sequenceNumber].Identification_Document_Number4__c}, 
                     which was viewed and verified. The ID was issued on
                     <apex:outputText value="{0, date, MMMM d','  yyyy}">
                        <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Identification_Issuance_Date4__c}" />
                     </apex:outputText>
