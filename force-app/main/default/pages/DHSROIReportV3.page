                  {!itemNumberNLeadsMap[sequenceNumber].Contact_Method_Inv_Note__c}&nbsp;</span>
               <apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Investigators_Notes__c}" />
            </p>

            <p style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Mailing_Attach_with_Report__c == 'Yes','','none')}">
               <b class="uppercases">Attachment
                  Description: </b>
               <apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Attachment_Description__c}">
               </apex:outputField>
            </p>
         </p>
      </apex:outputpanel>
      <apex:variable var="general" value="{!general+1}" />
   </apex:outputpanel>
</div>
<div>
   <center style="margin-top:5px;margin-bottom:5px;display:block;font-size:22px;"
      class="title_leadtype {!IF(skipTitles[sequenceNumber], 'skip-title', '')}">
      <b>
         <apex:outputpanel rendered="{!IF((itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Former Spouse (FMSP)') && (skipTitles[sequenceNumber] == false ),true,false)}">
            <u>Former Spouse</u>
         </apex:outputpanel>
      </b>
   </center>

   <apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].LeadType__c == 'Former Spouse (FMSP)',true,false)}">
      <apex:variable var="formerSub" value="{!1}" />
      <div style="display: flex; align-items: center;padding-bottom:20px;">
         <slot style="white-space: nowrap; margin-right: 100px;">
            <b style="text-transform: uppercase; text-decoration: underline;">Former Spouse
               {!former} </b>
         </slot>
         <!--<slot>
                     SF86 shows residence at 2559 W 1550 N Clinton, UT 84015 from 07/2021 to present.
                  </slot>
                  -->
      </div>
      <apex:outputpanel rendered="{!IF(itemNumberNLeadsMap[sequenceNumber].Coverage_Type__c == 'Personal',true,false)}">
         <!--<b
         style="text-transform: uppercase; text-decoration: underline;">Former Spouse {!former}
         REFERENCE {!formerSub}</b>-->
         <p style="padding-left:15px">
            <table>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Protected_Source__c == 'Yes','','none')}">
                  <td>
                     <b>PROTECTED SOURCE: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Protected_Source__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Source_Last_Name__c!= Null,'','none')}">
                  <td>
                     <b>SOURCE: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Source_First_Name__c}
                     {!itemNumberNLeadsMap[sequenceNumber].Source_Last_Name__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Source_Title__c!= Null,'','none')}">
                  <td>
                     <b>POSITION/JOB TITLE: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Source_Title__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Address_line_1__c!= Null,'','none')}">
                  <td>
                     <b>ADDRESS: </b>
                  </td>
                  <td>
                     {!itemNumberNLeadsMap[sequenceNumber].Address_line_1__c}{!itemNumberNLeadsMap[sequenceNumber].Address_line_2__c}<br></br>
                     {!itemNumberNLeadsMap[sequenceNumber].City__c},
                     {!itemNumberNLeadsMap[sequenceNumber].State__c}
                     {!LEFT(itemNumberNLeadsMap[sequenceNumber].Zip__c, 5)} </td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Phone_Number__c!= Null,'','none')}">
                  <td>
                     <b>PHONE NUMBER: </b>
                  </td>
                  <td>{!SUBSTITUTE(SUBSTITUTE(itemNumberNLeadsMap[sequenceNumber].Phone_Number__c,'(',''),')
                     ','-')}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Source_Email_Address__c!= Null,'','none')}">
                  <td>
                     <b>EMAIL ADDRESS: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Source_Email_Address__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Interview_Date__c!= Null,'','none')}">
                  <td>
                     <b>DATE INTERVIEWED: </b>
                  </td>
                  <td>
                     <apex:outputText value="{0,date,MM/dd/yyyy}">
                        <apex:param value="{!itemNumberNLeadsMap[sequenceNumber].Interview_Date__c}" />
                     </apex:outputText>
                  </td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Personal_Contact_Method__c != Null,'','none')}">
                  <td>
                     <b
                        style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Personal_Contact_Method__c != Null,'','none')}">Contact
                        Method: </b>
                  </td>
                  <td>
                     {!itemNumberNLeadsMap[sequenceNumber].Personal_Contact_Method__c }
                  </td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Interview_Mailing_Address_Diff__c == 'Yes','','none')}">
                  <td>
                     <b>INTERVIEW ADDRESS: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Interview_AddressLine1__c}
                     {!itemNumberNLeadsMap[sequenceNumber].Interview_AddressLine2__c}<br />
                     {!itemNumberNLeadsMap[sequenceNumber].Interview_City__c},&nbsp;{!itemNumberNLeadsMap[sequenceNumber].Interview_State__c}&nbsp;{!LEFT(itemNumberNLeadsMap[sequenceNumber].Interview_Zip__c,
                     5)} </td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].In_the_presence_of__c!= Null,'','none')}">
                  <td>
                     <b>IN THE PRESENCE OF: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].In_the_presence_of__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].General_Reference_Association__c!= Null,'','none')}">
                  <td>
                     <b>ASSOCIATION: </b>
                  </td>
                  <td>{!SUBSTITUTE(itemNumberNLeadsMap[sequenceNumber].General_Reference_Association__c,
                     ';', '; ')}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Span_of_Contact__c!= Null,'','none')}">
                  <td>
                     <b>SPAN OF CONTACT: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Span_of_Contact__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Joint_interview_with__c!= Null,'','none')}">
                  <td>
                     <b>JOINT INTERVIEW WITH: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Joint_interview_with__c}</td>
               </tr>
               <tr
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Recommends__c!= Null,'','none')}">
                  <td>
                     <b>RECOMMENDS: </b>
                  </td>
                  <td>{!itemNumberNLeadsMap[sequenceNumber].Recommends__c}</td>
               </tr>
            </table>
            <p>
               <apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Narrator_Comments__c}" />
            </p>
            <p
               style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Explanation_of_No_Record__c != Null,'','none')}">
               <b
                  style="text-transform:uppercase;display:{!If(itemNumberNLeadsMap[sequenceNumber].Explanation_of_No_Record__c!= Null,'','none')}"
                  class="text-uppercase">Explanation of No
                  Record: </b> {!itemNumberNLeadsMap[sequenceNumber].Explanation_of_No_Record__c} </p>
            <p>
               <b
                  style="display:{!If((itemNumberNLeadsMap[sequenceNumber].Investigators_Notes__c  != Null) || (itemNumberNLeadsMap[sequenceNumber].Contact_Method_Inv_Note__c  != Null), '','none')}">INVESTIGATOR'S
                  NOTE: </b>
               <span
                  style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Contact_Method_Inv_Note__c != Null,'','none')}">
                  {!itemNumberNLeadsMap[sequenceNumber].Contact_Method_Inv_Note__c}&nbsp;</span>
               <apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Investigators_Notes__c}" />
            </p>

            <p style="display:{!If(itemNumberNLeadsMap[sequenceNumber].Mailing_Attach_with_Report__c == 'Yes','','none')}">
               <b class="uppercases">Attachment
                  Description: </b>
               <apex:outputField value="{!itemNumberNLeadsMap[sequenceNumber].Attachment_Description__c}">
               </apex:outputField>
            </p>
         </p>
      </apex:outputpanel>
      <apex:variable var="former" value="{!former+1}" />
   </apex:outputpanel>
</div>
</apex:repeat>

</div>
   </body>
</apex:page>
