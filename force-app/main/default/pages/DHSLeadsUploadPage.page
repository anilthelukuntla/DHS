<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSLeadsUploadPageController"
    docType="html-5.0">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />

        <title>Upload Lead items</title>
    </head>

    <body id="page-top">
        <apex:form >

            <!-- Page Wrapper -->
            <div id="wrapper">

                <c:DHSHeader ></c:DHSHeader>
                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">

                                <h4 class=" mb-0 text-gray-800">

                                    <b>Case Lead Items Upload</b>
                                </h4>

                            </div>
                            <!-- Sidebar Toggle (Topbar) -->
                            <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                                <i class="fa fa-bars"></i>
                            </button>


                            <c:DHSHeaderProfile ></c:DHSHeaderProfile>

                        </nav>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-12">
                                    <apex:outputPanel id="messagespanel">
                                    <apex:outputpanel rendered="{!If(errorMessage != Null,true,false)}">
                                        <div class="alert alert-danger alert-dismissible ">
                                            <strong>Error!</strong> {!errorMessage}
                                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                                        </div>
                                    </apex:outputpanel>
                                    <apex:outputpanel rendered="{!If(successMessage != Null,true,false)}">
                                        <div class="alert alert-success alert-dismissible">
                                            <strong>Success!</strong> {!successMessage}
                                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                                        </div>
                                    </apex:outputpanel>
                                  </apex:outputPanel>  
                                    
                                    <div class="card mb-3 uploadDataWrapper active">
                                        <h2 class="mb-3 mt-5 text-center">Lead Items Upload Interface</h2>
                                        <div class="row no-gutters">
                                           <div class="col-md-12 upload-wrapper">
                                           <div class="upload-container">
                                                <div class="upload-cell pb-5 mt-2">
                                            <div class="uploadContainer uploadBoxf2 m-auto" style="width: 500px;">
                                                <table cellpadding="0" cellspacing="0" class="uploadTable table">
                                                    <tbody><tr>
                                                        <td>
                                                        <label class="custom-file-upload" for="">
                                                            <i class="fa fa-cloud-upload"></i> Select/Browse
                                                           
                                                        </label>
                                                            <apex:inputFile styleclass="custom-file-input uploadInProgress uploadInProgressFile" contentType="{!fileContentType}"  value="{!csvFileBody}"  filename="{!csvAsString}" id="inputGroupFile01"/>
                                                           <div class="uploadBox d-none py-2 my-2"></div>
                                                        </td>           
                                                    </tr>
                                                    <tr class="myProgressf2" style="display:none">
                                                        <td colspan="2">                
                                                            <div id="myProgressf2 py-2 my-3">
                                                                <div class="bar" id="barf2"></div>
                                                                <div id="barFooterf2"></div>
                                                            </div>                    
                                                        </td>
                                                    </tr>
                                                </tbody>
                                                </table>
                                                <div class="mt-5 buttonContainer">
                                                <apex:commandButton status="loader"  styleClass="btn uploadInProgress btn-primary bg-primary mr-5" value="Import" action="{!startBatchJob}"/> 
                                                <a href="{!$site.prefix}/servlet/servlet.FileDownload?file={!leadUploadDocumentId}" target="_blank">Download Template</a>
                                                </div>
                                                
                                                <!--
                                                `   <div class="uploadRules pt-3 mt-5">
                                                    <span><b>Import Rules</b></span>
                                                        <ul style="color:#78261f">
                                                            <li>InSite only allows uploads of PDF files. </li>
                                                            <li>Each loan claim document file must be separate.</li>
                                                            <li>Each file size must me no more than 25mb </li>
                                                            <li style="white-space:nowrap">File names should follow the naming conventions rule i.e. Casenumber_DocType.pdf</li>
                                                        </ul>
                                                    </div>
                                                    -->
                                                    
                                            </div>
                                            </div>
                                            </div>
                                          </div>
                                       </div>
                                    </div>  
                                </div>
                            </div>
                        </div>
                    </div>
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2021</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

            </div>
            <!-- End of Page Wrapper -->

            <!-- Scroll to Top Button-->
            <a class="scroll-to-top rounded" href="#page-top">
                <i class="fas fa-angle-up"></i>
            </a>
        </apex:form>

        <script>
            $(document).ready(function () {
                $(".custom-file-input").on("change", function() {
                  var fileName = $(this).val().split("\\").pop();
                  $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
                });   
            });
            
            
        </script>
        <style>
       .uploadBoxf2 table td{border:none;}
        .uploadTable{margin:0 0 !important}
   .uploadInProgressFile{display:none;}
.custom-file-upload {
    border:1px solid #063370;
    display: inline-block;
    padding: 15px 15px;
    cursor: pointer;
    width: 100%;
    text-align:center;
    font-size:24px;
    color:#063370;
    border-radius:8px;
}
.uploadBox {
    background: #fff;
    color: #063370;
    border: none;
    }
.buttonContainer{text-align:center;}
.custom-file-upload i{font-size:28px;}
            span.dateInput.dateOnlyInput:after, .dategroup:after {
              content: "\f133";
              font-family: "Font Awesome 6 Free";
              font-weight: 900;
              right: 10px;
              position: absolute;
              top: 4px;
            }
            .highlightrequiredfield {
                border: 1px solid red !important;
            }

            .vertical-timeline-element-content {
                margin-left: 100px;
            }

            .vertical-timeline-element-content .vertical-timeline-element-date {
                left: -120px;
            }

            .badge:empty {
                display: block
            }

            .badge-success {
                background-color: #00799B
            }

            .dataTables_info {
                padding: 0 15px
            }

            .vertical-timeline-element-content .vertical-timeline-element-date {
                color: #000
            }

            .frame {


                width: 100%;
                height: 400px;

                border-radius: 2px;
                box-shadow: 4px 8px 16px 0 rgba(0, 0, 0, 0.1);
                overflow: hidden;
                color: #000;

            }

            .frame .center {
                width: 100%;
                height: 100%;
                border-radius: 3px;
                box-shadow: 8px 10px 15px 0 rgba(0, 0, 0, 0.2);
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: space-evenly;
                flex-direction: column;
            }

            .frame .title {
                width: 100%;
                height: 50px;
                border-bottom: 1px solid #000;
                text-align: center;
            }

            ..frame h1 {
                font-size: 16px;
                font-weight: 300;
                color: #000;
            }

            .frame .dropzone {
                position: relative;
                border: 1px dashed #000;
                border-radius: 3px;
                text-align: center;
                padding: 50px;


            }

            .frame .upload-icon {
                margin: 25px 2px 2px 2px;
            }

            .frame .upload-input {
                position: absolute;
                top: 0px;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
            }

            .dateFormat {
                display: none
            }

            .form-group span {
                font-weight: bold
            }

            .input-group-append {
                position: absolute;
                top: 5px;
                right: 22px;
            }

            .datepicker.dropdown-menu {
                padding: 10px;
            }

            .taskEvent li {
                display: flex;
                color: #000;
            }

            .taskEvent span {
                position: relative;
                padding: 0 1.5em;
            }

            .sidebar #sidebarToggle::after {
                font-weight: 900;
                content: '\f104';
                font-family: 'Font Awesome 6 Free';
                margin-right: 0.1rem;
            }


            .taskEvent span::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 4px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #fff;
                border: 1px #ccc solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 2px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #00799B;
                border: 1px #00799B solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed {
                color: #00799B;
            }

            .taskEvent span {
                padding: 0 1.5em 1.5em 1.5em;
                position: relative;
                font-size: 14px;
                font-weight: bold
            }

            .taskEvent span.completed::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #00799B solid;
            }

            .taskEvent span::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #ccc solid;
            }

            .taskEvent strong {
                display: block;
                font-weight: bolder;
            }

            .taskEvent,
            .taskEvent *::before,
            .taskEvent *::after {
                box-sizing: border-box;
                font-family: arial;
            }
        </style>
        <script>
        $(document).ready(function(){
        debugger;
        var UploadInputID = $('input.custom-file-input').attr("id")
        $('label.custom-file-upload').attr('for',UploadInputID );
            $(".uploadInProgress").change(function() { 
            var files = $('.uploadInProgress')[0].files;
            for (var i = 0; i < files.length; i++) {
                $(".uploadBox ").removeClass('d-none');
                $(".uploadBox ").append("<div>"+files[i].name+"</div>");
            }
            });
        })
        </script>
    </body>
</apex:page>
