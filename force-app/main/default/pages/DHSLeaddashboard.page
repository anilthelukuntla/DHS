        <script>
            function updateACDDateFunction(){
            var anticipatedCompletionDate = $('.updateacddate').val();
                if(anticipatedCompletionDate){
                    $.confirm({
                         title: 'Update ACD Date',
                         content: 'Please confirm if you want update the entered ACD Date  '+ anticipatedCompletionDate+' to all the selected leads.',
                         buttons: {
                             confirm: function () {
                                 updateACDDate(anticipatedCompletionDate);
                             },
                             cancel: function () {}
                         }
                     });
                }else{
                    $.alert(
                             'Please select ACD date.'
                         );
                         return false;
                }
        }
        
            $(document).ready(function () {
             $('body').on('change','.leadselectcheckbox', function() {

                if ($('.leadselectcheckbox:checked').length > 0) {

                    $('.acdDateContainer').css('visibility', 'visible'); 

                } else {

                     $('.acdDateContainer').css('visibility', 'hidden');

                }

            });
            $("body").on( 'dblclick','.editAcd',function(){
             $(".editAcd").removeClass('active');
              var currentDate = $(this).find('.acdValue').text();
              $(this).find('input').val(currentDate );
              $(this).addClass('active');
                
             });
             $("body").on( 'click','.fa-check',function(){
             $(".editAcd").removeClass('active');
               var inputVal = $(this).siblings("input").val();
               var LeadId = $(this).closest('.acdEdit').attr("data-id");
               if(inputVal != ""){
               $(this).closest('.acdEdit').siblings(".acdValue").text(inputVal );
               }
               
               updateleadaction(inputVal,LeadId);
                
             });
            
                $("#content").on('click', '.selectCheckbox', function () {
                    $('#content input[type="checkbox"]').prop('checked', this.checked)
                });
                $('.datepickerInput').datepicker({
                    weekStart: 1,
                    daysOfWeekHighlighted: "6,0",
                    autoclose: true,
                    todayHighlight: true,
                });
                loaddatatables();

            });

            function acceptlead(elem) {
                console.log(elem);
                var leadid = elem.id;
                console.log(leadid);
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, lead will be accepted.',
                    buttons: {
                        confirm: function () {
                            acceptleadaction(leadid);
                        },
                        cancel: function () {}
                    }
                });


            }

            function rejectlead(elem) {
                console.log(elem);
                var leadid = elem.id;
                console.log(leadid);
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, lead will be rejected.',
                    buttons: {
                        confirm: function () {
                            rejectleadaction(leadid);
                        },
                        cancel: function () {}
                    }
                });


            }


            function leadsearch() {
                var zipPattern = /^([0-9]{5})(?:[-\s]*([0-9]{4}))?$/;
                if ($('.leadTypeSearchEntry').val() == "" && $('.leadStatusSearchEntry').val() == "" && $(
                        '.caseNumberSearchEntry').val() == "" && $('.manifestSearchEntry').val() == "" && $(
                        '.subjectFirstNameSearchEntry').val() == "" && $('.subjectLastNameSearchEntry').val() == "" &&
                    $('.streetaddressSearchEntry').val() == "" && $('.citySearchEntry').val() == "" && $(
                        '.stateSearchEntry').val() == "" && ($('.zipSearchEntry').val() == "" || $('.zipSearchEntry')
                        .val().match(zipPattern) == null)) {
                    if ($('.zipSearchEntry').val().match(zipPattern) == null) {
                        $(".zipSearchEntry").after(
                            '<div class="invalid-feedback d-block">Invalid Zip Format</div>');

                    } else {
                        $(".zipSearchEntry").after(
                            '<div class="invalid-feedback d-block">Please fill the required fields</div>');
                    }

                } else {
                    leadsearchaction();
                    $('.leadTypeSearchEntry').val('');
                    $('.leadStatusSearchEntry').val('');
                    $('.caseNumberSearchEntry').val('');
                    $('.manifestSearchEntry').val('');
                    $('.subjectFirstNameSearchEntry').val('');
                    $('.subjectLastNameSearchEntry').val('');
                    $('.streetaddressSearchEntry').val('');
                    $('.citySearchEntry').val('');
                    $('.stateSearchEntry').val('');
                    $('.zipSearchEntry').val('');

                }
            }

            function availableleadsearch() {
                console.log('inside availableleadsearch');
                availableleadsearchaction(true);
            }

            function leadunassignedsearch() {
                console.log('inside leadunassignedsearch');
                leadunassignedsearchaction(true);
            }
        	function leadqarejectedsearch(){
                console.log('inside leadqarejectedsearch');
                leadqarejectedsearchaction(true);
            }

            function myassignedleadsearch() {
                console.log('inside myassignedleadsearch');
                myassignedleadsearchaction(true);
            }

            function showqarejectedleads() {
                showqarejectedleadsaction(true);
            }
            function showdiscontinuedleads() {
                showdiscontinuedleadsaction(true);
            }
            
            function unassignleads(){
                //if($("input.leadselectcheckbox:checkbox:checked").length == $("input.leadselectcheckbox.In-Progress:checkbox:checked").length && $("input.leadselectcheckbox:checkbox:checked").length>0){
                if($("input.leadselectcheckbox:checkbox:checked").length>0){
                    $.confirm({
                        title: 'Please Confirm!',
                        content: 'On click of confirm, leads will be unassigned.',
                        buttons: {
                            confirm: function () {
                                unassignleadsaction();
                            },
                            cancel: function () {}
                        }
                    });
                 }else{
                   //if($("input.leadselectcheckbox:checkbox:checked").length > 0){
                   //    $('.assigntoast strong').text('Only In-Progress leads can be unassigned ');
                   //    $('.assigntoast').toast('show');
                   //}else{
                       $('.assigntoast strong').text('Please select a lead');
                       $('.assigntoast').toast('show');
                   //}     
                 }
            }

            function assignleads() {
                var numberofleads = $('.leadselectcheckbox:checkbox:checked').length;
                var assignto = $('.selectedUserIdForAssignment').val();
                var assigntoname = $(".selectedUserIdForAssignment option:selected").text();
                var isvalid = true;
                $('.invalid-feedback').html('');

                $('.leadselectcheckbox:checkbox:checked').each(function () {
                    var availabelforassignment = $(this).parent().parent().attr('availabelforassignment')
                    console.log({
                        availabelforassignment
                    });
                    if (availabelforassignment == 'false') {
                        $(this).parent().parent().addClass('highlightnoteligbileforassignmentrow');
                        isvalid = false;
                    } else {
                        $(this).parent().parent().removeClass('highlightnoteligbileforassignmentrow');
                    }
                });
                if (!isvalid) {
                    $('.showleadassignerror').after(
                        '<div class="invalid-feedback d-block">Leads cannot be assigned without marking Lead Completion.</div>'
                    );

                }

                if (numberofleads > 0 && assignto != '' && isvalid) {
                    $.confirm({
                        title: 'Please Confirm!',
                        content: 'Would you like to proceed with this lead assignment to ' + assigntoname + '?',
                        buttons: {
                            confirm: function () {
                                assignleadsaction();
                                $('.leadTypeSearchEntry').val('');
                                $('.leadStatusSearchEntry').val('');
                                $('.caseNumberSearchEntry').val('');
                                $('.manifestSearchEntry').val('');
                                $('.subjectFirstNameSearchEntry').val('');
                                $('.subjectLastNameSearchEntry').val('');
                                $('.streetaddressSearchEntry').val('');
                                $('.citySearchEntry').val('');
                                $('.stateSearchEntry').val('');
                                $('.zipSearchEntry').val('');
                            },
                            cancel: function () {}
                        }
                    });
                } else if (numberofleads == 0) {
                    alert('Please select a lead to assign.');
                } else if (assignto == '') {
                    alert('Please select a user to assign cases.');
                }

            }

            function loaddatatables() {
                $('#leadstable').DataTable({
                    "searching": false,
                    "bLengthChange": false,
                    "bPaginate": false,
                    "bFilter": true,
                    "bInfo": false,
                    "bAutoWidth": false,
                    "language": {
                        "zeroRecords": "No Leads found with search criteria."
                    }
                });
            }
            
             $(document).ready(function() {
            $('body').on('click','.export-button',function(e){
            e.preventDefault();

             const criteriaData = JSON.parse($('.criteriaData input').val());
                const conditions = criteriaData.map(condition => {
                    return {
                        key: condition.FieldName,
                        value: condition.FieldValue,
                        operator: condition.Operator,
                        type: condition.FieldType === 'Date' ? 'object' : null 
                    };
                });
             
              exportCSV('DHS_Lead__c', "Id", conditions, "Name","DHSLeadDashboardExport");
             return false;
            });
            });
            function exportCSV(sObjectName, fieldNames, conditions, orderBy = null, reportType) {
         
         $Lightning.use("c:exportCSVWrapperApp", function() {
         
         $Lightning.createComponent("c:dhsExportCSV",
         
         {
         
           sObjectName   : sObjectName, // You can pass the value to @api attributes if you have inside JavaScript Class.
         
           fieldNames : fieldNames,
         
           conditions: conditions,
         
           orderBy: orderBy,
           
           reportType : reportType
         
         },
         
         "LwcId", // the Id of div tag where your component will be rendered
         
         function(cmp) {
         
           console.log('Calling the LWC Component');
         
         });
         
         });
         
         }
            
        </script>
        <style>
            .dataTables_empty {
                text-align: center !important;
                font-size: 14px !important;
                font-weight: bold !important;
                color: #093b87 !important;
            }
        </style>
    </body>
