<apex:page showHeader="false" standardStylesheets="false" applyHtmlTag="true" applyBodyTag="true">
    <html>
        <head>
            <title>Generating ROI PDF</title>
            <style>
                body {
                    background: #f3f6f9;
                    color: #000;
                    font-family: Arial, sans-serif;
                    margin: 0;
                }
                .shell {
                    background: #fff;
                    border: 1px solid #d9e2ec;
                    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
                    margin: 120px auto;
                    max-width: 520px;
                    padding: 28px;
                }
                h1 {
                    color: #00799b;
                    font-size: 22px;
                    margin: 0 0 8px;
                }
                p {
                    color: #536878;
                    font-size: 14px;
                    margin: 0 0 20px;
                }
                .bar {
                    background: #e7eef4;
                    height: 10px;
                    overflow: hidden;
                    width: 100%;
                }
                .fill {
                    animation: loading 1.4s ease-in-out infinite;
                    background: #00799b;
                    height: 100%;
                    width: 45%;
                }
                @keyframes loading {
                    0% { transform: translateX(-110%); }
                    100% { transform: translateX(240%); }
                }
            </style>
        </head>
        <body>
            <main class="shell">
                <h1>Generating ROI PDF</h1>
                <p>Loading DHS designer templates and rendering matching case leads.</p>
                <div class="bar"><div class="fill"></div></div>
            </main>
            <script>
                window.setTimeout(function () {
                    var sequenceId = '{!JSENCODE($CurrentPage.parameters.sequenceid)}';
                    var targetUrl = '{!$site.prefix}/apex/DHSROIReportDesignerPreview?id={!JSENCODE($CurrentPage.parameters.id)}';
                    if (sequenceId) {
                        targetUrl += '&sequenceid=' + encodeURIComponent(sequenceId);
                    }
                    window.location.href = targetUrl;
                }, 350);
            </script>
        </body>
    </html>
</apex:page>