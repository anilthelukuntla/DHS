        <script>
         $(function(){  
  var fileLength = 0; 
  var ids = [];
  
  // Display selected file names
  $('#addr').change(function() {
    var files = this.files;
    fileLength = files.length;
    var fileNames = [];

    $('#fileNames').empty(); // Clear the previous file names

    for (var i = 0; i < fileLength; i++) {
      fileNames.push(files[i].name);
    }

    if (fileLength > 0) {
      $('#fileNames').html('<b>Selected files:</b> ' + fileNames.join(', '));
    } else {
      $('#fileNames').html('No files selected.');
    }
  });

  $('#uploadBtn').click(function() {  
    $('#records').empty(); // Clear previous records message
    var v = document.getElementById('addr');  
    console.log(v.files.length);  
    fileLength = v.files.length;  
    for (var i = 0; i < v.files.length; i++) {  
      uploadSelectedFile(v.files[i], function(err, res) {   
        FileUploading += 1;  
        if (FileUploading === FileUploaded) {  
            // alert('Upload completed');  
          document.getElementById("addr").value = "";  
            $('#fileNames').empty(); // Clear file names display
            $('#records').empty(); // Clear previous records message
        }  
      });  
    } 
  });

  var FileUploading = 0;  
  var FileUploaded = 0;  

  var uploadSelectedFile = function(file, callback) {  
    filetoBase64(file, function(err, content) {  
      var conVer_object = {  
        ContentLocation: 'S',  
        VersionData: content,   
        PathOnClient: file.name,   
        Title: file.name   
      };  

      $.ajax({  
        url: '/services/data/v39.0/sobjects/ContentVersion',  
        data: JSON.stringify(conVer_object),  
        type: 'POST',  
        processData: false,  
        contentType: 'application/json',  
        headers: {'Authorization': 'Bearer {!$Api.Session_ID}', 'Content-Type': 'application/json'},  
        xhr: function() {  
          var xhr = new window.XMLHttpRequest();  
          xhr.upload.addEventListener("progress", function(evt) {  
            if (evt.lengthComputable) {  
              FileUploaded = 0;
              ids = [];
              $('#progress_bar_container').css('display', 'block');  
              var percentComplete = (evt.loaded / evt.total) * 100;  
              $('#percentText').html("Uploading... " + Math.round(percentComplete) + "%");  
              $('.progress-bar').css('width', percentComplete + "%");  
              if (percentComplete === 100) {  
                setTimeout(function() {
                  $('#progress_bar_container').css('display', 'none');  
                }, 300); // Minimal delay to ensure visibility
              }  
            }  
          }, false);  
          return xhr;  
        },  
        success: function(response) {  
          FileUploaded += 1;  
          ids.push(response.id);
          $('#records').html('Files has been uploaded successfully.');  
            
          callback(null, true);  
        },  
        error: function(xhr, status, error) {
          console.error('Upload failed: ', status, error);
          callback(error, null);
        }
      });  
    });  
  };

  var filetoBase64 = function(file, callback) {  
    var reader = new FileReader();  
    reader.onload = function() {  
      var myFileContents = reader.result;  
      var base64Mark = 'base64,';  
      var dataStart = myFileContents.indexOf(base64Mark) + base64Mark.length;  
      myFileContents = myFileContents.substring(dataStart);  
      callback(null, myFileContents);  
    }  
    reader.readAsDataURL(file);  
  }  
});
          </script>
