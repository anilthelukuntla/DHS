<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSProfilePageController"
    docType="html-5.0">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />

        <title>Profile</title>



    </head>

    <body id="page-top">
        <apex:form >

            <!-- Page Wrapper -->
            <div id="wrapper">

                <c:DHSHeader ></c:DHSHeader>
                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">
                                <apex:outputpanel id="casedetailpageheader">
                                    <h4 class=" mb-0 text-gray-800">

                                        Profile</h4>
                                </apex:outputpanel>
                            </div>
                            <!-- Sidebar Toggle (Topbar) -->
                            <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                                <i class="fa fa-bars"></i>
                            </button>


                            <ul class="navbar-nav ml-auto">



                                <!-- Nav Item - Alerts -->


                                <div class="topbar-divider d-none d-sm-block"></div>

                                <!-- Nav Item - User Information -->
                                <li class="nav-item dropdown no-arrow">
                                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <span
                                            class="mr-2 d-none d-lg-inline text-gray-600 small">{!$User.FirstName}&nbsp;{!$User.LastName}</span>
                                        <img class="img-profile rounded-circle"
                                            src="{!URLFOR($Resource.chatdashboard,'img/undraw_profile.svg')}" />
                                    </a>
                                    <!-- Dropdown - User Information -->
                                    <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                        aria-labelledby="userDropdown">
                                        <a class="dropdown-item" href="#">
                                            <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                            Profile
                                        </a>

                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="#" data-toggle="modal"
                                            data-target="#logoutModal">
                                            <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                            Logout
                                        </a>
                                    </div>
                                </li>

                            </ul>

                        </nav>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->

                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card">
                                        <div class="card-body row">

                                            <div class="col-7 ">
                                                <div class="p-3 ">
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <h4 class="text-left text-primary">Profile Settings</h4>
                                                    </div>
                                                    <apex:outputPanel id="userpanel">
                                                    <div class="row mt-2">
                                                        <div class="col-md-6"><label
                                                                for="exampleFormControlInput1">First Name</label>
                                                            <apex:inputfield styleclass="form-control"
                                                                value="{!userRecord.FirstName}" />
                                                        </div>
                                                        <div class="col-md-6 mt-2"><label class="labels">Last Name</label>
                                                            <apex:inputfield styleclass="form-control"
                                                                value="{!userRecord.LastName}" />
                                                        </div>
                                                        
                                                            <div class="col-md-6 mt-2"><label class="labels">Email
                                                                    ID</label>
                                                                <apex:inputfield styleclass="form-control"
                                                                    value="{!userRecord.Email}" />
                                                            </div>

                                                     

                                                        <div class="col-md-6 mt-2"><label class="labels">Out of
                                                                Office</label>


                                                            <apex:inputfield onchange="useroutofofficechange();return false;"
                                                                styleclass="form-select form-select-sm form-control selectedLeaveType"
                                                                value="{!userRecord.Out_of_Office__c}">

                                                            </apex:inputfield>
                                                            <apex:actionfunction name="useroutofofficechange"
                                                                action="{!updatefieldfisibility}"
                                                                rerender="Newfields" />



                                                        </div>

                                                    </div>
                                                    <apex:outputPanel id="Newfields">

                                                        <apex:outputPanel rendered="{!showFields}">
                                                            <div class="row mt-2">
                                                                <div class="col-md-6"><label class="labels">From
                                                                        Date</label>
                                                                    <apex:inputfield type="date"
                                                                        styleclass="form-control"
                                                                        value="{!userRecord.From_Date__c}" />
                                                                </div>
                                                                <div class="col-md-6"><label class="labels">To
                                                                        Date</label>
                                                                    <apex:inputfield type="date"
                                                                        styleclass="form-control"
                                                                        value="{!userRecord.To_Date__c}" />
                                                                </div>
                                                            </div>

                                                            <div class="row mt-2">
                                                                <div class="col-md-6">
                                                                    <label class="labels">Backup User</label>
                                                                    <apex:selectlist styleclass="form-select form-select-sm form-control selectedUserIdForAssignment"
                                                                        size="1" value="{!selectedUserIdForAssignment}">
                                                                        <apex:selectOptions value="{!assignUserList}" />
                                                                    </apex:selectlist>
                                                                </div>
                                                            </div>

                                                        </apex:outputPanel>

                                                    </apex:outputPanel>
                                                  </apex:outputPanel>  

                                                    <div class="mt-3"><button class="btn btn-primary profile-button"
                                                            type="button"
                                                            onclick="updateUserRecord();return false;">Save
                                                            Profile</button>
                                                        <apex:actionFunction name="updateuserrecordaction"
                                                            action="{!updateuserrecordaction}" status="loader"
                                                            rerender="userpanel" />
                                                    </div>


                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>


                            <!-- Content Row -->


                        </div>
                        <!-- /.container-fluid -->

                    </div>
                    <!-- End of Main Content -->

                    <!-- Footer -->
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2021</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

            </div>
            <!-- End of Page Wrapper -->

            <!-- Scroll to Top Button-->
            <a class="scroll-to-top rounded" href="#page-top">
                <i class="fas fa-angle-up"></i>
            </a>


        </apex:form>

        <script>
            function updateUserRecord() {
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'Would you like to update the user profile?',
                    buttons: {
                        confirm: function () {
                            updateuserrecordaction();
                        },
                        cancel: function () {}
                    }
                });
            }
        </script>
    </body>
</apex:page>