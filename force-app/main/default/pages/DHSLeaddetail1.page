<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSLeadDetailPageController"
    docType="html-5.0">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />
        <title>Lead Detail</title>
        <style>
         .standardisedissues tbody td label{margin-left:5px}
        .standardisedissues tbody{
        display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
        }
        .emptyValues .errormessage{display:inline-block; color:#dc3545;font-size:12px}
        .errormessage{display:none}
        .identification_card.disabled{display:none;}
         .identificationHeader{position:relative;}
        .identificationHeader i.fa-plus-square{position: absolute;top: 4px;right: 20px;font-size: 14px;cursor:pointer;color:#00799B}
        .identificationHeader i.fa-minus-square{position: absolute;top: 4px;right: 0px;font-size: 14px;cursor:pointer;color:#00799B}
        .identification_card.arrows .identificationHeader i{display:inline}
        .identification_card .identificationHeader i{display:none}
            span.dateInput.dateOnlyInput:after {
                top:4px !important;
            }

            .form-group[required="required"] label:after {
                content: "*";
                top: -0.1em;
                font-size: 15px;
                color: #dc3545;
            }

            input[type=checkbox] {
                width: initial
            }

            .trumbowyg-editor {
                min-height: 180px;
            }

            .form-control.error {
                color: inherit;
                font-size: 0.8rem;
                font-weight: 400;
                line-height: 1.2;
                width: inherit;
            }

            .frame {
                width: 100%;
                height: 400px;
                border-radius: 2px;
                box-shadow: 4px 8px 16px 0 rgba(0, 0, 0, 0.1);
                overflow: hidden;
                color: #000;
            }

            .frame .center {
                width: 100%;
                height: 100%;
                border-radius: 3px;
                box-shadow: 8px 10px 15px 0 rgba(0, 0, 0, 0.2);
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: space-evenly;
                flex-direction: column;
            }

            .frame .title {
                width: 100%;
                height: 50px;
                border-bottom: 1px solid #000;
                text-align: center;
            }

            .frame h1 {
                font-size: 16px;
                font-weight: 300;
                color: #000;
            }

            .frame .dropzone {
                border: 1px dashed #000;
                border-radius: 3px;
                text-align: center;
                padding: 50px;
            }

            .frame .upload-icon {
                margin: 25px 2px 2px 2px;
            }

            .frame .upload-input {
                position: relative;
                top: -62px;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
            }

            .dateFormat {
                display: none
            }

            .form-group span {
                font-weight: bold
            }

            .input-group-append {
                position: relative;
                top: 5px;
                left: 10px;
            }

            .datepicker.dropdown-menu {
                padding: 10px;
            }

            .taskEvent li {
                display: flex;
                color: #000;
            }

            .taskEvent span {
                position: relative;
                padding: 0 1.5em;
            }

            .sidebar #sidebarToggle::after {
                font-weight: 900;
                content: '\f104';
                font-family: 'Font Awesome 6 Free';
                margin-right: 0.1rem;
            }

            .taskEvent span::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 4px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #fff;
                border: 1px #ccc solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 2px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #00799B;
                border: 1px #00799B solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed {
                color: #00799B;
            }

            .taskEvent span {
                padding: 0 1.5em 1.5em 1.5em;
                position: relative;
                font-size: 14px;
                font-weight: bold
            }

            .taskEvent span.completed::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #00799B solid;
            }

            .taskEvent span::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #ccc solid;
            }

            .taskEvent strong {
                display: block;
                font-weight: bolder;
            }

            .taskEvent,
            .taskEvent *::before,
            .taskEvent *::after {
                box-sizing: border-box;
                font-family: arial;
            }

            /* Highlight fields updated by grammar response */
            .grammar-updated {
                border: 1px solid #28a745 !important;
                background-color: #f0fff4 !important;
                color: #155724 !important;
            }

            .grammar-suggestion-table th,
            .grammar-suggestion-table td {
                vertical-align: top;
            }

            .grammar-suggestion-value {
                white-space: pre-wrap;
                word-break: break-word;
            }

            .grammar-suggestion-input {
                width: 100%;
                min-height: 72px;
                resize: vertical;
            }

            .grammar-suggestion-actions {
                margin-top: 8px;
                display: flex;
                gap: 8px;
                align-items: center;
            }
            .grammar-suggestion-edit-wrapper{position:relative;}
            .grammar-suggestion-actions {
    margin-top: 8px;
    display: flex;
    gap: 8px;
    align-items: center;
    position: absolute;
    top: -5px;
    right: 0;}
    #grammarSuggestionMessage{color:#000}
    #grammarSuggestionModal .modal-title{color:#000}
    #grammarSuggestionTableBody td{color:#000}
}
        </style>
    </head>

    <body id="page-top">
        <apex:form >
            <!-- Modal for Edit/Delete Message -->
         <div class="modal fade" id="messageModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
               <div class="modal-content">

                  <div class="modal-header">
                     <apex:outputPanel id="messageModalHeader">
                        <h5 class="modal-title" style="font-size: x-large;">
                           <apex:outputPanel rendered="{!modalAction == 'edit'}">
                              Edit Message
                           </apex:outputPanel>
                           <apex:outputPanel rendered="{!modalAction == 'delete'}">
                              Delete Message
                           </apex:outputPanel>
                        </h5>
                     </apex:outputPanel>

                     <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                     </button>
                  </div>


                  <div class="modal-body">
                     <apex:outputPanel id="messageModalBody">
                        <!-- Edit form fields -->
                        <apex:outputPanel rendered="{!modalAction == 'edit'}">
                           <div class="form-group">
                              <label>Subject</label>
                              <apex:inputText value="{!selectedMessage.Subject__c}" html-data-apiname="Subject__c" styleClass="form-control"/>
                           </div>
                           <div class="form-group">
                              <label>Body</label>
                              <apex:inputTextarea value="{!selectedMessage.Message_Body__c}" html-data-apiname="Message_Body__c" styleClass="form-control editor"/>
                           </div>
                        </apex:outputPanel>

                        <!-- Delete confirmation -->
                        <apex:outputPanel rendered="{!modalAction == 'delete'}">
                           <p>Are you sure you want to delete this message?</p>
                        </apex:outputPanel>
                     </apex:outputPanel>
                  </div>

                  <div class="modal-footer">
                     <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>

                     <apex:outputPanel id="messageModalFooter">
                        <!-- Edit save -->
                        <apex:commandButton value="Save Changes" 
                           action="{!updateMessage}" 
                           rendered="{!modalAction == 'edit'}"
                           styleClass="btn btn-primary"
                           rerender="casemessagespanel,messageModalBody,messageModalFooter" 
                           oncomplete="$('#messageModal').modal('hide'); $('.successtoast strong').text('Message Saved'); $('.successtoast').toast('show');refreshmessageaction();"/>

                        <!-- Delete confirm -->
                        <apex:commandButton value="Delete Message" 
                           action="{!deleteMessage}" 
                           rendered="{!modalAction == 'delete'}"
                           styleClass="btn btn-danger"
                           rerender="casemessagespanel,messageModalBody,messageModalFooter" 
                           oncomplete="$('#messageModal').modal('hide');$('.successtoast strong').text('Message Deleted'); $('.successtoast').toast('show');refreshmessageaction();"/>
                     </apex:outputPanel>
                  </div>

               </div>
            </div>
         </div>
         <div class="modal fade" id="grammarSuggestionModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-xl" role="document">
               <div class="modal-content">
                  <div class="modal-header">
                     <h5 class="modal-title" style="font-size: x-large;">Grammar Suggestions</h5>
                     <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">x</span>
                     </button>
                  </div>
                  <div class="modal-body">
                     <p id="grammarSuggestionMessage" class="mb-3">Select the rows you want to update, then confirm.</p>
                     <div class="table-responsive">
                        <table class="table table-bordered grammar-suggestion-table mb-0">
                           <thead>
                              <tr id="grammarSuggestionTableHeadRow">
                                 <th style="width: 70px;">Select</th>
                                 <th style="width: 30%;">Field Label</th>
                                 <th style="width: 35%;">Field Value</th>
                                 <th style="width: 35%;">Grammar Corrected Value</th>
                              </tr>
                           </thead>
                           <tbody id="grammarSuggestionTableBody"></tbody>
                        </table>
                     </div>
                  </div>
                  <div class="modal-footer">
                     <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                     <button type="button" class="btn btn-primary" id="grammarSuggestionConfirm" onclick="applySelectedGrammarSuggestions()">Confirm</button>
                  </div>
               </div>
            </div>
         </div>
            <!-- Page Wrapper -->
            <div id="wrapper">
                <c:DHSHeader ></c:DHSHeader>
                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">
                    <!-- Main Content -->
                    <div id="content">
                        <!-- Topbar -->
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">
                                <h4 class=" mb-0 text-gray-800">
                                    <b>Task Management</b>
                                </h4>
                            </div>
                            <!-- Sidebar Toggle (Topbar) -->
                            <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                                <i class="fa fa-bars"></i>
                            </button>
                            <c:DHSHeaderProfile ></c:DHSHeaderProfile>
                            <script>
                                function setFocusOnLoad() {}
                            </script>
                        </nav>
                        <!-- End of Topbar -->
                        <!-- Begin Page Content -->
                        <div class="container-fluid">
                            <div class="modal fade" id="docReference" tabindex="-1" aria-labelledby="docReference"
                                aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLabel">Document Request </h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">×</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <form>
                                                <div class="form-group">
                                                    <label for="exampleFormControlInput1">To address</label>
                                                    <apex:inputfield type="email" styleclass="form-control"
                                                         value="{!documentRequest.To_Address__c}" html-data-apiname="To_Address__c" />
                                                </div>
                                                <div class="form-group">
                                                    <label for="exampleFormControlInput1">Additional address</label>
                                                    <apex:inputfield type="email" styleclass="form-control"
                                                        value="{!documentRequest.Additional_To_Address__c }" />
                                                </div>
                                                <div class="form-group">
                                                    <label for="exampleFormControlTextarea1">Notes</label>
                                                    <apex:inputfield styleclass="form-control"
                                                        id="exampleFormControlTextarea1"
                                                        value="{!documentRequest.Investigator_Comments__c }" />
                                                </div>
                                            </form>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-primary"
                                                onclick="createdocumentrequest();return false;">Submit</button>
                                            <button type="button" class="btn btn-secondary"
                                                data-dismiss="modal">Close</button>
                                            <apex:actionFunction name="createdocumentrequestaction"
                                                action="{!createdocumentrequestaction}" rerender="documentrequests"
                                                status="loader" oncomplete="loaddatatables();return false;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <!-- <div class="d-flex justify-content-end mb-3"><button type="button"
                                            class="btn btn-primary {!If(currentuser.user_type__c == 'QA','d-none','')}"
                                            data-toggle="modal" data-target="#docReference">
                                            New Document Request
                                        </button></div> -->
                                    <div class="card shadow mb-4">
                                        <div
                                            class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                            <ul class="nav nav-tabs">
                                                <li class="nav-item">
                                                    <a class="nav-link active" data-toggle="tab" href="#Lead-info"> Lead
                                                        details</a>
                                                </li>
                                                <li class="nav-item">
                                                    <a class="nav-link" data-toggle="tab" href="#lead-messages">
                                                        Messages</a>
                                                </li>
                                            </ul>
                                            <a class="btn btn-primary {!If(fromCase,'','d-none')}"
                                                href="{!$Site.Prefix}/DHSCasedetail?id={!leadrecord.DHS_Case__c}&tab=Leads">Back </a>
                                        <a class="btn btn-primary {!If(!fromCase,'','d-none')}"
                                                href="{!$Site.Prefix}/DHSLeaddashboard?{!urlparametersString}">Back </a>
                                        </div>
                                        <div class="card-body tab-content">
                                            <div class="d-none">
                                                <apex:inputField value="{!leadRecord.GrammarChecked__c}" styleClass="grammarCheckedField" />
                                                <apex:inputField value="{!leadRecord.GrammarDoubleChecked__c}" styleClass="grammarDoubleCheckedField" />
                                            </div>
                                            <apex:outputPanel rendered="{!OR(currentuser.User_Type__c == 'CMO', currentuser.User_Type__c == 'PMO')}">
                                                <div class="d-flex justify-content-end align-items-center mb-3 flex-wrap" style="gap:8px">
                                                    <button class="btn btn-primary" type="button" id="grammarBtn" onclick="checkGrammarCorrection()">
                                                        Check Grammar (DHS_All Fields)
                                                    </button>
                                                    <button class="btn btn-primary" type="button" id="grammarCorrectionsBtn" onclick="openGrammarCorrectionsModal()" style="display:none;">
                                                        Grammar Corrections
                                                    </button>
                                                    <button class="btn btn-primary" type="button" id="undoBtn" onclick="revertToPrevious()">
                                                        Undo (DHS_All Fields)
                                                    </button>
                                                    <button class="btn btn-primary" type="button" id="redoBtn" onclick="forwardToNext()">
                                                        Redo (DHS_All Fields)
                                                    </button>
                                                </div>
                                            </apex:outputPanel>
                                            <div role="tabpanel" id="Lead-info" class="tab-pane active">
                                                <apex:outputPanel id="leaddetailpanel">
                                                    <div class="mb-2 ">
                                                        <div class="card card-body">
                                                            <apex:outputPanel rendered="{!IF(leadRecord.LeadType__c == 'Subject Interview (ESI/TESI)',true,false)}">
                                                                <div class="row mb-2">
                                                                    <div class="form-group mb-2 col-4 subjectInterviewConductedGroup" required="required">
                                                                        <label>Was Subject interview conducted?</label>
                                                                        <apex:inputField value="{!leadRecord.Was_Subject_Interview_Conducted__c}" html-data-apiname="Was_Subject_Interview_Conducted__c"
                                                                            styleClass="form-control subjectinterviewconducted"
                                                                            onchange="subjectInterviewConductedChange();return false;" />
                                                                    </div>
                                                                    <div class="form-group mb-2 col-8 d-none subjectInterviewReasonGroup">
                                                                        <label>If No, explain why subject interview was not conducted</label>
                                                                        <apex:inputField value="{!leadRecord.Subj_Int_Not_Conducted_Reason__c}" html-data-apiname="Subj_Int_Not_Conducted_Reason__c"
                                                                            styleClass="form-control subjectinterviewnotconductedreason" />
                                                                    </div>
                                                                </div>
                                                            </apex:outputPanel>
                                                            <h4 class="font-weight-bold text-primary">Case #
                                                                {!leadRecord.Case_Number__c}</h4>
                                                             <h4 class="font-weight-bold text-primary">Item #
                                                                
                                                                 
                                                                 
                                                                     {!leadRecord.Item_number__c}
                                                                 
                                                            </h4>
                                                            <h4 class="font-weight-bold text-primary"> Lead Type:
                                                                <apex:outputPanel rendered="{!leadRecord.LeadType__c == 'Subject Recontact (SUBC)'}">
                                                                    Subject Recontact Personal
                                                                </apex:outputPanel>
                                                                <apex:outputPanel rendered="{!leadRecord.LeadType__c != 'Subject Recontact (SUBC)'}">
                                                                    {!leadRecord.LeadType__c} <apex:outputPanel rendered="{!leadRecord.LeadType__c != 'Subject Recontact (SUBC)' && leadRecord.LeadType__c != 'Header' && leadRecord.LeadType__c != 'Subject Interview (ESI/TESI)'}">
                                                                        {!leadRecord.Coverage_Type__c}
                                                                    </apex:outputPanel>
                                                                </apex:outputPanel>
                                                            </h4> 
                                                            <h4 class="font-weight-bold text-primary"> Lead Status:
                                                                 {!leadRecord.Status__c}
                                                            </h4>
                                                            <h4 class="font-weight-bold text-primary"> CMO:
                                                                 {!caseRecord.DHS_Assigned_To__r.LastName} {!caseRecord.DHS_Assigned_To__r.FirstName}
                                                            </h4>
                                                            <apex:outputPanel rendered="{!IF(leadRecord.LeadType__c == 'Subject Interview (ESI/TESI)' || leadRecord.LeadType__c == 'Header',false,true)}">
                                                            <div class="row" >
                                                             <h4 class="m-3 row col-12 m-0 p-0"><span class="col-4  m-0 p-0">Lead Contact Information:</span> 
                                                           <span class="row col-4 m-0 p-0" style="margin-left: -10px !important;">
                                                            <span class="mr-5" style="display:{!If((leadRecord.LeadType__c != 'Subject Interview (ESI/TESI)' && (currentuser.user_type__c == 'PMO')),'flex','none')}">
                                                                <label>Developed: </label><apex:inputField value="{!leadRecord.Developed__c}" html-data-apiname="Developed__c" styleclass="form-control ml-2" style="margin-top: -7px;"/></span>
                                                                </span>
                                                             
                                                             </h4>
                                                                    <div class="form-group mb-4 col-12 row">
                                                                       
                                                                        <!--<apex:inputfield styleclass="form-control leadcontactinformation"
                                                                             value="{!leadRecord.Lead_Contact_Information__c}" html-data-apiname="Lead_Contact_Information__c"
                                                                            onfocus="return false;" />-->
                                                                       <div class="col-4 mt-2">
                                                                         <label>
                                                                         Lead Contact Name</label>
                                                                         <apex:inputField value="{!leadRecord.Lead_Contact_Name__c}" html-data-apiname="Lead_Contact_Name__c" styleclass="form-control leadcontactinformationinput" />
                                                                         
                                                                      </div>
                                                                       <div class="col-4 mt-2">
                                                                         <label>
                                                                         Lead Contact Address</label>
                                                                         <apex:inputField value="{!leadRecord.Lead_Contact_Address__c}" html-data-apiname="Lead_Contact_Address__c" styleclass="form-control leadcontactinformationinput" />
                                                                         
                                                                      </div>
                                                                      <div class="col-4 mt-2">
                                                                         <label>
                                                                         Lead Contact City</label>
                                                                         <apex:inputField value="{!leadRecord.Lead_Contact_City__c}" html-data-apiname="Lead_Contact_City__c" styleclass="form-control leadcontactinformationinput" />
                                                                         
                                                                      </div>
                                                                       <div class="col-4 mt-2">
                                                                         <label>
                                                                         Lead Contact State</label>
                                                                         <apex:inputField value="{!leadRecord.Lead_Contact_State__c}" html-data-apiname="Lead_Contact_State__c" styleclass="form-control leadcontactinformationinput" />
                                                                        
                                                                      </div>
                                                                      
                                                                       <div class="col-4 mt-2">
                                                                         <label>
                                                                         Lead Contact Zip</label>
                                                                         <apex:inputField value="{!leadRecord.Lead_Contact_Zip__c}" html-data-apiname="Lead_Contact_Zip__c" styleclass="form-control zipCode leadcontactinformationinput" />
                                                                        
                                                                      </div>
                                                                      <div class="col-4 mt-2 leadDates {!If(leadRecord.Coverage_Type__c == 'General Record','','d-none')}">
                                                                        <label>Dates</label>
                                                                        <apex:inputField value="{!leadRecord.Lead_Dates__c}" html-data-apiname="Lead_Dates__c"
                                                                            styleClass="form-control leadcontactinformationinput {!IF(OR(currentUser.User_Type__c != 'CMO', currentUser.User_Type__c != 'PMO'), '', 'leaddates')}"
                                                                        />
                                                                    </div>
                                                                       <div class="col-4 mt-2">
                                                                         <label>
                                                                         Lead Contact Other Information</label>
                                                                         <apex:inputField value="{!leadRecord.Lead_Contact_Other_Information__c}" html-data-apiname="Lead_Contact_Other_Information__c" styleclass="form-control leadcontactinformationinput" />
                                                                        
                                                                      </div>
                                                                    
                                                                      <!--Publicly Available Electronic Information (PAEI) General Record-->
                                                                      <div class="col-12 m-0 p-0 form-group row {!IF(leadRecord.LeadType__c == 'Publicly Available Electronic Information (PAEI)',"",'d-none')}">
                                                                        <div class="col-4 mt-2 {!IF(leadRecord.LeadType__c == 'Publicly Available Electronic Information (PAEI)',"",'d-none')}">
                                                                            <label>
                                                                                Date Search Conducted:</label>
                                                                            <apex:inputField value="{!leadRecord.Date_Search_Conducted__c}" html-data-apiname="Date_Search_Conducted__c" styleclass="form-control datepickerInput" />
                                                                         </div>
                                                                         <div class="form-group col-4 mt-2 {!IF(leadRecord.LeadType__c == 'Publicly Available Electronic Information (PAEI)',"",'d-none')}">
                                                                            <label>
                                                                                Was any derogatory information developed?</label>
                                                                            <apex:inputField value="{!leadRecord.Derogatory_Info_Developed__c}" html-data-apiname="Derogatory_Info_Developed__c" styleclass="form-control Wasanyderogatoryinformationdeveloped"  onchange="toggleExplanation(); return false"/>
                                                                         </div>
                                                                         <div class="form-group col-4 mt-2 Explanationofsearchresults {!IF(leadRecord.LeadType__c == 'Publicly Available Electronic Information (PAEI)',"",'d-none')}">
                                                                            <label>
                                                                                Explanation of search results</label>
                                                                            <apex:inputField value="{!leadRecord.Explanation_of_search_results__c}" html-data-apiname="Explanation_of_search_results__c" styleclass="form-control Explanationofsearchresultsval" />
                                                                         </div>
                                                                      </div>
                                                      
                                                                    </div>
                                                           </div>
                                                           </apex:outputPanel>
                                                            <apex:outputPanel rendered="{!If(leadRecord.QA_Rejection_Comments__c != Null,true,false)}">
                                                                QA Rejection Comments:
                                                                {!leadRecord.QA_Rejection_Comments__c}
                                                            </apex:outputpanel>
                                                            <apex:outputPanel rendered="{!IF(leadRecord.LeadType__c == 'Subject Recontact (SUBC)',true,false)}">
                                                                <br />
                                                                <div class="row">
                                                                    <div class="form-group mb-2 col-4"
                                                                        required="required">
                                                                        <label>Recontact Date</label>
                                                                        <apex:inputfield styleclass="form-control datepickerInput"
                                                                             value="{!leadRecord.Interview_Date__c}" html-data-apiname="Interview_Date__c"
                                                                            onfocus="return false;" />
                                                                    </div>
                                                                    <div class="form-group mb-2 col-4"
