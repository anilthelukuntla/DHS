                                    <!-- <apex:outputpanel id="documentrequests"><div class="card shadow mb-4"><div
                                                class="card-header py-3 d-flex flex-row align-items-center justify-content-between"><h4 class="m-0 font-weight-bold text-primary">Document Requests </h4></div><div class="card-body"><table class="table table-hover" style="border-collapse:collapse;"><thead><tr><th></th><th scope="col">#</th><th scope="col">To Address</th><th scope="col">Additional Address</th><th scope="col">Investigator Comments</th><th scope="col">Status</th></tr></thead><tbody><apex:repeat value="{!documentrequestids}" var="docId"><tr colspan="6" data-toggle="collapse"
