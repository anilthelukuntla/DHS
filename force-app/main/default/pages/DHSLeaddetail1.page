                                                                                onclick="openMessageModal('edit','{!message.Id}');return false;">
                                                                                <i class="fa fa-edit"></i>
                                                                                </a>

                                                                                <!-- Delete only for CMO / PMO -->
                                                                                <a role="button" class="p-2
                                                                                {!IF(OR(currentuser.User_Type__c = 'CMO', currentuser.User_Type__c = 'PMO'),'','d-none')}"
                                                                                onclick="openMessageModal('delete','{!message.Id}');return false;">
                                                                                <i class="fa fa-trash"></i>
                                                                                </a>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </apex:repeat>
                                                            </tbody>
                                                        </table>
                                                        </apex:outputPanel>
                                                    </apex:outputPanel>
                                                </div>
                                            </div>
                                        </div>
