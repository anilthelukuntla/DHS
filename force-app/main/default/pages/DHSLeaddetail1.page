            $(document).ready(function () {
            $('.recontactmethod.subcontactmethod option[value="Fax"]').remove();
             $('.PhoneNumber input, input.PhoneNumber').on('input', function() {
        // Remove all non-digits
        let phone = $(this).val().replace(/\D/g, '');
        
        // Limit to 10 digits
        if (phone.length > 10) {
            phone = phone.substring(0, 10);
        }
        
        // Format as xxx-xxx-xxxx
        if (phone.length > 6) {
            phone = phone.replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3');
        } else if (phone.length > 3) {
            phone = phone.replace(/(\d{3})(\d{3})/, '$1-$2');
        }
        
        $(this).val(phone);
    });
    
    // Format on blur to ensure proper format
    $('.PhoneNumber input, input.PhoneNumber').on('blur', function() {
        let phone = $(this).val().replace(/\D/g, '');
        if (phone.length === 10) {
            $(this).val(phone.replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3'));
        }
    });
