            }
            span.dateInput.dateOnlyInput:after, .dategroup:after {
    content: "\f133";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    right: 10px;
    position: absolute;
    top: 3px !important;
}

.systemAccessGroupE table ,.systemAccessGroup table{border:none}
input[type="checkbox"] {
    width: auto;
}
.systemAccessGroupE table, .systemAccessGroup table{border:none}
input[type="checkbox"] {
    width: auto;
}
.form-group.mb-2.col-4.systemAccessGroupE td input, .form-group.mb-2.col-4.systemAccessGroup td input {
                margin-right: 5px;
                position: relative;
                top: 1px;
            }
