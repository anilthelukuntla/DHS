<apex:page showHeader="false" sidebar="false" standardStylesheets="false"
    docType="html-5.0">

    <head>

        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />

        <title>CDRL Export Configuration</title>

    </head>

    <body id="page-top">
     <apex:includeLightning />
        <apex:form >
        
            <!-- Page Wrapper -->
            <div id="wrapper">

                <c:DHSHeader ></c:DHSHeader>

                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">
                                <h4 class=" mb-0 text-gray-800"><b>CDRL Export Configuration</b></h4>
                            </div>

                            <!-- Topbar Navbar -->
                            <c:DHSHeaderProfile ></c:DHSHeaderProfile> 

                        </nav>
                        <!-- End of Topbar -->
                        
                       
                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <div id="lwcContainer"></div>


                            <!-- Content Row -->

                        </div>

                        <!-- /.container-fluid -->

                    </div>
                    <!-- End of Main Content -->

                    <!-- Footer -->
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; ISN</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

            </div>
            <!-- End of Page Wrapper -->

            <!-- Scroll to Top Button-->
            <a class="scroll-to-top rounded" href="#page-top">
                <i class="fas fa-angle-up"></i>
            </a>
        </apex:form>
        
        <script>
            $Lightning.use(
            "c:configurationApp",
            function () {
                $Lightning.createComponent(
                    "c:draggableDataTable",
                    {
                    	currentsystem : 'Intel',
                    },
                    "lwcContainer",
                    function (cmp) {
                        console.log("LWC loaded successfully!");
                    }
                );
            }
        );
        </script>

    </body>

</apex:page>