<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSKnowledgeBaseController">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />

        <title>Knowledge Base</title>

    </head>

    <body id="page-top">
        <apex:form >

            <!-- Page Wrapper -->
            <div id="wrapper">

                <c:DHSHeader ></c:DHSHeader>
                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                            <div class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100">

                                <h4 class=" mb-0 text-gray-800">

                                    <b>Knowledge Base</b>
                                </h4>

                            </div>
                            <!-- Sidebar Toggle (Topbar) -->
                            <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                                <i class="fa fa-bars"></i>
                            </button>


                            <c:DHSHeaderProfile ></c:DHSHeaderProfile>

                        </nav>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-12">
                                    <div class="card shadow ">
                                        <div class="card-body">
                                            <div class="d-flex flex-row-reverse bd-highlight">
                                                <a class="btn btn-primary mb-3 {!If(currentuser.user_type__c == 'PMO' ||currentuser.user_type__c == 'CMO','','d-none')}" data-toggle="collapse"
                                                    href="#uploadDocument" role="button" aria-expanded="false"
                                                    aria-controls="uploadDocument">
                                                    Upload Knowledge Articles
                                                </a>
                                            </div>
                                            <div class="collapse mt-2 mb-3" id="uploadDocument">
                                                <div class="card card-body">
                                                    <h4 class="text-primary mb-5">Training Documents</h4>
                                                    <div class="frame">
                                                        <div class="center">
                                                            <c:DHSKnowledgeBaseFileUpload fId="f2" parentId="" >
                                                            </c:DHSKnowledgeBaseFileUpload>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                           <apex:outputpanel id="myarticlespanel">
                                                <!-- Category Accordions -->
                                                <div class="accordion" id="knowledgeBaseAccordion">
                                                    <apex:variable value="{!0}" var="accordionCounter" />
                                                    <apex:repeat value="{!categoryOrder}" var="category">
                                                <apex:variable value="{!0}" var="cnt" />
                                                        <apex:outputPanel rendered="{!categoryCounts[category] > 0}">
                                                            <div class="card mb-3">
                                                                <div class="card-header" id="heading{!accordionCounter}">
                                                                    <h2 class="mb-0">
                                                                        <button class="btn btn-link btn-block text-left" type="button" data-toggle="collapse" 
                                                                                data-target="#collapse{!accordionCounter}" aria-expanded="false" 
                                                                                aria-controls="collapse{!accordionCounter}">
                                                                            <i class="fas fa-folder mr-2"></i>
                                                                            {!category} ({!categoryCounts[category]})
                                                                        </button>
                                                                    </h2>
                                                                </div>
                                                                <div id="collapse{!accordionCounter}" class="collapse" 
                                                                     aria-labelledby="heading{!accordionCounter}" data-parent="#knowledgeBaseAccordion">
                                                                    <div class="card-body">
                                                                        <div class="table-responsive">
                                                                            <table class="table table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">#</th>
                                                            <th scope="col">Name</th>
                                                             <th scope="col">Uploaded Date</th>
                                                            <th scope="col" class="{!If(currentuser.user_type__c == 'PMO','','d-none')}">Sequence</th>
                                                            <th scope="col">Actions</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    <apex:repeat value="{!documentsByCategory[category]}" var="doc">
                                                                                        <tr>
                                                                                            <td>
                                                                                                <apex:variable var="cnt" value="{!cnt+1}" />
                                                                                                {!cnt}
                                                                                            </td>
                                                                                            <td>{!doc.kb.Name__c}</td>
                                                                                            <td>
                                                                                                <apex:outputText value="{0,date,MM/dd/yy}">
                                                                                                    <apex:param value="{!doc.kb.Createddate}" />
                                                                                                </apex:outputText>
                                                                                            </td>
                                                                                            <td class="{!If(currentuser.user_type__c == 'PMO','','d-none')}">
                                                                                                <select class="form-control form-control-sm sequence-select" 
                                                                                                        data-kb-id="{!doc.kb.id}" 
                                                                                                        data-category="{!category}"
                                                                                                        data-current-sequence="{!doc.kb.Sequence__c}">
                                                                                                    <option value="">--Select--</option>
                                                                                                </select>
                                                                                            </td>
                                                                                            <td class="d-flex">
                                                                                                <a class="nav-link px-2" target="_blank"
                                                                                                   href="{!URLFOR($Action.Attachment.Download, doc.attachmentId)}">
                                                                                                    <i class="fa fa-eye"></i>
                                                                                                </a>
                                                                                                <a class="nav-link px-2 edit-category-link" 
                                                                                                   data-kb-id="{!doc.kb.id}" 
                                                                                                   data-current-category="{!doc.kb.Category__c}"
                                                                                                   style="{!If(currentuser.user_type__c == 'PMO','','display:none;')}">
                                                                                                    <i class="fa fa-edit"></i>
                                                                                                </a>
                                                                                                <a class="nav-link px-2 delete-kb-link" 
                                                                                                   data-kb-id="{!doc.kb.id}" 
                                                                                                   style="{!If(currentuser.user_type__c == 'PMO','','display:none;')}">
                                                                                                    <i class="fa fa-trash"></i>
                                                                                                </a>
                                                                                            </td>
                                                                                        </tr>
                                                                                    </apex:repeat>
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <apex:variable var="accordionCounter" value="{!accordionCounter + 1}" />
                                                        </apex:outputPanel>
                                                    </apex:repeat>
                                                    
                                                    <!-- Others Section -->
                                                    <apex:outputPanel rendered="{!categoryCounts['Others'] > 0}">
                                                        <div class="card mb-3">
                                                            <div class="card-header" id="headingOthers">
                                                                <h2 class="mb-0">
                                                                    <button class="btn btn-link btn-block text-left" type="button" data-toggle="collapse" 
                                                                            data-target="#collapseOthers" aria-expanded="false" 
                                                                            aria-controls="collapseOthers">
                                                                        <i class="fas fa-folder mr-2"></i>
                                                                        Others ({!categoryCounts['Others']})
                                                                    </button>
                                                                </h2>
                                                            </div>
                                                            <div id="collapseOthers" class="collapse" 
                                                                 aria-labelledby="headingOthers" data-parent="#knowledgeBaseAccordion">
                                                                <div class="card-body">
                                                                    <div class="table-responsive">
                                                                        <table class="table table-striped">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th scope="col">#</th>
                                                                                    <th scope="col">Name</th>
                                                                                    <th scope="col">Uploaded Date</th>
                                                                                    <th scope="col" class="{!If(currentuser.user_type__c == 'PMO','','d-none')}">Sequence</th>
                                                                                    <th scope="col">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                                                <apex:variable value="{!0}" var="cnt" />
                                                                                <apex:repeat value="{!documentsByCategory['Others']}" var="doc">
                                                            <tr>
                                                                <td>
                                                                    <apex:variable var="cnt" value="{!cnt+1}" />
                                                                    {!cnt}
                                                                </td>
                                                                <td>{!doc.kb.Name__c}</td>
                                                                <td>
                                                                    <apex:outputText value="{0,date,MM/dd/yy}">
                                                                        <apex:param value="{!doc.kb.Createddate}" />
                                                                    </apex:outputText>
                                                                </td>
                                                                <td class="{!If(currentuser.user_type__c == 'PMO','','d-none')}">
                                                                    <select class="form-control form-control-sm sequence-select" 
                                                                            data-kb-id="{!doc.kb.id}" 
                                                                            data-category="Others"
                                                                            data-current-sequence="{!doc.kb.Sequence__c}">
                                                                        <option value="">--Select--</option>
                                                                    </select>
                                                                </td>
                                                                                        <td class="d-flex">
                                                                                            <a class="nav-link px-2" target="_blank"
                                                                                href="{!URLFOR($Action.Attachment.Download, doc.attachmentId)}">
                                                                                                <i class="fa fa-eye"></i>
                                                                                            </a>
                                                                                            <a class="nav-link px-2 edit-category-link" 
                                                                                                   data-kb-id="{!doc.kb.id}" 
                                                                                                   data-current-category="{!doc.kb.Category__c}"
                                                                                                   style="{!If(currentuser.user_type__c == 'PMO','','display:none;')}">
                                                                                                    <i class="fa fa-edit"></i>
                                                                                                </a>
                                                                                                <a class="nav-link px-2 delete-kb-link" 
                                                                                                   data-kb-id="{!doc.kb.id}" 
                                                                                                   style="{!If(currentuser.user_type__c == 'PMO','','display:none;')}">
                                                                                                    <i class="fa fa-trash"></i>
                                                                                                </a>
                                                                                </td>
                                                            </tr>
                                                        </apex:repeat>
                                                    </tbody>
                                                </table>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </apex:outputPanel>
                                                </div>
                                            </apex:outputpanel>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2021</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

            </div>
            <!-- End of Page Wrapper -->

            <!-- Scroll to Top Button-->
            <a class="scroll-to-top rounded" href="#page-top">
                <i class="fas fa-angle-up"></i>
            </a>

             <apex:actionFunction name="deletekbaction" action="{!deleteKBAction}"
                                 rerender="myarticlespanel" status="loader" oncomplete="loadDatatable(); restoreAccordionState();">
                                 <apex:param name="deleteKBID" value="" assignTo="{! deleteKBID}" />
                              </apex:actionfunction>
                              
             <apex:actionFunction name="updatecategoryaction" action="{!updateCategoryAction}"
                                 rerender="myarticlespanel" status="loader" oncomplete="loadDatatable(); restoreAccordionState();">
                                 <apex:param name="editKBID" value="" assignTo="{! editKBID}" />
                                 <apex:param name="newCategory" value="" assignTo="{! newCategory}" />
                              </apex:actionfunction>
                              
             <apex:actionFunction name="updatesequenceaction" action="{!updateSequenceAction}"
                                 rerender="myarticlespanel" status="loader" oncomplete="initializeSequenceDropdowns(); restoreAccordionState();">
                                 <apex:param name="sequenceKBID" value="" assignTo="{! sequenceKBID}" />
                                 <apex:param name="newSequence" value="" assignTo="{! newSequence}" />
                              </apex:actionfunction>

        </apex:form>

        <script nonce="{!$CurrentPage.parameters.nonce}">
            $('.upload-input').change(function () {
                var InputValue = $(this).val().replace(/C:\\fakepath\\/i, '');
                $(".fileUploadValue").text(InputValue);
            });
            function loadDatatable(){
            $('.dataTable').DataTable({
                    "searching": false,
                    "bLengthChange": false,
                    "bFilter": true,
                    "bInfo": true,
                    "bAutoWidth": false
                });
            }
            
            $(document).ready(function () {
                



                $('.dataTable').DataTable({
                    "searching": false,
                    "bLengthChange": false,
                    "bFilter": true,
                    "bInfo": true,
                    "bAutoWidth": false
                });
                
                // Initialize sequence dropdowns
                initializeSequenceDropdowns();
                
                // Track accordion state changes
                $('.collapse').on('shown.bs.collapse', function () {
                    var accordionId = $(this).attr('id');
                    sessionStorage.setItem('openAccordion', accordionId);
                });
                
                $('.collapse').on('hidden.bs.collapse', function () {
                    sessionStorage.removeItem('openAccordion');
                });


            });
            
            // Event delegation for delete links
            $(document).on('click', '.delete-kb-link', function(e) {
                e.preventDefault();
                var kbid = $(this).data('kb-id');
                deletekb(kbid);
            });
            
            // Event delegation for edit category links
            $(document).on('click', '.edit-category-link', function(e) {
                e.preventDefault();
                var kbid = $(this).data('kb-id');
                var currentCategory = $(this).data('current-category') || '';
                editCategory(kbid, currentCategory);
            });
            
            function deletekb(kbid){
                console.log({kbid});
                $.confirm({
                    title: 'Please Confirm!',
                    content: 'On click of confirm, knowledge base record will be submitted.',
                    buttons: {
                        confirm: function () {
                            deletekbaction(kbid);
                        },
                        cancel: function () {}
                    }
                });
            
            }
            
            function editCategory(kbid, currentCategory) {
                console.log('Editing category for KB:', kbid, 'Current category:', currentCategory);
                
                // Create category options
                var categoryOptions = [
                    { value: '', text: '-- Select Category --' },
                    { value: 'Job Aids', text: 'Job Aids' },
                    { value: 'Record templates', text: 'Record templates' },
                    { value: 'Administrative Documents', text: 'Administrative Documents' },
                    { value: 'IT', text: 'IT' },
                    { value: 'Trainings', text: 'Trainings' }
                ];
                
                // Create select dropdown HTML
                var selectHtml = '<select id="categorySelect" class="form-control">';
                categoryOptions.forEach(function(option) {
                    var selected = (option.value === currentCategory) ? ' selected' : '';
                    selectHtml += '<option value="' + option.value + '"' + selected + '>' + option.text + '</option>';
                });
                selectHtml += '</select>';
                
                $.confirm({
                    title: 'Edit Category',
                    content: '<div class="form-group"><label for="categorySelect">Select New Category:</label>' + selectHtml + '</div>',
                    buttons: {
                        confirm: {
                            text: 'Update',
                            btnClass: 'btn-primary',
                            action: function () {
                                var newCategory = $('#categorySelect').val();
                                if (newCategory !== currentCategory) {
                                    updatecategoryaction(kbid, newCategory);
                                } else {
                                    $.alert('No changes made to category.');
                                }
                            }
                        },
                        cancel: {
                            text: 'Cancel',
                            btnClass: 'btn-secondary'
                        }
                    }
                });
            }
            
            // Initialize sequence dropdowns with available numbers
            function initializeSequenceDropdowns() {
                // Group selects by category
                var categoriesData = {};
                
                $('.sequence-select').each(function() {
                    var category = $(this).data('category');
                    if (!categoriesData[category]) {
                        categoriesData[category] = {
                            count: 0,
                            usedSequences: []
                        };
                    }
                    categoriesData[category].count++;
                    
                    var currentSeq = $(this).data('current-sequence');
                    if (currentSeq && currentSeq !== '' && currentSeq !== 'null') {
                        categoriesData[category].usedSequences.push(parseInt(currentSeq));
                    }
                });
                
                // Populate each dropdown
                $('.sequence-select').each(function() {
                    var $select = $(this);
                    var category = $select.data('category');
                    var currentSeq = $select.data('current-sequence');
                    var categoryData = categoriesData[category];
                    
                    // Clear existing options except the first one
                    $select.find('option:not(:first)').remove();
                    
                    // Add sequence options based on total count
                    for (var i = 1; i <= categoryData.count; i++) {
                        // Show all numbers from 1 to count, allowing sequence swapping
                        var selected = (parseInt(currentSeq) === i) ? ' selected' : '';
                        $select.append('<option value="' + i + '"' + selected + '>' + i + '</option>');
                    }
                });
            }
            
            // Function to restore accordion state after rerender
            function restoreAccordionState() {
                var openAccordionId = sessionStorage.getItem('openAccordion');
                if (openAccordionId) {
                    // Find the accordion and open it
                    var $accordion = $('#' + openAccordionId);
                    if ($accordion.length > 0) {
                        $accordion.addClass('show');
                        // Also update the button's aria-expanded attribute
                        var $button = $('[data-target="#' + openAccordionId + '"]');
                        if ($button.length > 0) {
                            $button.attr('aria-expanded', 'true');
                        }
                    }
                    // Clear the stored state
                    sessionStorage.removeItem('openAccordion');
                }
            }
            
            // Event delegation for sequence change
            $(document).on('change', '.sequence-select', function() {
                var kbid = $(this).data('kb-id');
                var newSeq = $(this).val();
                
                if (newSeq !== '') {
                    // Store which accordion is currently open before rerender
                    var openAccordion = $('.collapse.show').attr('id');
                    sessionStorage.setItem('openAccordion', openAccordion);
                    
                    updatesequenceaction(kbid, newSeq);
                }
            });
           
        </script>
        <style>
            .highlightrequiredfield {
                border: 1px solid red !important;
            }

            .vertical-timeline-element-content {
                margin-left: 100px;
            }

            .vertical-timeline-element-content .vertical-timeline-element-date {
                left: -120px;
            }

            .badge:empty {
                display: block
            }

            .badge-success {
                background-color: #00799B
            }

            .dataTables_info {
                padding: 0 15px
            }

            .vertical-timeline-element-content .vertical-timeline-element-date {
                color: #000
            }

            .frame {


                width: 100%;
                height: 400px;

                border-radius: 2px;
                box-shadow: 4px 8px 16px 0 rgba(0, 0, 0, 0.1);
                overflow: hidden;
                color: #000;

            }

            .frame .center {
                width: 100%;
                height: 100%;
                border-radius: 3px;
                box-shadow: 8px 10px 15px 0 rgba(0, 0, 0, 0.2);
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: space-evenly;
                flex-direction: column;
            }

            .frame .title {
                width: 100%;
                height: 50px;
                border-bottom: 1px solid #000;
                text-align: center;
            }

            ..frame h1 {
                font-size: 16px;
                font-weight: 300;
                color: #000;
            }

            .frame .dropzone {
                position: relative;
                border: 1px dashed #000;
                border-radius: 3px;
                text-align: center;
                padding: 50px;


            }

            .frame .upload-icon {
                margin: 25px 2px 2px 2px;
            }

            .frame .upload-input {
                position: absolute;
                top: 0px;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
            }

            .dateFormat {
                display: none
            }

            .form-group span {
                font-weight: bold
            }

            .input-group-append {
                position: absolute;
                top: 5px;
                right: 22px;
            }

            .datepicker.dropdown-menu {
                padding: 10px;
            }

            .taskEvent li {
                display: flex;
                color: #000;
            }

            .taskEvent span {
                position: relative;
                padding: 0 1.5em;
            }

            .sidebar #sidebarToggle::after {
                font-weight: 900;
                content: '\f104';
                font-family: 'Font Awesome 6 Free';
                margin-right: 0.1rem;
            }


            .taskEvent span::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 4px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #fff;
                border: 1px #ccc solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed::after {
                content: "";
                position: absolute;
                z-index: 2;
                left: -18px;
                top: 2px;
                transform: translateX(50%);
                border-radius: 50%;
                background: #00799B;
                border: 1px #00799B solid;
                width: 1.2rem;
                height: 1.2rem;
            }

            .taskEvent span.completed {
                color: #00799B;
            }

            .taskEvent span {
                padding: 0 1.5em 1.5em 1.5em;
                position: relative;
                font-size: 14px;
                font-weight: bold
            }

            .taskEvent span.completed::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #00799B solid;
            }

            .taskEvent span::before {
                content: "";
                position: absolute;
                z-index: 1;
                left: 0;
                height: 100%;
                border-left: 2px #ccc solid;
            }

            .taskEvent strong {
                display: block;
                font-weight: bolder;
            }

            .taskEvent,
            .taskEvent *::before,
            .taskEvent *::after {
                box-sizing: border-box;
                font-family: arial;
            }
        </style>
    </body>
</apex:page>
