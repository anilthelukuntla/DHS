            function assigncases() {
            debugger;
                var numberofcases = $('.caseselectcheckbox:checkbox:checked').length;
                var rowsvalidated = true;
                
                $('.caseselectcheckbox:checkbox:checked').each(function () {
                       var parentRow = $(this).closest('tr');
                        $(parentRow).each(function(){
                          var validaterows = true;
                            $(this).find('td').each(function(){
                               if($(this).hasClass('mandatory')){
                                    if($(this).text().trim() == ''){
                                        validaterows = false;
                                        rowsvalidated = false;
                                    } 
                                }
                            });
                            
                            if(!validaterows){
                                $(this).addClass('bg-secondary text-white');
                                 $('.toast strong').text('Selected Case do not have complete details')
                                 $('.toast').toast('show');
                            }
                        });
                    });
                var assignto = $('.selectedUserIdForAssignment').val();
                var assigntoname = $( ".selectedUserIdForAssignment option:selected" ).text();
                if(numberofcases > 0 && assignto != '' && rowsvalidated){
                    $.confirm({
                    title: 'Please Confirm!',
                    content: 'Would you like to proceed with this case assignment to '+assigntoname+'?',
                    buttons: {
                        confirm: function () {
                            assigncasesaction();
                        },
                        cancel: function () {}
                    }
                    });
                }
                else if(numberofcases == 0){
                                 $('.toast strong').text('Please select a case to assign.')
                                 $('.toast').toast('show');
                   
                }else if(assignto == ''){
                  $('.toast strong').text('Please select a user to assign cases.')
                                 $('.toast').toast('show');
                   
                }
                
               
                
            }
            
