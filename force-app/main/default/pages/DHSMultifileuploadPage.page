<apex:page showHeader="false" sidebar="false" standardStylesheets="false" controller="DHSMultifileuploadPageController"
    docType="html-5.0">


    <head>
    
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />
        <apex:slds />  
        <apex:includeScript value="https://code.jquery.com/jquery-2.2.4.js"></apex:includeScript> 
        <title>Document Upload</title>

      
        <script>
    $(function () {
      var fileQueue = [];
      var currentIndex = 0;
      var ids = [];
      var caseId = '{!caseId}';

      $('#addr').change(function () {
        var fileInput = document.getElementById('addr');
        fileQueue = Array.from(fileInput.files);
        var $tbody = $('#fileListBody');
        $tbody.empty();

        if (fileQueue.length === 0) {
          $('#fileListContainer').hide();
          return;
        }
        $('#fileListContainer').show();

        fileQueue.forEach(function (file, index) {
          var sizeKB = (file.size / 1024).toFixed(2);
          var sizeDisplay = sizeKB > 1024 ? (sizeKB / 1024).toFixed(2) + ' MB' : sizeKB + ' KB';
          var row = `
            <tr id="fileRow_${index}">
              <td><i class="slds-icon slds-icon-text-default slds-icon_x-small slds-m-right_x-small"></i>${file.name}</td>
              <td>${sizeDisplay}</td>
              <td id="fileStatus_${index}" class="slds-text-color_weak">Pending</td>
            </tr>`;
          $tbody.append(row);
        });
      });

      $('#uploadBtn').click(function () {
        if (fileQueue.length === 0) {
          alert('Please select at least one file.');
          return;
        }

        currentIndex = 0;
        ids = [];
        $('#records').html('');
        uploadNextFile();
      });

      function uploadNextFile() {
        if (currentIndex >= fileQueue.length) {
          $('#records').append('<br/><b>All files uploaded successfully</b>');
          document.getElementById("addr").value = "";
            doUploadRedirect();
          return;
        }

        var file = fileQueue[currentIndex];
        $('#fileStatus_' + currentIndex).text('Uploading...').css('color', '#0176d3');

        fileToBase64(file, function (err, content) {
          if (err) {
            $('#fileStatus_' + currentIndex).text('Error âŒ').css('color', 'red');
            currentIndex++;
            uploadNextFile();
            return;
          }

          var attachObject = {
            ParentId: '{!recordId}',
            Name: file.name,
            Body: content
          };

          Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.DHSMultifileuploadPageController.processUploadedFiles}',
            caseId, attachObject.Name,
            function (result, event) {
              if (event.status) {
                attachObject.ParentId = result;
                uploadAttachmentToSalesforce(attachObject, function (success, responseId) {
                  if (success) {
                    ids.push(responseId);
                    $('#records').append('<br/>' + attachObject.Name + ' uploaded (Id: ' + responseId + ')');
                    $('#fileStatus_' + currentIndex).text('Uploaded').css('color', 'green');
                  } else {
                    $('#fileStatus_' + currentIndex).text('Failed âŒ').css('color', 'red');
                  }
                  currentIndex++;
                  uploadNextFile();
                });
              } else {
                $('#fileStatus_' + currentIndex).text('Apex Error âŒ').css('color', 'red');
                currentIndex++;
                uploadNextFile();
              }
            },
            { escape: true }
          );
        });
      }

      function uploadAttachmentToSalesforce(attachObject, callback) {
        $('#progress_bar_container').show();
        $('.progress').css('width', '0%');
        $('#percentText').html('Uploading ' + attachObject.Name + '... 0%');

        $.ajax({
          url: '/services/data/v39.0/sobjects/Attachment',
          data: JSON.stringify(attachObject),
          type: 'POST',
          processData: false,
          contentType: false,
          headers: {
            'Authorization': 'Bearer {!sessionId}',
            'Content-Type': 'application/json'
          },
          xhr: function () {
            var xhr = new window.XMLHttpRequest();
            xhr.upload.addEventListener("progress", function (evt) {
              if (evt.lengthComputable) {
                var percent = (evt.loaded / evt.total) * 100;
                $('#percentText').html("Uploading " + attachObject.Name + "... " + Math.round(percent) + "%");
                $('.progress').css('width', percent + "%");
              }
            }, false);
            return xhr;
          },
          success: function (response) {
              
            $('#progress_bar_container').hide();
            callback(true, response.id);
          },
          error: function (xhr, status, error) {
                console.error('Attachment upload failed');
                console.error('HTTP Status:', xhr.status);
                console.error('Response:', xhr.responseText);
                console.error('Error:', error);
            
                $('#records').append(
                    '<br/><span style="color:red;">Attachment failed: ' +
                    (xhr.responseText || error) +
                    '</span>'
                );
            
                $('#progress_bar_container').hide();
                callback(false, null);
            }
        });
      }

      function fileToBase64(file, callback) {
        var reader = new FileReader();
        reader.onload = function () {
          var result = reader.result;
          var base64Mark = 'base64,';
          var dataStart = result.indexOf(base64Mark) + base64Mark.length;
          var base64Content = result.substring(dataStart);
          callback(null, base64Content);
        };
        reader.onerror = function (e) { callback(e, null); };
        reader.readAsDataURL(file);
      }
    });
  </script>

  <script>
    $(document).ready(function() {
      var uploadArea = $('.upload-area');
      
      // Prevent default drag behaviors on the entire document
      $(document).on('drag dragstart dragend dragover dragenter dragleave drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
      });
      
      // Handle drag over event
      uploadArea.on('dragover dragenter', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).addClass('drag-over');
        $(this).css({
          'background-color': '#e3f2fd',
          'border-color': '#00799B',
          'transform': 'scale(1.02)'
        });
      });
      
      // Handle drag leave event
      uploadArea.on('dragleave dragend', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).removeClass('drag-over');
        $(this).css({
          'background-color': '#f8f9fc',
          'border-color': '#d9d9d9',
          'transform': 'scale(1)'
        });
      });
      
      // Handle drop event
      uploadArea.on('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        $(this).removeClass('drag-over');
        $(this).css({
          'background-color': '#f8f9fc',
          'border-color': '#d9d9d9',
          'transform': 'scale(1)'
        });
        
        var files = e.originalEvent.dataTransfer.files;
        
        if (files.length > 0) {
          // Set the files to the file input
          var fileInput = document.getElementById('addr');
          fileInput.files = files;
          
          // Trigger the change event to populate the file list
          $(fileInput).trigger('change');
        }
      });
    });
  </script>
 
        
        
