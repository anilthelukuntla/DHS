         height: 50px;
         border-bottom: 1px solid #000;
         text-align: center;
         }
         .frame h1 {
         font-size: 16px;
         font-weight: 300;
         color: #000;
         }
         .frame .dropzone {
         border: 1px dashed #000;
         border-radius: 3px;
         text-align: center;
         padding: 50px;
         }
         .frame .upload-icon {
         margin: 25px 2px 2px 2px;
         }
         .frame .upload-input {
         position: relative;
         top: -62px;
         left: 0;
         width: 100%;
         height: 100%;
         opacity: 0;
         }
         .dateFormat {
         display: none
         }
         .form-group span {
         font-weight: bold
         }
         .input-group-append {
         position: relative;
         top: 5px;
         left: 10px;
         }
         .datepicker.dropdown-menu {
         padding: 10px;
         }
         .taskEvent li {
         display: flex;
         color: #000;
         }
         .taskEvent span {
         position: relative;
         padding: 0 1.5em;
         }
         .sidebar #sidebarToggle::after {
         font-weight: 900;
         content: '\f104';
         font-family: 'Font Awesome 6 Free';
         margin-right: 0.1rem;
         }
         .taskEvent span::after {
         content: "";
         position: absolute;
         z-index: 2;
         left: -18px;
         top: 4px;
         transform: translateX(50%);
         border-radius: 50%;
         background: #fff;
         border: 1px #ccc solid;
         width: 1.2rem;
         height: 1.2rem;
         }
         .taskEvent span.completed::after {
         content: "";
         position: absolute;
         z-index: 2;
         left: -18px;
         top: 2px;
         transform: translateX(50%);
         border-radius: 50%;
         background: #00799B;
         border: 1px #00799B solid;
         width: 1.2rem;
         height: 1.2rem;
         }
         .taskEvent span.completed {
         color: #00799B;
         }
         .taskEvent span {
         padding: 0 1.5em 1.5em 1.5em;
         position: relative;
         font-size: 14px;
         font-weight: bold
         }
         .taskEvent span.completed::before {
         content: "";
         position: absolute;
         z-index: 1;
         left: 0;
         height: 100%;
         border-left: 2px #00799B solid;
         }
         .taskEvent span::before {
         content: "";
         position: absolute;
         z-index: 1;
         left: 0;
         height: 100%;
         border-left: 2px #ccc solid;
         }
         .taskEvent strong {
         display: block;
         font-weight: bolder;
         }
         .taskEvent,
         .taskEvent *::before,
         .taskEvent *::after {
         box-sizing: border-box;
         font-family: arial;
         }
         .overlay{position:absolute; z-index:99999;top:0;right:0;left:0;right:0;width:100%;height:100%;background:#fff; opacity:0.6 }
         .overlay .btn{position: absolute;
         top: 390px;
         left: 0;
         right: 0;
         width: 160px;
