      <style>
      .mic-icon{
      position: absolute;
    top: 5px;
    right: 10px;
      }
      .input-container{position:relative;}
      .form-group{position:relative}
          .tooltip-icon {
            display: inline-block;
            padding: 0;
            cursor: pointer;
        }

        /* Tooltip text */
        .tooltiptext {
        max-height: 500px;
    overflow-y: scroll;
    height:auto;
            visibility: hidden;
            width: 1000px;
            background-color: #f9f9f9;
            color: #174da6;
            text-align: left;
            padding: 10px;
            border-radius: 4px;
            border: 1px solid #ccc;
            position: absolute;
            z-index: 1;
            bottom: calc(100%); /* Position above the icon */
            left: 0;
            opacity: 0;
            transition: opacity 0.3s;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            text-align: justify;
    font-size: 16px;
    font-weight: 400;
    font-family: monospace, monospace;
        }

        /* Arrow below the tooltip */
        .tooltiptext::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #ccc transparent transparent transparent;
        }

        /* Show the tooltip on hover */
        .tooltip-icon.visible .tooltiptext {
            visibility: visible;
            opacity: 1;
        }
        label{ pointer-events:none;}
          label span,label input{pointer-events: all;}

        /* Style the "i" icon */
        .tooltip-icon .icon {
            display: inline-block;
            
            padding:0 15px;
            color: #000;
            border-radius: 50%;
            text-align: center;
            line-height: 20px;
            font-size: 12px;
            font-style: italic;
        }
        
        .tooltip-icon .icon:hover {
            
            
            
            color: #000;
           
        }
        /* Button inside tooltip */
        .tooltiptext button {
            margin-top: 10px;
            padding: 5px 10px;
            background-color: #00799B;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .tooltiptext button:hover {
            background-color: #0056b3;
        }
        
        .tooltiptext.tooltip-left {
    left: 0;
}

.tooltiptext.tooltip-center {
    left: 50%;
    transform: translateX(-50%);
}

.tooltiptext.tooltip-right {
    right: 0;
    left:auto;
}
          
      .jconfirm-buttons {
    float: none !important;
    text-align: center;
}
         .standardisedissues tbody td label{margin-left:5px}
         .standardisedissues tbody{
