       <script>
     $(document).ready(function () {
    $("input[type='text'], textarea").each(function () {
        $(this).wrap("<div class='input-container'></div>");
        $(this).after("<span class='mic-icon'><i class='fa-solid fa-microphone'></i></span>");
    });

    let recognition;
    if (window.SpeechRecognition || window.webkitSpeechRecognition) {
        recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.continuous = true;
        recognition.interimResults = false;
        recognition.lang = 'en-US';
    } else {
        alert("Your browser does not support Speech Recognition.");
        return;
    }

    let activeField = null;
    let isRecognitionActive = false;
    let switchingFields = false;

    $(document).on("click", ".mic-icon", function () {
        activeField = $(this).siblings("input, textarea");
        startListening();
    });

    $("input.datepickerInput, select").focus(function () {
        activeField = $(this);
        //startListening();
    });

    function startListening() {
        if (isRecognitionActive) return;
        navigator.mediaDevices.getUserMedia({ audio: true })
            .then(() => {
                recognition.start();
                isRecognitionActive = true;
            })
            .catch(error => {
                console.error("Microphone access denied:", error);
                alert("Please allow microphone access in your browser settings.");
            });
    }

    recognition.onresult = function (event) {
        let transcript = event.results[event.results.length - 1][0].transcript.trim();
        if (!activeField) return;

        console.log("Recognized:", transcript);

        if (executeCommand(transcript.toLowerCase())) return;

        if (!switchingFields) {
            let currentText = activeField.val().trim();

          if (activeField.is("input.datepickerInput")) { 
                let formattedDate = formatDateFromSpeech(transcript);
                if (formattedDate) activeField.val(formattedDate);
            } else if (activeField.is("select")) {
                selectDropdownOption(transcript);
            } else {
                activeField.val((currentText + " " + transcript).trim());
            }
        }
    };

   function formatDateFromSpeech(input) {
    // Remove unwanted characters (-, /, spaces, etc.)
    let cleanedInput = input.replace(/[^0-9]/g, ""); 

    // Check if it matches DDMMYYYY format (strictly 8 digits)
    if (cleanedInput.length === 8) {
        let day = cleanedInput.substring(0, 2);
        let month = cleanedInput.substring(2, 4);
        let year = cleanedInput.substring(4, 8);
        return `${day}/${month}/${year}`;
    }

    return null; // Return null if the format is unrecognized
}
    function selectDropdownOption(optionText) {
    activeField.trigger("click");
        activeField.find("option").each(function () {
            if ($(this).text().toLowerCase() === optionText.toLowerCase()) {
                activeField.val($(this).val()).trigger("change");
                return false;
            }
        });
    }

    recognition.onerror = function (event) {
        console.error("Speech recognition error:", event.error);
        if (event.error === "not-allowed") {
            alert("Microphone access denied. Please allow it in browser settings.");
        }
    };

    recognition.onend = function () {
        isRecognitionActive = false;
        if (!switchingFields) {
            startListening();
        }
    };

    function executeCommand(command) {
        const specialChars = {
            "dot": ".",
            "period": ".",
            "comma": ",",
            "colon": ":",
            "semicolon": ";",
            "exclamation": "!",
            "question mark": "?",
            "percent": "%",
            "dollar": "$",
            "hashtag": "#",
            "at the rate": "@",
            "ampersand": "&",
            "open parenthesis": "(",
            "close parenthesis": ")"
        };

        if (specialChars.hasOwnProperty(command)) {
            activeField.val(activeField.val() + specialChars[command]);
            return true;
        }

        switch (command) {
            case "next field":
            $('#ui-datepicker-div').hide();
            closeDropdown();
                moveToNextFieldOrAccordion();
                return true;
            case "previous field":
            $('#ui-datepicker-div').hide();
            closeDropdown();
                moveToPreviousField();
                return true;
            case "clear the field":
                activeField.val("");
                return true;
            case "clear word":
                let words = activeField.val().trim().split(" ");
                words.pop();
                activeField.val(words.join(" "));
                return true;
            case "add paragraph":
                if (activeField.is("textarea")) {
                    activeField.val(activeField.val() + "\n\n");
                }
                return true;
            case "add linebreak":
                if (activeField.is("textarea")) {
                    activeField.val(activeField.val() + "\n");
                }
                return true;
            default:
                return false;
        }
    }

  function moveToNextFieldOrAccordion() {
    if (!activeField) return;

    console.log(3); // Debug log to confirm function execution

    let fields = $("input[type='text']:visible, textarea:visible, input.datepickerInput:visible, select:visible")
        .not("[disabled]"); // Only get visible and enabled fields

    let currentIndex = fields.index(activeField);

    console.log("Current Index:", currentIndex, "Total Visible Fields:", fields.length);

    if (currentIndex !== -1 && currentIndex < fields.length - 1) {
        console.log(2); // Debug log to confirm movement to next field
        activeField = fields.eq(currentIndex + 1);
        activeField.focus();
          // Ensure select dropdown opens when focused
          if (activeField.is("textarea")) {
    activeField.css("height", "200px");
}
        if (activeField.is("select")) {
            openDropdown();
        }
        if (activeField.is(".datepickerInput")) {
            $('#ui-datepicker-div').show();
        }
    } else {
        console.log(1); // Debug log when moving to next accordion
        openNextAccordion();
    }
}


   function moveToPreviousField() {
    if (!activeField) return;

    let fields = $("input[type='text']:visible, textarea:visible, input.datepickerInput:visible, select:visible")
        .not("[disabled]"); // Only get visible and enabled fields

    let currentIndex = fields.index(activeField);

    if (currentIndex > 0) {
        activeField = fields.eq(currentIndex - 1);
        activeField.focus();

        // Ensure select dropdown opens when focused
        if (activeField.is("select")) {
            openDropdown();
        }
         if (activeField.is("textarea")) {
    activeField.css("height", "200px");
}
         if (activeField.is(".datepickerInput")) {
            $('#ui-datepicker-div').show();
        }

    } else {
        openPreviousAccordion();
    }
}
function closeDropdown() {
    if (!activeField || !activeField.is("select")) return; // Ensure activeField is a select element

    activeField.attr("size", 1); // Collapse dropdown
}

function openDropdown() {
    if (!activeField || !activeField.is("select")) return; // Ensure activeField is a select element

    var length = activeField.find("option").length;
    activeField.attr("size", length); // Expand dropdown
    activeField.focus();
}
    function openNextAccordion() {
        let currentAccordion = activeField.closest(".collapse");
        let nextAccordionHeader = currentAccordion.parent().next(".card").find("a");

        if (nextAccordionHeader.length) {
            switchingFields = true;
            recognition.stop();

           // nextAccordionHeader.removeClass("collapsed").attr("aria-expanded", "true");
            nextAccordionHeader.trigger("click"); // Bootstrap handles the collapse animation

            setTimeout(() => {
                let nextAccordion = currentAccordion.parent().next(".card")
                let nextAccordionBody = $(nextAccordion);

                setTimeout(() => {
                    let firstField = nextAccordionBody.find("input[type='text'], textarea, select, input.datepickerInput").first();
                    if (firstField.length) {
                        activeField = firstField;
                        activeField.focus();

                        if (firstField.is("select")) {
                            firstField.trigger("click").trigger("focus");
                        }

                        switchingFields = false;
                        startListening();
                    }
                }, 500);
            }, 500);
        }
    }

    function openPreviousAccordion() {
        let currentAccordion = activeField.closest(".collapse");
        let previousAccordionHeader = currentAccordion.parent().prev(".card").find("a");

        if (previousAccordionHeader.length) {
            switchingFields = true;
            recognition.stop();

            //previousAccordionHeader.removeClass("collapsed").attr("aria-expanded", "true");
            previousAccordionHeader.trigger("click"); 

            setTimeout(() => {
                let previousAccordion =currentAccordion.parent().prev(".card")
                let previousAccordionBody = $(previousAccordion);

             
                setTimeout(() => {
                    let lastField = previousAccordionBody.find("input[type='text'], textarea, select, input.datepickerInput").last();
                    if (lastField.length) {
                        activeField = lastField;
                        activeField.focus();

                        if (lastField.is("select")) {
                            lastField.trigger("click").trigger("focus");
                        }

                        switchingFields = false;
                        startListening();
                    }
                }, 500);
            }, 500);
        }
    }
});



       </script>
