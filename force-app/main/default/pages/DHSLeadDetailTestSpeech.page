      <script>
         //$("input,textarea,select").not(".dontsave").change(function() {
         //  console.log('Auto Save Executed 2');
         //  ApexAutoSaveAction();
         //});
         
         $('.waiverreason').change(function(){
         var selectedType = $('.waiverreason').val();
         if(selectedType == 'Other'){
             $('#servicedayspanel1').show();
         }else{
             $('#servicedayspanel1').hide();
         }
         });
         
         function standardisedissues()  {
         const checkboxes = document.querySelectorAll(".standardisedissues input[value='Other']");
         const issuesDiv = document.querySelector('.standardisedissuesotherexplanation');
         
         checkboxes.forEach((checkbox) => {
         checkbox.addEventListener('change', () => {
         if (checkbox.checked) {
         issuesDiv.classList.remove('d-none');
         } else {
         issuesDiv.classList.add('d-none');
         }
         });
         });
         
         // Execute the same behavior on load
         if (checkboxes.length > 0 && checkboxes[0].checked) {
         issuesDiv.classList.remove('d-none');
         } else {
         issuesDiv.classList.add('d-none');
         }
         };
         var leadStatus = '{!leadRecord.Status__c}';
         var currentUserType = '{!currentuser.User_Type__c}';
         $(document).ready(function () {
         
         
             $('.headertext1').keyup(function(){
                 $(this).val($(this).val().toUpperCase());
                 $(this).css('text-decoration', 'underline');
                 $(this).css('font-weight', 'bold');
             });
         
              
              
              $("body").on("change blur","input, textarea, select", function() {
                ApexAutoSaveAction();
            });
         
             
         
             if(currentUserType == 'INV'){
                 $('.leadcontactinformationinput').prop("disabled", true);
             }
             
             if((leadStatus == "Completed" || leadStatus == "QA Review Completed") && currentUserType == 'INV'){
